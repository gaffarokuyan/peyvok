<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="110"/>
<wp id="1" ap="7" ah="50" av="92"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="2500" d="4640" wp="1" ws="1"><s p="1">هەزار ساڵ لەمەوبەر، لە دەروازەی ڕۆژهەڵاتی
میزۆپۆتامیادا، بنەماڵەیەکی کوردی سەری هەڵدا.</s></p>
<p t="7180" d="4200" wp="1" ws="1"><s p="1">ئەو ڕێگە گەورەیەی لە بەغداوە بۆ خۆراسان
درێژ دەبووەوە، بەناو خاکی ئەواندا تێدەپەڕی.</s></p>
<p t="11420" d="2360" wp="1" ws="1"><s p="1">نزیکەی سەد و سی ساڵ ئەم
دەروازەیەیان بەدەستەوە بوو.</s></p>
<p t="13820" d="2920" wp="1" ws="1"><s p="1">کۆشکیان بنیاد نا، سوپای سوارچاکییان بەڕێوە برد،</s></p>
<p t="16780" d="3280" wp="1" ws="1"><s p="1">لەگەڵ بنەماڵە دراوسێکاندا
هاوپەیمانی و جەنگیان تاقی کردەوە.</s></p>
<p t="20100" d="1960" wp="1" ws="1"><s p="1">ناوی ئەوان عەننازییەکان بوو.</s></p>
<p t="22100" d="1692" wp="1" ws="1"><s p="1">بەخێر بێن بۆ کەناڵی دیرۆک.</s></p>
<p t="23833" d="3987" wp="1" ws="1"><s p="1">بۆ ئەوەی ئەو لاپەڕانەی مێژووی کورد کە
هەوڵدرا لەبیر بکرێن لەدەستتان نەچن،</s></p>
<p t="27860" d="1339" wp="1" ws="1"><s p="1">سەبسکرایب کردنتان لەبیر نەچێت.</s></p>
<p t="40620" d="4040" wp="1" ws="1"><s p="1">لە ڕۆژهەڵاتی ڕووباری دیجلە،
دەشتی میزۆپۆتامیا دەگاتە شاخەکان.</s></p>
<p t="44700" d="3000" wp="1" ws="1"><s p="1">ڕێک لەسەر ئەم سنوورەدا،
شاری حەلوان بەرز دەبێتەوە.</s></p>
<p t="47740" d="2759" wp="1" ws="1"><s p="1">ئەم شارەی ئەمڕۆ بە ناوی سەرپێڵی زەهاو دەناسرێت،</s></p>
<p t="50540" d="2867" wp="1" ws="1"><s p="1">بەپێی جوگرافیاناسانی سەدەکانی ناوەڕاست،</s></p>
<p t="53447" d="2385" wp="1" ws="1"><s p="1">دوا شاری دەشتی عێراق، واتە میزۆپۆتامیا بووە.</s></p>
<p t="55873" d="2787" wp="1" ws="1"><s p="1">ئاوی ئەڵوەن کە لە حەلوانەوە هەڵدەقوڵێت،</s></p>
<p t="58700" d="1759" wp="1" ws="1"><s p="1">تێکەڵ بە ڕووباری دیالە و
لەوێشەوە تێکەڵ بە دیجلە دەبێت.</s></p>
<p t="60500" d="3000" wp="1" ws="1"><s p="1">ئەم خاکە خاوەنی یادەوەرییەکی زۆر دێرینە.</s></p>
<p t="63540" d="2879" wp="1" ws="1"><s p="1">چوار هەزار ساڵ لەمەوبەر،
ئەنوبانینی پاشای لۆلۆبییەکان،</s></p>
<p t="66460" d="2412" wp="1" ws="1"><s p="1">سەرکەوتنی خۆی لەسەر بەردەکانی حەلوان هەڵکۆڵی.</s></p>
<p t="68913" d="3774" wp="1" ws="1"><s p="1">دواتر کاسییەکان لەم ناوچەیەوە سەریان
هەڵدا و لەسەر تەختی بابل دانیشتن.</s></p>
<p t="72727" d="5872" wp="1" ws="1"><s p="1">باوباپیرانی کورد بۆ هەزاران ساڵ لەم
دەروازەیەی نێوان میزۆپۆتامیا و چیاکاندا ژیاون.</s></p>
<p t="83320" d="3920" wp="1" ws="1"><s p="1">چیرۆکی عەننازییەکان لە دەوروبەری
ساڵی ٩٩٠دا دەست پێدەکات.</s></p>
<p t="87280" d="3719" wp="1" ws="1"><s p="1">ئەبولفەتح محەممەد کوڕی عەنناز
لە هۆزی کوردیی شازەنجان،</s></p>
<p t="91040" d="2026" wp="1" ws="1"><s p="1">لە شاری حەلوان دەسەڵاتی گرتە دەست.</s></p>
<p t="93107" d="3012" wp="1" ws="1"><s p="1">بنەماڵەکە ناوی خۆی لە باوکی
ئەو، واتە عەننازەوە وەرگرتووە.</s></p>
<p t="96160" d="4879" wp="1" ws="1"><s p="1">عەشیرەتی شازەنجان، کۆمەڵگەیەکی بەهێزی
کوردی بوون کە لە نێوان دەشتی میزۆپۆتامیا و</s></p>
<p t="101080" d="879" wp="1" ws="1"><s p="1">شاخەکاندا دەژیان.</s></p>
<p t="102000" d="4719" wp="1" ws="1"><s p="1">ئەبولفەتح، بە سوارچاکانی عەشیرەتەکەی
هاوسەنگییەکانی ناوچەکەی بە قازانجی خۆی گۆڕی و بۆ</s></p>
<p t="106760" d="2386" wp="1" ws="1"><s p="1">ماوەی بیست ساڵ حوکمی حەلوانی کرد.</s></p>
<p t="109187" d="4513" wp="1" ws="1"><s p="1">بەم شێوەیە دەروازەی ڕۆژهەڵاتی
میزۆپۆتامیا کەوتە دەست میرنشینێکی کوردی.</s></p>
<p t="118420" d="2199" wp="1" ws="1"><s p="1">حەلوان شارێکی ئاسایی نەبوو.</s></p>
<p t="120660" d="3319" wp="1" ws="1"><s p="1">ئەو ڕێگا گەورەیەی بەغدای بە
هەمەدان و خۆراسانەوە دەبەستەوە،</s></p>
<p t="124020" d="2079" wp="1" ws="1"><s p="1">بەمێدا تێدەپەڕی و بەرەو شاخەکان هەڵدەکشا.</s></p>
<p t="126140" d="3200" wp="1" ws="1"><s p="1">کاروانەکانی بارکراو بە
ئاوریشم، بەهارات، ئەسپ و قوماش،</s></p>
<p t="129380" d="2040" wp="1" ws="1"><s p="1">کاروانی حاجیانی هاتوو لە خۆراسانەوە،</s></p>
<p t="131460" d="3080" wp="1" ws="1"><s p="1">باڵیۆزان و سوپاکان ناچار
بوون بەم دەروازەیەدا تێپەڕن.</s></p>
<p t="134580" d="3667" wp="1" ws="1"><s p="1">عەننازییەکان ڕێگاکەیان دەپاراست و لە
بەرامبەردا باجی تێپەڕبوونیان وەردەگرت.</s></p>
<p t="138287" d="2932" wp="1" ws="1"><s p="1">دەوڵەمەندیی بنەماڵەکە تەنها لە ڕێگاوە نەدەهات.</s></p>
<p t="141260" d="3600" wp="1" ws="1"><s p="1">زەوییە بەراوەکانی دەشتی دیالە
گەنم و جۆی بەرهەمدەهێنا.</s></p>
<p t="144900" d="3120" wp="1" ws="1"><s p="1">عەشیرەتەکان زستانیان لە
دەشتە گەرمەکانی میزۆپۆتامیا و</s></p>
<p t="148060" d="2680" wp="1" ws="1"><s p="1">هاوینیشیان لە کوێستانە
فێنکەکانی چیاکاندا بەسەردەبرد.</s></p>
<p t="150780" d="5380" wp="1" ws="1"><s p="1">ئەم نەریتەی کوێستان و گەرمیان، هەم
دەشت و هەم شاخی دەکردە یەک نیشتمان.</s></p>
<p t="160880" d="3160" wp="1" ws="1"><s p="1">دەسەڵاتی عەننازییەکان پشتی
بە سیستەمێکی عەشایەری دەبەست.</s></p>
<p t="164080" d="5439" wp="1" ws="1"><s p="1">میر سەرۆکی بنەماڵەکە بوو، بەڵام هێزی خۆی لە
سوارچاکانی عەشیرەتی شازەنجانەوە وەردەگرت.</s></p>
<p t="169560" d="2960" wp="1" ws="1"><s p="1">زەوییەکان لە نێوان ئەندامانی
بنەماڵەکەدا دابەش دەکران.</s></p>
<p t="172560" d="2400" wp="1" ws="1"><s p="1">موهەلهیل، برای میر،</s></p>
<p t="175000" d="3400" wp="1" ws="1"><s p="1">حوکمی شارەزووری دەکرد و براکەی دیکەی،
سورخاب، حوکمی بەندەنیجینی دەکرد.</s></p>
<p t="178440" d="1840" wp="1" ws="1"><s p="1">لە کۆشکدا پێشوازی لە باڵیۆزان دەکرا،</s></p>
<p t="180320" d="3520" wp="1" ws="1"><s p="1">باج کۆدەکرایەوە و لەگەڵ سەرۆک
عەشیرەتەکاندا ئەنجومەن پێکدەهێنرا.</s></p>
<p t="183880" d="3400" wp="1" ws="1"><s p="1">بڕیارە گرنگەکان بە ڕەزامەندیی
گەورەکانی عەشیرەت دەدران.</s></p>
<p t="187320" d="3760" wp="1" ws="1"><s p="1">ئەم ڕێکخستنە، ڕەنگدانەوەی پێکهاتەی نەریتی
خێڵەکیی کوردی بوو کە بە درێژایی سەدەکان</s></p>
<p t="191120" d="1260" wp="1" ws="1"><s p="1">بەردەوام بوو.</s></p>
<p t="197100" d="2680" wp="1" ws="1"><s p="1">دڵی هێزی عەننازییەکان، سوارچاکەکان بوون.</s></p>
<p t="199820" d="3240" wp="1" ws="1"><s p="1">ئەسپسوارانی کوردی زرێپۆشی
سووک، ڕمبدار و تیرهاوێژ،</s></p>
<p t="203100" d="1560" wp="1" ws="1"><s p="1">لە</s></p>
<p t="204700" d="2160" wp="1" ws="1"><s p="1">دەشتەکاندا بە خێرایی دەجووڵانەوە و
لە گەرووی چیاکانیشدا بۆسەیان دادەنا.</s></p>
<p t="206900" d="2039" wp="1" ws="1"><s p="1">بەنرخترین سامانی بنەماڵەکە،</s></p>
<p t="208980" d="2800" wp="1" ws="1"><s p="1">ئەو قەڵایانە بوون کە لەسەر
بناری تیژی چیاکان دروست کرابوون.</s></p>
<p t="211820" d="4560" wp="1" ws="1"><s p="1">قەڵاکانی وەک سیروان، هەم شوێنی
شاردنەوەی گەنجینە بوون و هەم لە کاتی</s></p>
<p t="216420" d="1320" wp="1" ws="1"><s p="1">مەترسیدا پەناگەی بنەماڵەکە بوون.</s></p>
<p t="217780" d="4520" wp="1" ws="1"><s p="1">ئەمیرێک کە لە دەشتدا دەبەزی، دەیتوانی پاشەکشە
بکات بۆ قەڵاکەی لە شاخ و دووبارە هێز کۆبکاتەوە.</s></p>
<p t="222340" d="4420" wp="1" ws="1"><s p="1">لەبەر ئەم هۆکارە، تەنانەت ئەگەر عەننازییەکان
دەشتیشیان لەدەست بدایە، بە ئاسانی لەناو نەدەبران.</s></p>
<p t="231480" d="3600" wp="1" ws="1"><s p="1">بەهێزترین دراوسێی عەننازییەکان
بنەماڵەیەکی تری کوردی بوو:</s></p>
<p t="235120" d="3120" wp="1" ws="1"><s p="1">حەسەنوەیهییەکان کە فەرمانڕەوایی
دینەوەر و دەوروبەریان دەکرد.</s></p>
<p t="238280" d="2680" wp="1" ws="1"><s p="1">لە نێوان هەردوو بنەماڵەکەدا پەیوەندیی
خزمایەتی لە ڕێگەی هاوسەرگیرییەوە هەبوو.</s></p>
<p t="241000" d="2280" wp="1" ws="1"><s p="1">بەڵام لە هەمان کاتدا ڕکابەری
سەرسەختی یەکتری بوون.</s></p>
<p t="243320" d="4520" wp="1" ws="1"><s p="1">ئەم دوو بنەماڵە کوردە لە پێناو ڕێگاکانی کاروان
و تەنگەبەرەکاندا چەندین جار ڕووبەڕووی یەکتر</s></p>
<p t="247880" d="719" wp="1" ws="1"><s p="1">بوونەوە.</s></p>
<p t="248640" d="4000" wp="1" ws="1"><s p="1">کاتێک بەدر کوڕی حەسەنوەیه، ئەمیری
حەسەنوەیهییەکان لە ساڵی ١٠١٤دا کۆچی دوایی کرد،</s></p>
<p t="252680" d="1879" wp="1" ws="1"><s p="1">دەسەڵاتی حەسەنوەیهییەکان پەرتەوازە بوو.</s></p>
<p t="254600" d="3659" wp="1" ws="1"><s p="1">بەشێکی گرنگ لە خاکەکەیان
کەوتە دەست عەننازییەکان.</s></p>
<p t="262980" d="3772" wp="1" ws="1"><s p="1">گەشاوەترین سەردەمی ئەم بنەماڵەیە
لەگەڵ ئەبووشەوک فارسدا هاتە ئاراوە.</s></p>
<p t="266793" d="4186" wp="1" ws="1"><s p="1">ئەم ئەمیرەی کە نازناوی حوسامودەولەی
هەڵگرتبوو، سی و پێنج ساڵ حوکمڕانی کرد.</s></p>
<p t="271020" d="3759" wp="1" ws="1"><s p="1">لە سەردەمی ئەودا، خاکی عەننازییەکان
لە حەلوانەوە تا کرماشان،</s></p>
<p t="274820" d="4159" wp="1" ws="1"><s p="1">لە دینەوەرەوە تا شارەزوور، و لە
داقووقەوە تا بەندەنیجین درێژ دەبووەوە.</s></p>
<p t="279020" d="4480" wp="1" ws="1"><s p="1">بەشێکی گەورەی ئەم خاکە لە لێواری
ڕۆژهەڵاتی دەشتی میزۆپۆتامیادا هەڵکەوتبوو.</s></p>
<p t="283540" d="3799" wp="1" ws="1"><s p="1">سوارچاکانی عەننازی لە هاوسەنگیی
نێوان بەغدا و هەمەداندا هێزێک</s></p>
<p t="287380" d="3100" wp="1" ws="1"><s p="1">بوون کە دەبوو هەمووان حیسابی بۆ بکەن.</s></p>
<p t="295200" d="4039" wp="1" ws="1"><s p="1">عەننازییەکان هاوسەنگییەکی لێهاتووانەیان
لە نێوان دراوسێ بەهێزەکاندا دروست کرد.</s></p>
<p t="299280" d="2973" wp="1" ws="1"><s p="1">لە ڕۆژئاواوە، خەلافەتی عەباسی لە بەغدا هەبوو.</s></p>
<p t="302293" d="2506" wp="1" ws="1"><s p="1">لە باکووری ڕۆژئاواوە عوقەیلییەکان
فەرمانڕەوایی مووسڵیان دەکرد،</s></p>
<p t="304840" d="3000" wp="1" ws="1"><s p="1">و لە باشووری ڕۆژئاواشدا مەزیەدییەکان
لە حیللە دەسەڵاتدار بوون.</s></p>
<p t="307880" d="2639" wp="1" ws="1"><s p="1">لە ڕۆژهەڵاتیشەوە کاکوویەکان کە
ناوەندەکەیان لە ئەسفەهان بوو،</s></p>
<p t="310560" d="3039" wp="1" ws="1"><s p="1">بانگەشەی خاوەندارێتییان لەسەر
هەمەدان و دینەوەر دەکرد.</s></p>
<p t="313640" d="3079" wp="1" ws="1"><s p="1">ئەبووشەوک هەندێک جار لەگەڵ ئەم
دراوسێیانەدا هاوپەیمانیی دەبەست،</s></p>
<p t="316760" d="1920" wp="1" ws="1"><s p="1">و هەندێک جاریش شەڕی لەگەڵدا دەکردن.</s></p>
<p t="318720" d="4799" wp="1" ws="1"><s p="1">نێردراوەکان، دیارییەکان و پەیوەندییەکانی
هاوسەرگیری، چەکی هێندەی شمشێر گرنگ بوون.</s></p>
<p t="323560" d="4359" wp="1" ws="1"><s p="1">بنەماڵە کوردییە دوورەدەستەکانی وەک
مەروانییەکان و شەدادییەکان لە هەمان سەردەمدا لە</s></p>
<p t="327960" d="1300" wp="1" ws="1"><s p="1">گەشەسەندندا بوون.</s></p>
<p t="333980" d="2959" wp="1" ws="1"><s p="1">بەڵام برینێکی ناوخۆیی بنەماڵەکەی لاواز کرد.</s></p>
<p t="336980" d="3319" wp="1" ws="1"><s p="1">شەڕی دەسەڵات لە نێوان براکان
و برازاکاندا دەستی پێکرد.</s></p>
<p t="340340" d="4600" wp="1" ws="1"><s p="1">ڕکابەریی نێوان ئەبووشەوک و موهەلهیلی
برای، هۆزەکانی کرد بە دوو بەشەوە.</s></p>
<p t="344980" d="4919" wp="1" ws="1"><s p="1">دواتر سەعدیی کوڕی ئەبووشەوک، لە دژی
موهەلهیلی مامی پەنای بۆ هێزی دەرەکی برد.</s></p>
<p t="349940" d="3780" wp="1" ws="1"><s p="1">ئەم دووبەرەکییە ڕێگەی بۆ تۆفانێکی
نوێ کردەوە کە لە ڕۆژهەڵاتەوە دەهات.</s></p>
<p t="358440" d="4879" wp="1" ws="1"><s p="1">لە ناوەڕاستی سەدەی یازدەهەمدا، سەلجووقییەکان
بە خێرایی دەستیان بەسەر فەلاتەکانی ئێراندا گرت.</s></p>
<p t="363360" d="3959" wp="1" ws="1"><s p="1">لە ساڵی ١٠٤٦دا، ئیبراهیم ییناڵی فەرماندەی
سەلجووقییەکان بەرەو حەلوان بەڕێکەوت.</s></p>
<p t="367360" d="1959" wp="1" ws="1"><s p="1">شارەکە گەمارۆ درا و کەوت.</s></p>
<p t="369360" d="4359" wp="1" ws="1"><s p="1">لە هەمان ساڵدا، ئەبووشەوک لە قەڵای
سیروان لە نێو شاخەکاندا گیانی لەدەستدا.</s></p>
<p t="373760" d="3399" wp="1" ws="1"><s p="1">عەننازییەکان شارەکانی دەشتی
میزۆپۆتامیایان لەدەستدا،</s></p>
<p t="377200" d="2100" wp="1" ws="1"><s p="1">بەڵام دەستبەرداری شاخەکان نەبوون.</s></p>
<p t="384020" d="4492" wp="1" ws="1"><s p="1">بنەماڵەکە حەفتا ساڵی دیکەش لە قەڵاکان و
شاخەکاندا بەردەوامییان بە بوونی خۆیان دا.</s></p>
<p t="388553" d="2507" wp="1" ws="1"><s p="1">موهەلهیل و میرەکانی لە نەوەی ئەو،</s></p>
<p t="391100" d="3599" wp="1" ws="1"><s p="1">لە دەوروبەری شارەزوور، داقووق
و سیرواندا حوکمڕانییان کرد.</s></p>
<p t="394740" d="4479" wp="1" ws="1"><s p="1">لە دەوروبەری ساڵی ١١١٧دا، بنەماڵەی
عەننازی لە گۆڕەپانی مێژوو کشانەوە.</s></p>
<p t="399260" d="4479" wp="1" ws="1"><s p="1">ئەمە چیرۆکی یەکێک لە دوایین بنەماڵە
گەورەکانی کورد بوو کە لە دەروازەی ڕۆژهەڵاتی</s></p>
<p t="403780" d="1740" wp="1" ws="1"><s p="1">میزۆپۆتامیادا حوکمڕانییان دەکرد.</s></p>
<p t="410240" d="1879" wp="1" ws="1"><s p="1">مێژوونووس ڤلادیمیر مینۆرسکی،</s></p>
<p t="412160" d="4439" wp="1" ws="1"><s p="1">ئەم سەردەمەی کە بنەماڵەکانی
دەیلەمی و کورد تێیدا گەشەیان کرد،</s></p>
<p t="416640" d="719" wp="1" ws="1"><s p="1">بە قۆناغی نێوانبەری ئێران ناو دەبات.</s></p>
<p t="417400" d="4360" wp="1" ws="1"><s p="1">عەننازییەکان؛ لەگەڵ مەروانییەکان،
شەدادییەکان و حەسەنوەیهییەکاندا،</s></p>
<p t="421800" d="3919" wp="1" ws="1"><s p="1">ئەڵقەیەکی بەهێزی بوونی سیاسیی
کورد بوون لە چاخەکانی ناوەڕاستدا.</s></p>
<p t="425760" d="4399" wp="1" ws="1"><s p="1">ئەمڕۆ ئەو کوردانەی لە سەرپێڵی زەهاو،
شارەزوور و دەوروبەری داقووق دەژین،</s></p>
<p t="430200" d="2820" wp="1" ws="1"><s p="1">میراتگری ئەم چیرۆکە هەزار ساڵەیەن.</s></p>
<p t="433540" d="4039" wp="1" ws="1"><s p="1">هۆزێک، گەروویەک، میرنشینێکی سەد و سی ساڵە.</s></p>
<p t="437620" d="4119" wp="1" ws="1"><s p="1">ئەو لاپەڕانەی مێژووی کورد کە
هەوڵدرا لەبیر بکرێن، لە دیرۆکدا.</s></p>
<p t="441780" d="4280" wp="1" ws="1"><s p="1">ئەگەر ئەم ڤیدیۆیە بە دڵتان بوو، لەیادتان
نەچێت سەبسکرایب بکەن و بۆچوونەکانتان لە</s></p>
<p t="446100" d="1019" wp="1" ws="1"><s p="1">کۆمێنتدا بنووسن.</s></p>
</body>
</timedtext>
