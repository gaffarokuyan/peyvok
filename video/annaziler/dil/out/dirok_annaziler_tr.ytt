<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="110"/>
<wp id="1" ap="7" ah="50" av="92"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="2500" d="4640" wp="1" ws="1"><s p="1">Bin yıl önce, Mezopotamya’nın doğu
kapısında bir Kürt hanedanı yükseldi.</s></p>
<p t="7180" d="2240" wp="1" ws="1"><s p="1">Bağdat’tan Horasan’a uzanan büyük yol,</s></p>
<p t="9460" d="1920" wp="1" ws="1"><s p="1">onların topraklarından geçiyordu.</s></p>
<p t="11420" d="2360" wp="1" ws="1"><s p="1">Yüz otuz yıla yakın bu kapıyı tuttular.</s></p>
<p t="13820" d="2920" wp="1" ws="1"><s p="1">Saraylar kurdular, süvari orduları yönettiler,</s></p>
<p t="16780" d="3280" wp="1" ws="1"><s p="1">komşu hanedanlarla ittifaklar
ve savaşlar yaşadılar.</s></p>
<p t="20100" d="1960" wp="1" ws="1"><s p="1">Onların adı Annazîlerdi.</s></p>
<p t="22100" d="1692" wp="1" ws="1"><s p="1">Dîrok kanalına hoş geldiniz.</s></p>
<p t="23833" d="3987" wp="1" ws="1"><s p="1">Kürt tarihinin unutturulmaya çalışılmış
sayfalarını kaçırmamak için abone</s></p>
<p t="27860" d="1339" wp="1" ws="1"><s p="1">olmayı unutmayın.</s></p>
<p t="40620" d="1640" wp="1" ws="1"><s p="1">Dicle nehrinin doğusunda,</s></p>
<p t="42300" d="2360" wp="1" ws="1"><s p="1">Mezopotamya ovası dağlarla buluşur.</s></p>
<p t="44700" d="3000" wp="1" ws="1"><s p="1">İşte tam bu eşikte Hulvan şehri yükselir.</s></p>
<p t="47740" d="2759" wp="1" ws="1"><s p="1">Bugün Serpol-i Zehab adıyla bilinen bu şehir,</s></p>
<p t="50540" d="2867" wp="1" ws="1"><s p="1">Orta Çağ coğrafyacılarına göre Irak ovasının,</s></p>
<p t="53447" d="2385" wp="1" ws="1"><s p="1">yani Mezopotamya’nın son şehriydi.</s></p>
<p t="55873" d="2787" wp="1" ws="1"><s p="1">Hulvan’dan doğan Elvend suyu Diyala ırmağına,</s></p>
<p t="58700" d="1759" wp="1" ws="1"><s p="1">oradan da Dicle’ye karışır.</s></p>
<p t="60500" d="3000" wp="1" ws="1"><s p="1">Bu topraklar çok eski bir hafızaya sahiptir.</s></p>
<p t="63540" d="2879" wp="1" ws="1"><s p="1">Dört bin yıl önce Lullubi kralı Anubanini,</s></p>
<p t="66460" d="2412" wp="1" ws="1"><s p="1">zaferini Hulvan’ın kayalarına kazıttı.</s></p>
<p t="68913" d="3774" wp="1" ws="1"><s p="1">Daha sonra Kassitler bu bölgeden
çıkıp Babil tahtına oturdu.</s></p>
<p t="72727" d="4572" wp="1" ws="1"><s p="1">Kürtlerin ataları, binlerce yıl boyunca
Mezopotamya ile dağlar arasındaki bu</s></p>
<p t="77340" d="1259" wp="1" ws="1"><s p="1">kapıda yaşadı.</s></p>
<p t="83320" d="3920" wp="1" ws="1"><s p="1">Annazîlerin hikâyesi dokuz yüz
doksan yılı civarında başlar.</s></p>
<p t="87280" d="3719" wp="1" ws="1"><s p="1">Kürt Şazencan aşiretinden
Ebul Feth Muhammed bin Annaz,</s></p>
<p t="91040" d="2026" wp="1" ws="1"><s p="1">Hulvan şehrinde gücü ele aldı.</s></p>
<p t="93107" d="3012" wp="1" ws="1"><s p="1">Hanedan, adını onun babası Annaz’dan aldı.</s></p>
<p t="96160" d="4879" wp="1" ws="1"><s p="1">Şazencan aşireti, Mezopotamya ovası ile
dağlar arasında yaşayan güçlü bir Kürt</s></p>
<p t="101080" d="879" wp="1" ws="1"><s p="1">topluluğuydu.</s></p>
<p t="102000" d="4719" wp="1" ws="1"><s p="1">Ebul Feth, aşiretinin süvarileriyle
bölgedeki dengeleri kendi lehine çevirdi</s></p>
<p t="106760" d="2386" wp="1" ws="1"><s p="1">ve yirmi yıl boyunca Hulvan’ı yönetti.</s></p>
<p t="109187" d="4513" wp="1" ws="1"><s p="1">Böylece Mezopotamya’nın doğu kapısı
bir Kürt emirliğinin eline geçti.</s></p>
<p t="118420" d="2199" wp="1" ws="1"><s p="1">Hulvan sıradan bir şehir değildi.</s></p>
<p t="120660" d="3319" wp="1" ws="1"><s p="1">Bağdat’ı Hemedan’a ve
Horasan’a bağlayan büyük yol,</s></p>
<p t="124020" d="2079" wp="1" ws="1"><s p="1">buradan geçerek dağlara tırmanırdı.</s></p>
<p t="126140" d="3200" wp="1" ws="1"><s p="1">İpek, baharat, at ve kumaş yüklü kervanlar,</s></p>
<p t="129380" d="2040" wp="1" ws="1"><s p="1">Horasan’dan gelen hacı kafileleri,</s></p>
<p t="131460" d="3080" wp="1" ws="1"><s p="1">elçiler ve ordular bu kapıdan geçmek zorundaydı.</s></p>
<p t="134580" d="3667" wp="1" ws="1"><s p="1">Annazîler yolu korur,
karşılığında geçiş vergisi alırdı.</s></p>
<p t="138287" d="2932" wp="1" ws="1"><s p="1">Hanedanın zenginliği yalnızca yoldan gelmiyordu.</s></p>
<p t="141260" d="3600" wp="1" ws="1"><s p="1">Diyala ovasının sulak toprakları
buğday ve arpa verirdi.</s></p>
<p t="144900" d="3120" wp="1" ws="1"><s p="1">Aşiretler kışı Mezopotamya’nın ılık ovalarında,</s></p>
<p t="148060" d="2680" wp="1" ws="1"><s p="1">yazı ise serin dağ yaylalarında geçirirdi.</s></p>
<p t="150780" d="1680" wp="1" ws="1"><s p="1">Bu yayla ve kışla düzeni,</s></p>
<p t="152500" d="3660" wp="1" ws="1"><s p="1">hem ovayı hem dağı tek bir
yurt hâline getiriyordu.</s></p>
<p t="160880" d="3160" wp="1" ws="1"><s p="1">Annazî yönetimi bir aşiret düzenine dayanıyordu.</s></p>
<p t="164080" d="5439" wp="1" ws="1"><s p="1">Emir hanedanın başıydı, ama gücünü
Şazencan aşiretinin süvarilerinden alırdı.</s></p>
<p t="169560" d="2960" wp="1" ws="1"><s p="1">Topraklar hanedan üyeleri arasında paylaşılırdı.</s></p>
<p t="172560" d="2400" wp="1" ws="1"><s p="1">Emirin kardeşi Mühelhil Şehrizor’u,</s></p>
<p t="175000" d="3400" wp="1" ws="1"><s p="1">diğer kardeşi Surhab ise
Bendenicin’i yönetiyordu.</s></p>
<p t="178440" d="1840" wp="1" ws="1"><s p="1">Sarayda elçiler kabul edilir,</s></p>
<p t="180320" d="3520" wp="1" ws="1"><s p="1">vergiler toplanır, aşiret
reisleriyle meclis kurulurdu.</s></p>
<p t="183880" d="3400" wp="1" ws="1"><s p="1">Önemli kararlar, aşiret
büyüklerinin onayıyla alınırdı.</s></p>
<p t="187320" d="3760" wp="1" ws="1"><s p="1">Bu düzen, Kürt aşiret geleneğinin
yüzyıllar boyunca süren yapısını</s></p>
<p t="191120" d="1260" wp="1" ws="1"><s p="1">yansıtıyordu.</s></p>
<p t="197100" d="2680" wp="1" ws="1"><s p="1">Annazî gücünün kalbi süvarilerdi.</s></p>
<p t="199820" d="3240" wp="1" ws="1"><s p="1">Hafif zırhlı, mızraklı ve okçu Kürt atlıları,</s></p>
<p t="203100" d="1560" wp="1" ws="1"><s p="1">ovada hızla hareket eder,</s></p>
<p t="204700" d="2160" wp="1" ws="1"><s p="1">dağ geçitlerinde ise pusu kurardı.</s></p>
<p t="206900" d="2039" wp="1" ws="1"><s p="1">Hanedanın en değerli varlıkları,</s></p>
<p t="208980" d="2800" wp="1" ws="1"><s p="1">dağların sarp yamaçlarına kurulmuş kalelerdi.</s></p>
<p t="211820" d="4560" wp="1" ws="1"><s p="1">Sirvan gibi kaleler, hem hazinenin
saklandığı yer hem de tehlike anında</s></p>
<p t="216420" d="1320" wp="1" ws="1"><s p="1">ailenin sığınağıydı.</s></p>
<p t="217780" d="4520" wp="1" ws="1"><s p="1">Ovada yenilen bir emir, dağdaki kalesine
çekilip yeniden güç toplayabilirdi.</s></p>
<p t="222340" d="4420" wp="1" ws="1"><s p="1">Bu yüzden Annazîler ovayı kaybetse
bile kolayca yok edilemezdi.</s></p>
<p t="231480" d="3600" wp="1" ws="1"><s p="1">Annazîlerin en güçlü komşusu
da bir Kürt hanedanıydı:</s></p>
<p t="235120" d="3120" wp="1" ws="1"><s p="1">Dinever ve çevresini yöneten Hasanveyhîler.</s></p>
<p t="238280" d="2680" wp="1" ws="1"><s p="1">İki hanedan arasında evlilik bağları vardı.</s></p>
<p t="241000" d="2280" wp="1" ws="1"><s p="1">Ama aynı zamanda sert rakiptiler.</s></p>
<p t="243320" d="4520" wp="1" ws="1"><s p="1">İki Kürt ailesi, kervan yolları ve
geçitler için defalarca karşı karşıya</s></p>
<p t="247880" d="719" wp="1" ws="1"><s p="1">geldi.</s></p>
<p t="248640" d="4000" wp="1" ws="1"><s p="1">Hasanveyhî emiri Bedr bin
Hasanveyh bin on dörtte öldüğünde,</s></p>
<p t="252680" d="1879" wp="1" ws="1"><s p="1">Hasanveyhîlerin gücü dağıldı.</s></p>
<p t="254600" d="3659" wp="1" ws="1"><s p="1">Onların topraklarının önemli
bir kısmı Annazîlere geçti.</s></p>
<p t="262980" d="3772" wp="1" ws="1"><s p="1">Hanedanın en parlak dönemi
Ebuşşevk Faris ile geldi.</s></p>
<p t="266793" d="2466" wp="1" ws="1"><s p="1">Hüsameddevle unvanını taşıyan bu emir,</s></p>
<p t="269300" d="1679" wp="1" ws="1"><s p="1">otuz beş yıl hüküm sürdü.</s></p>
<p t="271020" d="3759" wp="1" ws="1"><s p="1">Onun döneminde Annazî toprakları
Hulvan’dan Kirmanşah’a,</s></p>
<p t="274820" d="4159" wp="1" ws="1"><s p="1">Dinever’den Şehrizor’a, Dakuk’tan
Bendenicin’e kadar uzanıyordu.</s></p>
<p t="279020" d="1600" wp="1" ws="1"><s p="1">Bu toprakların büyük kısmı,</s></p>
<p t="280660" d="2839" wp="1" ws="1"><s p="1">Mezopotamya ovasının doğu
kenarında yer alıyordu.</s></p>
<p t="283540" d="3799" wp="1" ws="1"><s p="1">Bağdat ile Hemedan arasındaki
dengede Annazî süvarileri,</s></p>
<p t="287380" d="3100" wp="1" ws="1"><s p="1">herkesin hesaba katmak zorunda olduğu bir güçtü.</s></p>
<p t="295200" d="4039" wp="1" ws="1"><s p="1">Annazîler, güçlü komşular
arasında ustaca bir denge kurdu.</s></p>
<p t="299280" d="2973" wp="1" ws="1"><s p="1">Batıda, Bağdat’taki Abbasi halifeliği vardı.</s></p>
<p t="302293" d="2506" wp="1" ws="1"><s p="1">Kuzeybatıda Musul’u yöneten Ukaylîler,</s></p>
<p t="304840" d="3000" wp="1" ws="1"><s p="1">güneybatıda Hille’de Mezyedîler hüküm sürüyordu.</s></p>
<p t="307880" d="2639" wp="1" ws="1"><s p="1">Doğuda ise İsfahan merkezli Kâkûyîler,</s></p>
<p t="310560" d="3039" wp="1" ws="1"><s p="1">Hemedan ve Dinever üzerinde hak iddia ediyordu.</s></p>
<p t="313640" d="3079" wp="1" ws="1"><s p="1">Ebuşşevk kimi zaman bu komşularla ittifak kurdu,</s></p>
<p t="316760" d="1920" wp="1" ws="1"><s p="1">kimi zaman onlarla savaştı.</s></p>
<p t="318720" d="2559" wp="1" ws="1"><s p="1">Elçiler, hediyeler ve evlilik bağları,</s></p>
<p t="321320" d="2199" wp="1" ws="1"><s p="1">kılıç kadar önemli birer silahtı.</s></p>
<p t="323560" d="4359" wp="1" ws="1"><s p="1">Uzaktaki Kürt hanedanları Mervânîler
ve Şeddâdîler de aynı çağda</s></p>
<p t="327960" d="1300" wp="1" ws="1"><s p="1">yükselişteydi.</s></p>
<p t="333980" d="2959" wp="1" ws="1"><s p="1">Ama hanedanı içeriden bir yara zayıflattı.</s></p>
<p t="336980" d="3319" wp="1" ws="1"><s p="1">Kardeşler ve yeğenler arasında
taht kavgaları başladı.</s></p>
<p t="340340" d="3000" wp="1" ws="1"><s p="1">Ebuşşevk ile kardeşi
Mühelhil arasındaki rekabet,</s></p>
<p t="343380" d="1560" wp="1" ws="1"><s p="1">aşiretleri ikiye böldü.</s></p>
<p t="344980" d="2239" wp="1" ws="1"><s p="1">Daha sonra Ebuşşevk’in oğlu Sadi,</s></p>
<p t="347260" d="2639" wp="1" ws="1"><s p="1">amcası Mühelhil’e karşı dışarıdan güç aradı.</s></p>
<p t="349940" d="3780" wp="1" ws="1"><s p="1">Bu bölünme, doğudan gelen yeni
bir fırtınanın önünü açtı.</s></p>
<p t="358440" d="4879" wp="1" ws="1"><s p="1">On birinci yüzyılın ortasında Selçuklular
İran yaylasını hızla ele geçirdi.</s></p>
<p t="363360" d="3959" wp="1" ws="1"><s p="1">Bin kırk altıda Selçuklu komutanı
İbrahim Yınal Hulvan’a yürüdü.</s></p>
<p t="367360" d="1959" wp="1" ws="1"><s p="1">Şehir kuşatıldı ve düştü.</s></p>
<p t="369360" d="4359" wp="1" ws="1"><s p="1">Aynı yıl Ebuşşevk, dağlardaki
Sirvan kalesinde hayatını kaybetti.</s></p>
<p t="373760" d="3399" wp="1" ws="1"><s p="1">Annazîler Mezopotamya
ovasındaki şehirlerini kaybetti,</s></p>
<p t="377200" d="2100" wp="1" ws="1"><s p="1">ama dağlardan vazgeçmedi.</s></p>
<p t="384020" d="4492" wp="1" ws="1"><s p="1">Hanedan, kalelerde ve dağlarda
yetmiş yıl daha varlığını sürdürdü.</s></p>
<p t="388553" d="2507" wp="1" ws="1"><s p="1">Mühelhil ve onun soyundan gelen emirler,</s></p>
<p t="391100" d="3599" wp="1" ws="1"><s p="1">Şehrizor, Dakuk ve Sirvan
çevresinde hüküm sürdü.</s></p>
<p t="394740" d="4479" wp="1" ws="1"><s p="1">Bin yüz on yedi civarında Annazî
hanedanı tarih sahnesinden çekildi.</s></p>
<p t="399260" d="4479" wp="1" ws="1"><s p="1">Bu, Mezopotamya’nın doğu kapısında hüküm
süren son büyük Kürt hanedanlarından</s></p>
<p t="403780" d="1740" wp="1" ws="1"><s p="1">birinin hikâyesiydi.</s></p>
<p t="410240" d="1879" wp="1" ws="1"><s p="1">Tarihçi Vladimir Minorsky,</s></p>
<p t="412160" d="4439" wp="1" ws="1"><s p="1">Deylemli ve Kürt hanedanlarının
yükseldiği bu çağa İran ara dönemi adını</s></p>
<p t="416640" d="719" wp="1" ws="1"><s p="1">verir.</s></p>
<p t="417400" d="4360" wp="1" ws="1"><s p="1">Annazîler; Mervânîler, Şeddâdîler
ve Hasanveyhîlerle birlikte,</s></p>
<p t="421800" d="3919" wp="1" ws="1"><s p="1">Kürtlerin Orta Çağdaki siyasi
varlığının güçlü bir halkasıydı.</s></p>
<p t="425760" d="4399" wp="1" ws="1"><s p="1">Bugün Serpol-i Zehab, Şehrizor ve
Dakuk çevresinde yaşayan Kürtler,</s></p>
<p t="430200" d="2820" wp="1" ws="1"><s p="1">bu bin yıllık hikâyenin mirasçılarıdır.</s></p>
<p t="433540" d="4039" wp="1" ws="1"><s p="1">Bir aşiret, bir geçit, yüz
otuz yıllık bir emirlik.</s></p>
<p t="437620" d="4119" wp="1" ws="1"><s p="1">Kürt tarihinin unutturulmaya
çalışılmış sayfaları Dîrok’ta.</s></p>
<p t="441780" d="4280" wp="1" ws="1"><s p="1">Bu videoyu beğendiyseniz abone olmayı
ve görüşlerinizi yorumlarda paylaşmayı</s></p>
<p t="446100" d="1019" wp="1" ws="1"><s p="1">unutmayın.</s></p>
</body>
</timedtext>
