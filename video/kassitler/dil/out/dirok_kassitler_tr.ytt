<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="110"/>
<pen id="2" b="1" i="1" fc="#FFD65A" fo="254" bc="#140804" bo="190" et="4" ec="#000000" fs="4" sz="115"/>
<wp id="1" ap="7" ah="50" av="92"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="1000" d="2239" wp="1" ws="1"><s p="1">Milattan önce on altıncı yüzyıl.</s></p>
<p t="3280" d="2080" wp="1" ws="1"><s p="1">Dünyanın en ünlü şehri Babil,</s></p>
<p t="5400" d="2319" wp="1" ws="1"><s p="1">yağmalanmış ve sahipsiz kalmıştı.</s></p>
<p t="7760" d="3320" wp="1" ws="1"><s p="1">Tahta oturan halk ne
Sümerliydi ne de Akadlı.</s></p>
<p t="11120" d="1600" wp="1" ws="1"><s p="1">Zagros dağlarından inmiş,</s></p>
<p t="12760" d="1800" wp="1" ws="1"><s p="1">atlarıyla tanınan bir halktı.</s></p>
<p t="14600" d="2840" wp="1" ws="1"><s p="1">Babil’i dört yüz yılı
aşkın bir süre yönettiler.</s></p>
<p t="17480" d="2972" wp="1" ws="1"><s p="1">Bu, Babil tarihinin en uzun hanedanıydı.</s></p>
<p t="20493" d="2107" wp="1" ws="1"><s p="1">Mısır firavunlarıyla mektuplaştılar,</s></p>
<p t="22640" d="3399" wp="1" ws="1"><s p="1">krallarına kız verdiler,
onlardan altın istediler.</s></p>
<p t="26080" d="1880" wp="1" ws="1"><s p="1">Onların adı Kassitlerdi.</s></p>
<p t="28000" d="2460" wp="1" ws="1"><s p="1">Yani Kürtlerin kadim ataları.</s></p>
<p t="30750" d="2219" wp="1" ws="1"><s p="1">Dîrok kanalına hoş geldiniz.</s></p>
<p t="45920" d="4920" wp="1" ws="1"><s p="1">Kassitlerin yurdu, Dicle Nehri’nin
doğusunda yükselen orta Zagros dağlarıydı.</s></p>
<p t="50880" d="2759" wp="1" ws="1"><s p="1">Bugün bu bölgede Kürtler ve Lurlar yaşar.</s></p>
<p t="53680" d="4960" wp="1" ws="1"><s p="1">Kassitler tarih sahnesine ilk kez Babil
Kralı Hammurabi’nin oğlu Samsu-iluna</s></p>
<p t="58680" d="1147" wp="1" ws="1"><s p="1">döneminde çıkar.</s></p>
<p t="59867" d="3052" wp="1" ws="1"><s p="1">Babil yıllıklarında bir
yıl şöyle adlandırılmıştır:</s></p>
<p t="62960" d="2067" wp="1" ws="1"><s p="1">Kassit ordusunun yenildiği yıl.</s></p>
<p t="65067" d="3905" wp="1" ws="1"><s p="1">Yani Kassitler daha o zamandan
Mezopotamya’nın kapısındaydı.</s></p>
<p t="69013" d="2266" wp="1" ws="1"><s p="1">Kassitlerin en büyük gücü atlardı.</s></p>
<p t="71320" d="3600" wp="1" ws="1"><s p="1">Zagros’un yaylalarında yetiştirdikleri
atlar ve savaş arabaları,</s></p>
<p t="74960" d="2946" wp="1" ws="1"><s p="1">onları dönemin en hızlı
ordularından biri yaptı.</s></p>
<p t="77947" d="3972" wp="1" ws="1"><s p="1">Babil metinlerinde at yetiştiriciliğine
dair pek çok terim Kassitçe’den</s></p>
<p t="81960" d="1059" wp="1" ws="1"><s p="1">geçmiştir.</s></p>
<p t="87740" d="5799" wp="1" ws="1"><s p="1">Milattan önce 1595 yılında Hitit Kralı
Birinci Murşili Babil’e kadar yürüdü ve</s></p>
<p t="93580" d="1079" wp="1" ws="1"><s p="1">şehri yağmaladı.</s></p>
<p t="94699" d="2280" wp="1" ws="1"><s p="1">Hammurabi’nin kurduğu hanedan çöktü.</s></p>
<p t="97020" d="3052" wp="1" ws="1"><s p="1">Hititler geri döndü, Babil sahipsiz kaldı.</s></p>
<p t="100113" d="2279" wp="1" ws="1"><s p="1">İşte bu boşluğu Kassitler doldurdu.</s></p>
<p t="102433" d="4307" wp="1" ws="1"><s p="1">Kassit kralları Babil’in tahtına oturdu
ve yaklaşık dört yüz otuz yıl hüküm</s></p>
<p t="106780" d="559" wp="1" ws="1"><s p="1">sürdü.</s></p>
<p t="107380" d="3359" wp="1" ws="1"><s p="1">Babil Kral Listesi otuz
altı Kassit kralını sayar.</s></p>
<p t="110780" d="4439" wp="1" ws="1"><s p="1">Bu, Mezopotamya tarihinde tek bir
hanedanın en uzun egemenliğidir.</s></p>
<p t="115259" d="2760" wp="1" ws="1"><s p="1">Kassitler ülkeye kendi
adlarını da verdiler.</s></p>
<p t="118060" d="3039" wp="1" ws="1"><s p="1">Onların döneminde Babil,
Karduniaş olarak anıldı.</s></p>
<p t="121139" d="4440" wp="1" ws="1"><s p="1">Bazı Kürt yazarlar bu adda Kardu
ve Kürt adlarının izini görür.</s></p>
<p t="125620" d="1759" wp="1" ws="1"><s p="1">Kassitler Babil’i yıkmadı.</s></p>
<p t="127419" d="4200" wp="1" ws="1"><s p="1">Tam tersine, dağınık şehir devletlerini
tek bir ülke haline getirdiler ve</s></p>
<p t="131660" d="3820" wp="1" ws="1"><s p="1">Güney Mezopotamya’yı yüzyıllarca
barış içinde yönettiler.</s></p>
<p t="135570" d="4360" wp="1" ws="1"><s p="1">Kassit kralı Agum, Hititlerin Babilden
kaçırdığı Marduk heykelini geri</s></p>
<p t="139970" d="1986" wp="1" ws="1"><s p="1">getirdiğini yazıtına kaydetti.</s></p>
<p t="141997" d="2913" wp="1" ws="1"><s p="1">Böylece Babil halkının gönlünü kazandı.</s></p>
<p t="149609" d="4400" wp="1" ws="1"><s p="1">Milattan önce on dördüncü yüzyılda
dünya beş büyük gücün elindeydi:</s></p>
<p t="154049" d="4120" wp="1" ws="1"><s p="1">Mısır, Hitit, Mitanni,
Asur ve Kassit Babil’i.</s></p>
<p t="158209" d="3280" wp="1" ws="1"><s p="1">Bu krallar birbirlerine
kardeşim diye hitap ediyordu.</s></p>
<p t="161529" d="3920" wp="1" ws="1"><s p="1">Mısır’da bulunan Amarna Mektupları
bu diplomasiyi bugüne taşıdı.</s></p>
<p t="165489" d="1680" wp="1" ws="1"><s p="1">Kassit Kralı Burnaburiaş,</s></p>
<p t="167209" d="3120" wp="1" ws="1"><s p="1">firavun Ahenaton’a yazdığı
mektupta şöyle yakınır:</s></p>
<p t="170369" d="2800" wp="1" ws="1"><s p="2">Gönderdiğin kırk mina
altını fırına koydum,</s></p>
<p t="173209" d="1560" wp="1" ws="1"><s p="1">on mina bile çıkmadı.</s></p>
<p t="174809" d="3827" wp="1" ws="1"><s p="1">Kassit kralları Mısır firavunlarıyla
evlilik ittifakları kurdu.</s></p>
<p t="178677" d="4133" wp="1" ws="1"><s p="1">Kadaşman-Enlil, kızını Firavun
Üçüncü Amenhotep’e gelin gönderdi.</s></p>
<p t="182850" d="4479" wp="1" ws="1"><s p="1">Zagros’tan inen bu halk, artık dünyanın
en güçlü krallarıyla eşit masada</s></p>
<p t="187369" d="1100" wp="1" ws="1"><s p="1">oturuyordu.</s></p>
<p t="188560" d="2039" wp="1" ws="1"><s p="1">Kassit Babilinin ticaret ağı,</s></p>
<p t="190640" d="4680" wp="1" ws="1"><s p="1">Afganistandaki lacivert taş madenlerinden
Basra Körfezindeki Dilmuna kadar</s></p>
<p t="195359" d="920" wp="1" ws="1"><s p="1">uzanıyordu.</s></p>
<p t="196320" d="3980" wp="1" ws="1"><s p="1">Bugünkü Bahreyn olan Dilmunu
bir Kassit valisi yönetiyordu.</s></p>
<p t="204999" d="3560" wp="1" ws="1"><s p="1">Kassitler Mezopotamya
medeniyetinin koruyucusu oldular.</s></p>
<p t="208599" d="4880" wp="1" ws="1"><s p="1">Kral Kurigalzu, bugünkü Bağdat’ın
yakınında kendi adını taşıyan Dur-Kurigalzu</s></p>
<p t="213519" d="1000" wp="1" ws="1"><s p="1">şehrini kurdu.</s></p>
<p t="214559" d="2879" wp="1" ws="1"><s p="1">Bu şehrin zigguratı bugün hâlâ ayaktadır.</s></p>
<p t="217479" d="4440" wp="1" ws="1"><s p="1">Kassitler Nippur ve Uruk gibi kadim
şehirlerin tapınaklarını yeniden inşa</s></p>
<p t="221959" d="560" wp="1" ws="1"><s p="1">etti.</s></p>
<p t="222559" d="4759" wp="1" ws="1"><s p="1">Gılgamış Destanı gibi büyük eserlerin
standart metinleri bu dönemde derlendi.</s></p>
<p t="227359" d="3240" wp="1" ws="1"><s p="1">Kassitler Mezopotamya’ya
yeni bir gelenek de getirdi:</s></p>
<p t="230640" d="2199" wp="1" ws="1"><s p="1">kudurru adı verilen sınır taşları.</s></p>
<p t="232879" d="3240" wp="1" ws="1"><s p="1">Krallar bağışladıkları
toprakları bu taşlara yazdırır,</s></p>
<p t="236159" d="3013" wp="1" ws="1"><s p="1">taşların üzerine tanrıların
sembollerini kazıtırdı.</s></p>
<p t="239212" d="2987" wp="1" ws="1"><s p="1">Kassitler Babil’in
tanrılarına saygı gösterdi,</s></p>
<p t="242239" d="2240" wp="1" ws="1"><s p="1">ama kendi dağ tanrılarını da unutmadı.</s></p>
<p t="244519" d="4460" wp="1" ws="1"><s p="1">Şukamuna ve Şumaliya, Zagros
dağlarının koruyucu tanrılarıydı.</s></p>
<p t="249069" d="4200" wp="1" ws="1"><s p="1">Nippur kazılarında Kassit dönemine
ait binlerce tablet bulundu.</s></p>
<p t="253309" d="4559" wp="1" ws="1"><s p="1">Bu tabletler vergi kayıtlarından at
bakımına kadar gündelik hayatı anlatır.</s></p>
<p t="257909" d="3140" wp="1" ws="1"><s p="1">Kassit ustaları cam
yapımında da ustalaştı.</s></p>
<p t="265749" d="4839" wp="1" ws="1"><s p="1">Milattan önce on ikinci yüzyılda
doğudaki komşu Elam saldırıya geçti.</s></p>
<p t="270629" d="5079" wp="1" ws="1"><s p="1">Elam Kralı Şutruk-Nahhunte Babil’i
yağmaladı ve Hammurabi Kanunlarının yazılı</s></p>
<p t="275749" d="2719" wp="1" ws="1"><s p="1">olduğu ünlü steli Susa şehrine götürdü.</s></p>
<p t="278509" d="3680" wp="1" ws="1"><s p="1">O stel bugün Paris’teki
Louvre Müzesi’nde sergilenir.</s></p>
<p t="282229" d="5359" wp="1" ws="1"><s p="1">Milattan önce 1155 civarında son
Kassit kralı Enlil-nadin-ahi tahtını</s></p>
<p t="287629" d="759" wp="1" ws="1"><s p="1">kaybetti.</s></p>
<p t="288429" d="2900" wp="1" ws="1"><s p="1">Babil’deki Kassit hanedanı sona erdi.</s></p>
<p t="296049" d="1839" wp="1" ws="1"><s p="1">Ama Kassitler yok olmadı.</s></p>
<p t="297929" d="4199" wp="1" ws="1"><s p="1">Babil tahtını kaybedince yurtları
olan Zagros dağlarına çekildiler.</s></p>
<p t="302169" d="4359" wp="1" ws="1"><s p="1">Asur kralları yüzyıllar boyunca
Kassit ülkesine seferler düzenledi.</s></p>
<p t="306569" d="4719" wp="1" ws="1"><s p="1">Asur Kralı Sanherib, milattan önce
702 yılında Kassitlerin dağlık yurduna</s></p>
<p t="311329" d="2000" wp="1" ws="1"><s p="1">yürüdüğünü yazıtlarına kaydetti.</s></p>
<p t="313369" d="4639" wp="1" ws="1"><s p="1">Bin yıl sonra Yunan tarihçiler aynı
halktan Kossaioi adıyla bahsetti.</s></p>
<p t="318049" d="3239" wp="1" ws="1"><s p="1">Strabon, Kossaiosların usta
okçular olduğunu yazar.</s></p>
<p t="321329" d="4040" wp="1" ws="1"><s p="1">Arrianos ise Büyük İskender’in onlara
karşı bir kış seferi düzenlediğini</s></p>
<p t="325409" d="719" wp="1" ws="1"><s p="1">anlatır.</s></p>
<p t="326169" d="4159" wp="1" ws="1"><s p="1">Pers kralları bile Susa ile Ekbatana
arasındaki dağ yolunu geçerken</s></p>
<p t="330369" d="2199" wp="1" ws="1"><s p="1">Kossaioslara geçiş vergisi öderdi.</s></p>
<p t="332609" d="3420" wp="1" ws="1"><s p="1">Zagros dağları bir kez
daha bir halkı korumuştu.</s></p>
<p t="336119" d="4919" wp="1" ws="1"><s p="1">Bugün Zagros dağlarının aynı vadilerinde
yaşayan Kürt ve Lur aşiretleri,</s></p>
<p t="341079" d="3180" wp="1" ws="1"><s p="1">binlerce yıldır süren bu
dağ yaşamını sürdürüyor.</s></p>
<p t="349039" d="2599" wp="1" ws="1"><s p="1">Kassitler bu topraklarda yalnız değildi.</s></p>
<p t="351679" d="2439" wp="1" ws="1"><s p="1">Gutiler, Lullubiler, Hurriler,</s></p>
<p t="354159" d="4412" wp="1" ws="1"><s p="1">Mitanniler ve Medler de Mezopotamya’nın
kuzeyinde ve doğusunda yaşadı.</s></p>
<p t="358612" d="4307" wp="1" ws="1"><s p="1">Pek çok tarihçiye göre bu halklar
Kürtleri oluşturan kadim katmanlardır.</s></p>
<p t="362960" d="3479" wp="1" ws="1"><s p="1">Bu görüşü savunanların başında
yabancı araştırmacılar gelir.</s></p>
<p t="366479" d="2519" wp="1" ws="1"><s p="1">Amerikalı Asurolog Ephraim Speiser,</s></p>
<p t="369039" d="5159" wp="1" ws="1"><s p="1">Mesopotamian Origins adlı eserinde
Kassitleri Gutiler ve Lullubilerle birlikte</s></p>
<p t="374239" d="2439" wp="1" ws="1"><s p="1">Zagros’un yerli halkları arasında sayar.</s></p>
<p t="376719" d="4759" wp="1" ws="1"><s p="1">Arşak Safrastian, Kurds and Kurdistan
adlı kitabında Zagros halklarını</s></p>
<p t="381520" d="2092" wp="1" ws="1"><s p="1">Kürtlerin ataları olarak inceler.</s></p>
<p t="383652" d="4546" wp="1" ws="1"><s p="1">Mehrdad İzady ise Kassitleri Kürt
halkını oluşturan en önemli katmanlardan</s></p>
<p t="388239" d="4199" wp="1" ws="1"><s p="1">biri olarak gösterir ve Kassit dağ
geleneklerinin izlerini bugünkü Kürt</s></p>
<p t="392479" d="1106" wp="1" ws="1"><s p="1">toplumunda arar.</s></p>
<p t="393626" d="4332" wp="1" ws="1"><s p="1">Kürt tarihçi Muhammed Emin Zeki Beg
de Kassitleri Kürtlerin kadim ataları</s></p>
<p t="397999" d="1079" wp="1" ws="1"><s p="1">arasında sayar.</s></p>
<p t="399119" d="2067" wp="1" ws="1"><s p="1">Elbette karşıt görüşler de vardır.</s></p>
<p t="401227" d="4092" wp="1" ws="1"><s p="1">Bunun temel nedeni Kassit dilinden
günümüze çok az belge kalmasıdır.</s></p>
<p t="405359" d="3719" wp="1" ws="1"><s p="1">Elimizde yalnızca iki dilli bir
sözlük ve kral adları vardır.</s></p>
<p t="409119" d="4492" wp="1" ws="1"><s p="1">Ancak coğrafya, dağ yaşamı ve binlerce
yıllık süreklilik bu bağı güçlü</s></p>
<p t="413652" d="1000" wp="1" ws="1"><s p="1">kılıyor.</s></p>
<p t="414979" d="2079" wp="1" ws="1"><s p="1">Zagros dağlarından inen bir halk,</s></p>
<p t="417099" d="3560" wp="1" ws="1"><s p="1">dünyanın en ünlü şehri
Babil’i dört yüz yıl yönetti.</s></p>
<p t="420700" d="2039" wp="1" ws="1"><s p="1">Firavunlarla eşit masada oturdu,</s></p>
<p t="422780" d="4439" wp="1" ws="1"><s p="1">Mezopotamya medeniyetini korudu
ve sonunda yine dağlarına döndü.</s></p>
<p t="427259" d="4439" wp="1" ws="1"><s p="1">Kassitlerin hikâyesi, Kürt tarihinin
en eski sayfalarından biridir.</s></p>
<p t="431739" d="4279" wp="1" ws="1"><s p="1">Bu videoyu beğendiyseniz abone olmayı
ve görüşlerinizi yorumlarda paylaşmayı</s></p>
<p t="436059" d="1000" wp="1" ws="1"><s p="1">unutmayın.</s></p>
</body>
</timedtext>
