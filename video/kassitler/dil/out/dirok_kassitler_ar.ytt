<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="110"/>
<pen id="2" b="1" i="1" fc="#FFD65A" fo="254" bc="#140804" bo="190" et="4" ec="#000000" fs="4" sz="115"/>
<wp id="1" ap="7" ah="50" av="92"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="1000" d="2239" wp="1" ws="1"><s p="1">القرن السادس عشر قبل الميلاد.</s></p>
<p t="3280" d="2080" wp="1" ws="1"><s p="1">كانت بابل، أشهر مدن العالم،</s></p>
<p t="5400" d="2319" wp="1" ws="1"><s p="1">قد نُهبت وبقيت بلا حاكم.</s></p>
<p t="7760" d="3320" wp="1" ws="1"><s p="1">لم يكن الشعب الذي جلس على
العرش سومريًا ولا أكديًا.</s></p>
<p t="11120" d="1600" wp="1" ws="1"><s p="1">كان شعبًا نزل من</s></p>
<p t="12760" d="1800" wp="1" ws="1"><s p="1">جبال زاغروس، واشتهر بخيوله.</s></p>
<p t="14600" d="2840" wp="1" ws="1"><s p="1">حكموا بابل أكثر من أربعمئة عام.</s></p>
<p t="17480" d="2972" wp="1" ws="1"><s p="1">وكانت تلك أطول سلالة في تاريخ بابل.</s></p>
<p t="20493" d="2107" wp="1" ws="1"><s p="1">راسلوا فراعنة مصر، وزوّجوا</s></p>
<p t="22640" d="3399" wp="1" ws="1"><s p="1">ملوكهم بناتهم، وطلبوا منهم الذهب.</s></p>
<p t="26080" d="1880" wp="1" ws="1"><s p="1">كان اسمهم الكاشيون.</s></p>
<p t="28000" d="2460" wp="1" ws="1"><s p="1">أي أجداد الكرد القدماء.</s></p>
<p t="30750" d="2219" wp="1" ws="1"><s p="1">أهلًا بكم في قناة ديروك.</s></p>
<p t="45920" d="4920" wp="1" ws="1"><s p="1">كان موطن الكاشيين جبال زاغروس
الوسطى التي ترتفع شرق نهر دجلة.</s></p>
<p t="50880" d="2759" wp="1" ws="1"><s p="1">واليوم يعيش في هذه المنطقة الكرد واللور.</s></p>
<p t="53680" d="4960" wp="1" ws="1"><s p="1">يظهر الكاشيون على مسرح التاريخ
أول مرة في عهد سمسو إيلونا، ابن</s></p>
<p t="58680" d="1147" wp="1" ws="1"><s p="1">ملك بابل حمورابي.</s></p>
<p t="59867" d="3052" wp="1" ws="1"><s p="1">وفي حوليات بابل سُمّيت إحدى السنوات هكذا:</s></p>
<p t="62960" d="2067" wp="1" ws="1"><s p="1">سنة هزيمة الجيش الكاشي.</s></p>
<p t="65067" d="3905" wp="1" ws="1"><s p="1">أي أن الكاشيين كانوا منذ ذلك
الحين على أبواب بلاد الرافدين.</s></p>
<p t="69013" d="2266" wp="1" ws="1"><s p="1">كانت الخيول أعظم قوة لدى الكاشيين.</s></p>
<p t="71320" d="3600" wp="1" ws="1"><s p="1">فالخيول والعربات الحربية
التي ربّوها في هضاب</s></p>
<p t="74960" d="2946" wp="1" ws="1"><s p="1">زاغروس جعلتهم من أسرع جيوش عصرهم.</s></p>
<p t="77947" d="3972" wp="1" ws="1"><s p="1">وكثير من مصطلحات تربية الخيول
في النصوص البابلية جاءت من اللغة</s></p>
<p t="81960" d="1059" wp="1" ws="1"><s p="1">الكاشية.</s></p>
<p t="87740" d="5799" wp="1" ws="1"><s p="1">في عام 1595 قبل الميلاد زحف
الملك الحثي مرسيلي الأول حتى بابل</s></p>
<p t="93580" d="1079" wp="1" ws="1"><s p="1">ونهب المدينة.</s></p>
<p t="94699" d="2280" wp="1" ws="1"><s p="1">وانهارت السلالة التي أسسها حمورابي.</s></p>
<p t="97020" d="3052" wp="1" ws="1"><s p="1">عاد الحثيون إلى بلادهم،
وبقيت بابل بلا حاكم.</s></p>
<p t="100113" d="2279" wp="1" ws="1"><s p="1">وهذا الفراغ ملأه الكاشيون.</s></p>
<p t="102433" d="4307" wp="1" ws="1"><s p="1">جلس ملوك الكاشيين على عرش بابل
وحكموا نحو أربعمئة وثلاثين</s></p>
<p t="106780" d="559" wp="1" ws="1"><s p="1">عامًا.</s></p>
<p t="107380" d="3359" wp="1" ws="1"><s p="1">تذكر قائمة ملوك بابل ستة
وثلاثين ملكًا كاشيًا.</s></p>
<p t="110780" d="4439" wp="1" ws="1"><s p="1">وهذه أطول سيادة لسلالة واحدة
في تاريخ بلاد الرافدين.</s></p>
<p t="115259" d="2760" wp="1" ws="1"><s p="1">وأعطى الكاشيون البلاد اسمهم أيضًا.</s></p>
<p t="118060" d="3039" wp="1" ws="1"><s p="1">ففي عهدهم عُرفت بابل باسم كاردونياش.</s></p>
<p t="121139" d="4440" wp="1" ws="1"><s p="1">ويرى بعض الكتّاب الكرد في هذا
الاسم أثرًا لاسمي كاردو والكرد.</s></p>
<p t="125620" d="1759" wp="1" ws="1"><s p="1">لم يدمّر الكاشيون بابل.</s></p>
<p t="127419" d="4200" wp="1" ws="1"><s p="1">بل على العكس، وحّدوا دويلات
المدن المتفرقة في بلد واحد،</s></p>
<p t="131660" d="3820" wp="1" ws="1"><s p="1">وحكموا جنوب بلاد الرافدين
بسلام قرونًا طويلة.</s></p>
<p t="135570" d="4360" wp="1" ws="1"><s p="1">سجّل الملك الكاشي أغوم في
نقشه أنه أعاد تمثال مردوخ</s></p>
<p t="139970" d="1986" wp="1" ws="1"><s p="1">الذي أخذه الحثيون من بابل.</s></p>
<p t="141997" d="2913" wp="1" ws="1"><s p="1">وبذلك كسب قلوب أهل بابل.</s></p>
<p t="149609" d="4400" wp="1" ws="1"><s p="1">في القرن الرابع عشر قبل
الميلاد كان العالم بيد خمس قوى</s></p>
<p t="154049" d="4120" wp="1" ws="1"><s p="1">كبرى: مصر والحثيين وميتاني
وآشور وبابل الكاشية.</s></p>
<p t="158209" d="3280" wp="1" ws="1"><s p="1">وكان هؤلاء الملوك يخاطب
بعضهم بعضًا بكلمة أخي.</s></p>
<p t="161529" d="3920" wp="1" ws="1"><s p="1">وقد حفظت رسائل العمارنة التي عُثر
عليها في مصر هذه الدبلوماسية حتى يومنا.</s></p>
<p t="165489" d="1680" wp="1" ws="1"><s p="1">يشكو الملك الكاشي بورنابورياش</s></p>
<p t="167209" d="3120" wp="1" ws="1"><s p="1">في رسالة إلى الفرعون إخناتون
قائلًا: وضعتُ في الفرن</s></p>
<p t="170369" d="2800" wp="1" ws="1"><s p="2">أربعين منًّا من الذهب
الذي أرسلته، فلم يخرج</s></p>
<p t="173209" d="1560" wp="1" ws="1"><s p="1">منها حتى عشرة أمناء.</s></p>
<p t="174809" d="3827" wp="1" ws="1"><s p="1">عقد ملوك الكاشيين تحالفات
زواج مع فراعنة مصر.</s></p>
<p t="178677" d="4133" wp="1" ws="1"><s p="1">فقد أرسل كادشمان إنليل ابنته
عروسًا إلى الفرعون أمنحوتب الثالث.</s></p>
<p t="182850" d="4479" wp="1" ws="1"><s p="1">هذا الشعب النازل من زاغروس صار
يجلس على طاولة واحدة مع أقوى</s></p>
<p t="187369" d="1100" wp="1" ws="1"><s p="1">ملوك العالم.</s></p>
<p t="188560" d="2039" wp="1" ws="1"><s p="1">امتدت شبكة تجارة بابل</s></p>
<p t="190640" d="4680" wp="1" ws="1"><s p="1">الكاشية من مناجم اللازورد
في أفغانستان إلى دلمون في</s></p>
<p t="195359" d="920" wp="1" ws="1"><s p="1">الخليج.</s></p>
<p t="196320" d="3980" wp="1" ws="1"><s p="1">وكان يحكم دلمون، أي
البحرين اليوم، والٍ كاشي.</s></p>
<p t="204999" d="3560" wp="1" ws="1"><s p="1">أصبح الكاشيون حماة حضارة بلاد الرافدين.</s></p>
<p t="208599" d="4880" wp="1" ws="1"><s p="1">أسس الملك كوريغالزو قرب بغداد
اليوم مدينة دور كوريغالزو التي</s></p>
<p t="213519" d="1000" wp="1" ws="1"><s p="1">تحمل اسمه.</s></p>
<p t="214559" d="2879" wp="1" ws="1"><s p="1">ولا تزال زقورة هذه
المدينة قائمة حتى اليوم.</s></p>
<p t="217479" d="4440" wp="1" ws="1"><s p="1">وأعاد الكاشيون بناء معابد
المدن القديمة مثل نيبور</s></p>
<p t="221959" d="560" wp="1" ws="1"><s p="1">وأوروك.</s></p>
<p t="222559" d="4759" wp="1" ws="1"><s p="1">وفي هذه الحقبة جُمعت النصوص المعيارية
لأعمال عظيمة مثل ملحمة جلجامش.</s></p>
<p t="227359" d="3240" wp="1" ws="1"><s p="1">وجاء الكاشيون إلى بلاد
الرافدين بتقليد جديد</s></p>
<p t="230640" d="2199" wp="1" ws="1"><s p="1">أيضًا: أحجار الحدود المسماة كودورو.</s></p>
<p t="232879" d="3240" wp="1" ws="1"><s p="1">كان الملوك ينقشون على هذه الأحجار الأراضي</s></p>
<p t="236159" d="3013" wp="1" ws="1"><s p="1">التي يمنحونها، ويحفرون عليها رموز الآلهة.</s></p>
<p t="239212" d="2987" wp="1" ws="1"><s p="1">احترم الكاشيون آلهة بابل، لكنهم</s></p>
<p t="242239" d="2240" wp="1" ws="1"><s p="1">لم ينسوا آلهة جبالهم.</s></p>
<p t="244519" d="4460" wp="1" ws="1"><s p="1">فقد كان شوقامونا وشوماليا
الإلهين الحاميين لجبال زاغروس.</s></p>
<p t="249069" d="4200" wp="1" ws="1"><s p="1">وفي حفريات نيبور عُثر على
آلاف الألواح من العصر الكاشي.</s></p>
<p t="253309" d="4559" wp="1" ws="1"><s p="1">وتصف هذه الألواح الحياة اليومية،
من سجلات الضرائب إلى رعاية الخيول.</s></p>
<p t="257909" d="3140" wp="1" ws="1"><s p="1">وبرع الحرفيون الكاشيون
أيضًا في صناعة الزجاج.</s></p>
<p t="265749" d="4839" wp="1" ws="1"><s p="1">في القرن الثاني عشر قبل الميلاد
شنّت عيلام، الجارة الشرقية، هجومها.</s></p>
<p t="270629" d="5079" wp="1" ws="1"><s p="1">نهب الملك العيلامي شوتروك ناخونتي
بابل، وحمل إلى مدينة سوسة المسلة</s></p>
<p t="275749" d="2719" wp="1" ws="1"><s p="1">الشهيرة التي نُقشت عليها شريعة حمورابي.</s></p>
<p t="278509" d="3680" wp="1" ws="1"><s p="1">وتُعرض تلك المسلة اليوم
في متحف اللوفر في باريس.</s></p>
<p t="282229" d="5359" wp="1" ws="1"><s p="1">ونحو عام 1155 قبل الميلاد فقد آخر
الملوك الكاشيين، إنليل نادين آخي،</s></p>
<p t="287629" d="759" wp="1" ws="1"><s p="1">عرشه.</s></p>
<p t="288429" d="2900" wp="1" ws="1"><s p="1">وانتهت السلالة الكاشية في بابل.</s></p>
<p t="296049" d="1839" wp="1" ws="1"><s p="1">لكن الكاشيين لم يختفوا.</s></p>
<p t="297929" d="4199" wp="1" ws="1"><s p="1">فلما فقدوا عرش بابل انسحبوا
إلى موطنهم، جبال زاغروس.</s></p>
<p t="302169" d="4359" wp="1" ws="1"><s p="1">وعلى مدى قرون شنّ ملوك آشور
حملات على البلاد الكاشية.</s></p>
<p t="306569" d="4719" wp="1" ws="1"><s p="1">وسجّل الملك الآشوري سنحاريب
في نقوشه أنه زحف عام 702 قبل</s></p>
<p t="311329" d="2000" wp="1" ws="1"><s p="1">الميلاد إلى موطن الكاشيين الجبلي.</s></p>
<p t="313369" d="4639" wp="1" ws="1"><s p="1">وبعد ألف عام كتب المؤرخون اليونان
عن الشعب نفسه باسم الكوسيين.</s></p>
<p t="318049" d="3239" wp="1" ws="1"><s p="1">يكتب سترابون أن الكوسيين كانوا رماة مهرة.</s></p>
<p t="321329" d="4040" wp="1" ws="1"><s p="1">ويروي أريان أن الإسكندر
الأكبر شنّ عليهم حملة</s></p>
<p t="325409" d="719" wp="1" ws="1"><s p="1">شتوية.</s></p>
<p t="326169" d="4159" wp="1" ws="1"><s p="1">حتى ملوك الفرس كانوا يدفعون
للكوسيين رسوم عبور حين يجتازون</s></p>
<p t="330369" d="2199" wp="1" ws="1"><s p="1">الطريق الجبلي بين سوسة وإكباتانا.</s></p>
<p t="332609" d="3420" wp="1" ws="1"><s p="1">ومرة أخرى حمت جبال زاغروس شعبًا.</s></p>
<p t="336119" d="4919" wp="1" ws="1"><s p="1">واليوم تواصل العشائر الكردية واللورية
التي تعيش في وديان زاغروس نفسها</s></p>
<p t="341079" d="3180" wp="1" ws="1"><s p="1">هذه الحياة الجبلية
الممتدة منذ آلاف السنين.</s></p>
<p t="349039" d="2599" wp="1" ws="1"><s p="1">لم يكن الكاشيون وحدهم في هذه الأرض.</s></p>
<p t="351679" d="2439" wp="1" ws="1"><s p="1">فقد عاش الغوتيون واللولوبيون</s></p>
<p t="354159" d="4412" wp="1" ws="1"><s p="1">والحوريون والميتانيون والميديون
أيضًا في شمال بلاد الرافدين وشرقها.</s></p>
<p t="358612" d="4307" wp="1" ws="1"><s p="1">وبحسب كثير من المؤرخين فإن هذه الشعوب هي
الطبقات القديمة التي تكوّن منها الكرد.</s></p>
<p t="362960" d="3479" wp="1" ws="1"><s p="1">وفي مقدمة من يتبنون
هذا الرأي باحثون أجانب.</s></p>
<p t="366479" d="2519" wp="1" ws="1"><s p="1">فالآشوري الأمريكي إفرايم سبايزر</s></p>
<p t="369039" d="5159" wp="1" ws="1"><s p="1">يعدّ الكاشيين، مع الغوتيين
واللولوبيين، في كتابه أصول بلاد</s></p>
<p t="374239" d="2439" wp="1" ws="1"><s p="1">الرافدين من الشعوب الأصلية لزاغروس.</s></p>
<p t="376719" d="4759" wp="1" ws="1"><s p="1">ويدرس أرشاك سافراستيان في
كتابه الكرد وكردستان شعوب</s></p>
<p t="381520" d="2092" wp="1" ws="1"><s p="1">زاغروس بوصفها أجداد الكرد.</s></p>
<p t="383652" d="4546" wp="1" ws="1"><s p="1">أما مهرداد إزادي فيعرض الكاشيين
بوصفهم من أهم الطبقات التي تكوّن</s></p>
<p t="388239" d="4199" wp="1" ws="1"><s p="1">منها الشعب الكردي، ويبحث عن آثار
التقاليد الجبلية الكاشية في المجتمع</s></p>
<p t="392479" d="1106" wp="1" ws="1"><s p="1">الكردي اليوم.</s></p>
<p t="393626" d="4332" wp="1" ws="1"><s p="1">ويعدّ المؤرخ الكردي محمد أمين
زكي بك الكاشيين أيضًا من أجداد</s></p>
<p t="397999" d="1079" wp="1" ws="1"><s p="1">الكرد القدماء.</s></p>
<p t="399119" d="2067" wp="1" ws="1"><s p="1">وبالطبع هناك آراء معارضة أيضًا.</s></p>
<p t="401227" d="4092" wp="1" ws="1"><s p="1">والسبب الرئيسي أن ما بقي من
وثائق باللغة الكاشية قليل جدًا.</s></p>
<p t="405359" d="3719" wp="1" ws="1"><s p="1">فكل ما بين أيدينا معجم
ثنائي اللغة وأسماء الملوك.</s></p>
<p t="409119" d="4492" wp="1" ws="1"><s p="1">لكن الجغرافيا والحياة الجبلية
واستمرار آلاف السنين تجعل هذه الصلة</s></p>
<p t="413652" d="1000" wp="1" ws="1"><s p="1">قوية.</s></p>
<p t="414979" d="2079" wp="1" ws="1"><s p="1">شعب نزل من جبال زاغروس</s></p>
<p t="417099" d="3560" wp="1" ws="1"><s p="1">حكم بابل، أشهر مدن العالم، أربعمئة عام.</s></p>
<p t="420700" d="2039" wp="1" ws="1"><s p="1">جلس مع الفراعنة على طاولة</s></p>
<p t="422780" d="4439" wp="1" ws="1"><s p="1">واحدة، وحمى حضارة بلاد الرافدين،
وعاد في النهاية إلى جباله.</s></p>
<p t="427259" d="4439" wp="1" ws="1"><s p="1">قصة الكاشيين صفحة من
أقدم صفحات تاريخ الكرد.</s></p>
<p t="431739" d="4279" wp="1" ws="1"><s p="1">إن أعجبكم هذا الفيديو فلا تنسوا
الاشتراك ومشاركة آرائكم في</s></p>
<p t="436059" d="1000" wp="1" ws="1"><s p="1">التعليقات.</s></p>
</body>
</timedtext>
