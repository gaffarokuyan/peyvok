<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="120"/>
<pen id="2" b="1" fc="#FFD23A" fo="254" bc="#140804" bo="190" et="4" ec="#000000" fs="4" sz="125"/>
<wp id="1" ap="7" ah="50" av="80"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="400" d="1650" wp="1" ws="1"><s p="1">چوار هەزار و دوو سەد</s></p>
<p t="2080" d="1890" wp="1" ws="1"><s p="1">ساڵ لەمەوبەر،
گەلێک کە لە چیاکانی</s></p>
<p t="4000" d="1610" wp="1" ws="1"><s p="1">زاگرۆسەوە دابەزی، یەکەم
ئیمپراتۆریەتی جیهانی</s></p>
<p t="5640" d="609" wp="1" ws="1"><s p="1">ڕووخاند.</s></p>
<p t="6280" d="2170" wp="1" ws="1"><s p="1">سۆمەرییەکان بە
ترسەوە ناویان نان</s></p>
<p t="8480" d="1290" wp="1" ws="1"><s p="2">ئەژدیهای چیاکان.</s></p>
<p t="9800" d="1530" wp="1" ws="1"><s p="1">ئەوانە گوتییەکان بوون.</s></p>
<p t="11360" d="1250" wp="1" ws="1"><s p="1">ئیمپراتۆریەتی
ئەکەدیان چۆک پێ</s></p>
<p t="12640" d="2210" wp="1" ws="1"><s p="1">دادا و سەد ساڵی تەواو</s></p>
<p t="14880" d="1409" wp="1" ws="1"><s p="1">فەرمانڕەوایی
میزۆپۆتامیایان کرد.</s></p>
<p t="16320" d="1809" wp="1" ws="1"><s p="1">لیستی پاشا
سۆمەرییەکان بەم شێوەیە</s></p>
<p t="18160" d="1649" wp="1" ws="1"><s p="1">باسیان دەکات: خۆیان پاشای</s></p>
<p t="19840" d="982" wp="1" ws="1"><s p="1">خۆیان بوون.</s></p>
<p t="20852" d="1036" wp="1" ws="1"><s p="1">بیست و یەک</s></p>
<p t="21919" d="2410" wp="1" ws="1"><s p="1">پاشا، ئەنجومەنی
هۆز و خۆبەڕێوەبەریی</s></p>
<p t="24360" d="1929" wp="1" ws="1"><s p="1">ناوچەیی. ئەم سیستەمە
هەزاران ساڵ دواتر</s></p>
<p t="26320" d="1782" wp="1" ws="1"><s p="2">لە کۆمەڵگەی کورددا
بەردەوام بوو.</s></p>
<p t="28133" d="2116" wp="1" ws="1"><s p="1">ناوی گوتیوم
هەرگیز ون نەبوو.</s></p>
<p t="30279" d="1730" wp="1" ws="1"><s p="1">لە تۆمارە
ئاشوورییەکاندا کورتی،</s></p>
<p t="32040" d="1609" wp="1" ws="1"><s p="1">لای گزێنەفۆن کاردۆخ، لە</s></p>
<p t="33680" d="2359" wp="1" ws="1"><s p="1">سەردەمی ڕۆمادا
کۆردوێنێ و ئەمڕۆ</s></p>
<p t="36080" d="689" wp="1" ws="1"><s p="2">کورد.</s></p>
<p t="36800" d="1369" wp="1" ws="1"><s p="1">بە بۆچوونی</s></p>
<p t="38199" d="929" wp="1" ws="1"><s p="1">توێژەرانی وەک</s></p>
<p t="39160" d="2143" wp="1" ws="1"><s p="1">ئەرشاک سافراستیان،
گۆدفری درایڤەر، ئێفرایم</s></p>
<p t="41333" d="1877" wp="1" ws="1"><s p="1">سپایزەر و مێهرداد ئیزەدی،</s></p>
<p t="43240" d="1329" wp="1" ws="1"><s p="2">گوتییەکان
باوباپیرانی کوردن.</s></p>
<p t="44600" d="1609" wp="1" ws="1"><s p="1">هۆرییەکان، میتانییەکان،
لولۆبییەکان،</s></p>
<p t="46240" d="1769" wp="1" ws="1"><s p="1">کاسییەکان، مادەکان و</s></p>
<p t="48040" d="1409" wp="1" ws="1"><s p="1">کۆردوێنێ: هەموویان</s></p>
<p t="49480" d="1649" wp="1" ws="1"><s p="1">ڕەگە چوار هەزار ساڵەکانی</s></p>
<p t="51160" d="1289" wp="1" ws="1"><s p="2">گەلی کوردن.</s></p>
<p t="52480" d="1517" wp="1" ws="1"><s p="1">لە کەناڵی دیرۆک
سەبسکرایب بکەن</s></p>
<p t="54027" d="1773" wp="1" ws="1"><s p="1">و درێژەی چیرۆکەکە
لەدەست مەدەن.</s></p>
</body>
</timedtext>
