<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="120"/>
<pen id="2" b="1" fc="#FFD23A" fo="254" bc="#140804" bo="190" et="4" ec="#000000" fs="4" sz="125"/>
<wp id="1" ap="7" ah="50" av="80"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="400" d="1650" wp="1" ws="1"><s p="1">قبل أربعة آلاف ومئتي</s></p>
<p t="2080" d="1890" wp="1" ws="1"><s p="1">عام، أسقط شعبٌ نزل من</s></p>
<p t="4000" d="1610" wp="1" ws="1"><s p="1">جبال زاغروس أول
إمبراطورية في</s></p>
<p t="5640" d="609" wp="1" ws="1"><s p="1">العالم.</s></p>
<p t="6280" d="2170" wp="1" ws="1"><s p="2">سمّاهم السومريون بخوف تنين</s></p>
<p t="8480" d="1290" wp="1" ws="1"><s p="1">الجبال.</s></p>
<p t="9800" d="1530" wp="1" ws="1"><s p="1">إنهم الغوتيون.</s></p>
<p t="11360" d="1250" wp="1" ws="1"><s p="1">أخضعوا الإمبراطورية
الأكدية</s></p>
<p t="12640" d="2210" wp="1" ws="1"><s p="1">وحكموا بلاد الرافدين مئة</s></p>
<p t="14880" d="1409" wp="1" ws="1"><s p="1">عام كاملة.</s></p>
<p t="16320" d="1809" wp="1" ws="1"><s p="1">تصفهم قائمة
الملوك السومرية</s></p>
<p t="18160" d="1649" wp="1" ws="1"><s p="1">هكذا: كانوا ملوك</s></p>
<p t="19840" d="982" wp="1" ws="1"><s p="1">أنفسهم.</s></p>
<p t="20852" d="1036" wp="1" ws="1"><s p="1">واحد وعشرون</s></p>
<p t="21919" d="2410" wp="1" ws="1"><s p="1">ملكًا، ومجلس عشائري،
واستقلال محلي.</s></p>
<p t="24360" d="1929" wp="1" ws="1"><s p="1">وبعد آلاف السنين استمر هذا</s></p>
<p t="26320" d="1782" wp="1" ws="1"><s p="2">النظام في المجتمع الكردي.</s></p>
<p t="28133" d="2116" wp="1" ws="1"><s p="1">ولم يختفِ اسم
غوتيوم أبدًا.</s></p>
<p t="30279" d="1730" wp="1" ws="1"><s p="1">قورتي في السجلات الآشورية،</s></p>
<p t="32040" d="1609" wp="1" ws="1"><s p="1">وكاردوخ عند زينوفون،</s></p>
<p t="33680" d="2359" wp="1" ws="1"><s p="1">وكوردوين في العهد
الروماني، واليوم</s></p>
<p t="36080" d="689" wp="1" ws="1"><s p="2">الكرد.</s></p>
<p t="36800" d="1369" wp="1" ws="1"><s p="1">بحسب باحثين</s></p>
<p t="38199" d="929" wp="1" ws="1"><s p="1">مثل أرشاك</s></p>
<p t="39160" d="2143" wp="1" ws="1"><s p="1">سافراستيان وغودفري
درايفر وإفرايم سبايزر</s></p>
<p t="41333" d="1877" wp="1" ws="1"><s p="1">ومهرداد إزادي،
فإن الغوتيين</s></p>
<p t="43240" d="1329" wp="1" ws="1"><s p="2">هم أجداد الكرد.</s></p>
<p t="44600" d="1609" wp="1" ws="1"><s p="1">الحوريون والميتانيون
واللولوبيون</s></p>
<p t="46240" d="1769" wp="1" ws="1"><s p="1">والكاشيون
والميديون وكوردوين:</s></p>
<p t="48040" d="1409" wp="1" ws="1"><s p="1">كلهم جذور</s></p>
<p t="49480" d="1649" wp="1" ws="1"><s p="2">الشعب الكردي الممتدة أربعة</s></p>
<p t="51160" d="1289" wp="1" ws="1"><s p="1">آلاف عام.</s></p>
<p t="52480" d="1517" wp="1" ws="1"><s p="1">اشتركوا في قناة ديروك</s></p>
<p t="54027" d="1773" wp="1" ws="1"><s p="1">ولا تفوّتوا بقية القصة.</s></p>
</body>
</timedtext>
