Dialogue: 0,0:00:00.40,0:00:02.05,Dirok,,0,0,0,,چوار هەزار و دوو سەد
Dialogue: 0,0:00:02.08,0:00:03.97,Dirok,,0,0,0,,ساڵ لەمەوبەر،\Nگەلێک کە لە چیاکانی
Dialogue: 0,0:00:04.00,0:00:05.61,Dirok,,0,0,0,,زاگرۆسەوە دابەزی، یەکەم\Nئیمپراتۆریەتی جیهانی
Dialogue: 0,0:00:05.64,0:00:06.25,Dirok,,0,0,0,,ڕووخاند.
Dialogue: 0,0:00:06.28,0:00:08.45,Dirok,,0,0,0,,سۆمەرییەکان بە\Nترسەوە ناویان نان
Dialogue: 0,0:00:08.48,0:00:09.77,DirokVurgu,,0,0,0,,ئەژدیهای چیاکان.
Dialogue: 0,0:00:09.80,0:00:11.33,Dirok,,0,0,0,,ئەوانە گوتییەکان بوون.
Dialogue: 0,0:00:11.36,0:00:12.61,Dirok,,0,0,0,,ئیمپراتۆریەتی\Nئەکەدیان چۆک پێ
Dialogue: 0,0:00:12.64,0:00:14.85,Dirok,,0,0,0,,دادا و سەد ساڵی تەواو
Dialogue: 0,0:00:14.88,0:00:16.29,Dirok,,0,0,0,,فەرمانڕەوایی\Nمیزۆپۆتامیایان کرد.
Dialogue: 0,0:00:16.32,0:00:18.13,Dirok,,0,0,0,,لیستی پاشا\Nسۆمەرییەکان بەم شێوەیە
Dialogue: 0,0:00:18.16,0:00:19.81,Dirok,,0,0,0,,باسیان دەکات: خۆیان پاشای
Dialogue: 0,0:00:19.84,0:00:20.82,Dirok,,0,0,0,,خۆیان بوون.
Dialogue: 0,0:00:20.85,0:00:21.89,Dirok,,0,0,0,,بیست و یەک
Dialogue: 0,0:00:21.92,0:00:24.33,Dirok,,0,0,0,,پاشا، ئەنجومەنی\Nهۆز و خۆبەڕێوەبەریی
Dialogue: 0,0:00:24.36,0:00:26.29,Dirok,,0,0,0,,ناوچەیی. ئەم سیستەمە\Nهەزاران ساڵ دواتر
Dialogue: 0,0:00:26.32,0:00:28.10,DirokVurgu,,0,0,0,,لە کۆمەڵگەی کورددا\Nبەردەوام بوو.
Dialogue: 0,0:00:28.13,0:00:30.25,Dirok,,0,0,0,,ناوی گوتیوم\Nهەرگیز ون نەبوو.
Dialogue: 0,0:00:30.28,0:00:32.01,Dirok,,0,0,0,,لە تۆمارە\Nئاشوورییەکاندا کورتی،
Dialogue: 0,0:00:32.04,0:00:33.65,Dirok,,0,0,0,,لای گزێنەفۆن کاردۆخ، لە
Dialogue: 0,0:00:33.68,0:00:36.04,Dirok,,0,0,0,,سەردەمی ڕۆمادا\Nکۆردوێنێ و ئەمڕۆ
Dialogue: 0,0:00:36.08,0:00:36.77,DirokVurgu,,0,0,0,,کورد.
Dialogue: 0,0:00:36.80,0:00:38.17,Dirok,,0,0,0,,بە بۆچوونی
Dialogue: 0,0:00:38.20,0:00:39.13,Dirok,,0,0,0,,توێژەرانی وەک
Dialogue: 0,0:00:39.16,0:00:41.30,Dirok,,0,0,0,,ئەرشاک سافراستیان،\Nگۆدفری درایڤەر، ئێفرایم
Dialogue: 0,0:00:41.33,0:00:43.21,Dirok,,0,0,0,,سپایزەر و مێهرداد ئیزەدی،
Dialogue: 0,0:00:43.24,0:00:44.57,DirokVurgu,,0,0,0,,گوتییەکان\Nباوباپیرانی کوردن.
Dialogue: 0,0:00:44.60,0:00:46.21,Dirok,,0,0,0,,هۆرییەکان، میتانییەکان،\Nلولۆبییەکان،
Dialogue: 0,0:00:46.24,0:00:48.01,Dirok,,0,0,0,,کاسییەکان، مادەکان و
Dialogue: 0,0:00:48.04,0:00:49.45,Dirok,,0,0,0,,کۆردوێنێ: هەموویان
Dialogue: 0,0:00:49.48,0:00:51.13,Dirok,,0,0,0,,ڕەگە چوار هەزار ساڵەکانی
Dialogue: 0,0:00:51.16,0:00:52.45,DirokVurgu,,0,0,0,,گەلی کوردن.
Dialogue: 0,0:00:52.48,0:00:54.00,Dirok,,0,0,0,,لە کەناڵی دیرۆک\Nسەبسکرایب بکەن
Dialogue: 0,0:00:54.03,0:00:55.80,Dirok,,0,0,0,,و درێژەی چیرۆکەکە\Nلەدەست مەدەن.
