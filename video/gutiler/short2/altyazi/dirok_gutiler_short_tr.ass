Dialogue: 0,0:00:00.40,0:00:02.05,Dirok,,0,0,0,,Dört bin iki yüz yıl önce,
Dialogue: 0,0:00:02.08,0:00:03.97,Dirok,,0,0,0,,Zagros dağlarından\Ninen bir halk
Dialogue: 0,0:00:04.00,0:00:05.61,Dirok,,0,0,0,,dünyanın ilk\Nimparatorluğunu
Dialogue: 0,0:00:05.64,0:00:06.25,Dirok,,0,0,0,,yıktı.
Dialogue: 0,0:00:06.28,0:00:08.45,Dirok,,0,0,0,,Sümerler onlara\Nkorkuyla Dağların
Dialogue: 0,0:00:08.48,0:00:09.77,DirokVurgu,,0,0,0,,Ejderhası dedi.
Dialogue: 0,0:00:09.80,0:00:11.33,Dirok,,0,0,0,,Bunlar Gutilerdi.
Dialogue: 0,0:00:11.36,0:00:12.61,Dirok,,0,0,0,,Akad İmparatorluğunu diz
Dialogue: 0,0:00:12.64,0:00:14.85,Dirok,,0,0,0,,çöktürdüler ve\NMezopotamyaya tam
Dialogue: 0,0:00:14.88,0:00:16.29,Dirok,,0,0,0,,yüz yıl hükmettiler.
Dialogue: 0,0:00:16.32,0:00:18.13,Dirok,,0,0,0,,Sümer Kral Listesi\Nonları şöyle
Dialogue: 0,0:00:18.16,0:00:19.81,Dirok,,0,0,0,,anlatır: Kendi\Nkendilerinin
Dialogue: 0,0:00:19.84,0:00:20.82,Dirok,,0,0,0,,kralıydılar.
Dialogue: 0,0:00:20.85,0:00:21.89,Dirok,,0,0,0,,Yirmi bir kral,
Dialogue: 0,0:00:21.92,0:00:24.33,Dirok,,0,0,0,,aşiret meclisi ve\Nyerel özerklik.
Dialogue: 0,0:00:24.36,0:00:26.29,DirokVurgu,,0,0,0,,Bu düzen binlerce\Nyıl sonra Kürt
Dialogue: 0,0:00:26.32,0:00:28.10,Dirok,,0,0,0,,toplumunda yaşamaya\Ndevam etti.
Dialogue: 0,0:00:28.13,0:00:30.25,Dirok,,0,0,0,,Gutium adı ise\Nhiç kaybolmadı.
Dialogue: 0,0:00:30.28,0:00:32.01,Dirok,,0,0,0,,Asur kayıtlarında Kurti,
Dialogue: 0,0:00:32.04,0:00:33.65,Dirok,,0,0,0,,Ksenofonda Kardukh,
Dialogue: 0,0:00:33.68,0:00:36.04,Dirok,,0,0,0,,Roma döneminde\NKorduene ve bugün
Dialogue: 0,0:00:36.08,0:00:36.77,DirokVurgu,,0,0,0,,Kürt.
Dialogue: 0,0:00:36.80,0:00:38.17,Dirok,,0,0,0,,Arşak Safrastian,
Dialogue: 0,0:00:38.20,0:00:39.13,Dirok,,0,0,0,,Godfrey Driver,
Dialogue: 0,0:00:39.16,0:00:41.30,Dirok,,0,0,0,,Ephraim Speiser\Nve Mehrdad İzady
Dialogue: 0,0:00:41.33,0:00:43.21,Dirok,,0,0,0,,gibi araştırmacılara\Ngöre Gutiler,
Dialogue: 0,0:00:43.24,0:00:44.57,DirokVurgu,,0,0,0,,Kürtlerin atalarıdır.
Dialogue: 0,0:00:44.60,0:00:46.21,Dirok,,0,0,0,,Hurriler, Mitanniler,
Dialogue: 0,0:00:46.24,0:00:48.01,Dirok,,0,0,0,,Lullubiler, Kassitler,
Dialogue: 0,0:00:48.04,0:00:49.45,Dirok,,0,0,0,,Medler ve Korduene:
Dialogue: 0,0:00:49.48,0:00:51.13,DirokVurgu,,0,0,0,,hepsi Kürt\Nhalkının dört bin
Dialogue: 0,0:00:51.16,0:00:52.45,Dirok,,0,0,0,,yıllık kökleridir.
Dialogue: 0,0:00:52.48,0:00:54.00,Dirok,,0,0,0,,Dîrok kanalına abone ol,
Dialogue: 0,0:00:54.03,0:00:55.80,Dirok,,0,0,0,,hikayenin\Ndevamını kaçırma.
