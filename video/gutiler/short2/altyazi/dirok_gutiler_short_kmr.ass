Dialogue: 0,0:00:00.40,0:00:02.05,Dirok,,0,0,0,,Çar hezar û du sed
Dialogue: 0,0:00:02.08,0:00:03.97,Dirok,,0,0,0,,sal berê, gelek\Nku ji çiyayên
Dialogue: 0,0:00:04.00,0:00:05.61,Dirok,,0,0,0,,Zagrosê dadiket yekem\Nîmparatoriya cîhanê
Dialogue: 0,0:00:05.64,0:00:06.25,Dirok,,0,0,0,,hilweşand.
Dialogue: 0,0:00:06.28,0:00:08.45,DirokVurgu,,0,0,0,,Sumeriyan bi tirs\Nnavê Ejdehayê Çiyayan
Dialogue: 0,0:00:08.48,0:00:09.77,Dirok,,0,0,0,,li wan kir.
Dialogue: 0,0:00:09.80,0:00:11.33,Dirok,,0,0,0,,Ev Gutî bûn.
Dialogue: 0,0:00:11.36,0:00:12.61,Dirok,,0,0,0,,Wan Împaratoriya Akadê çok
Dialogue: 0,0:00:12.64,0:00:14.85,Dirok,,0,0,0,,da û sed salên tam li
Dialogue: 0,0:00:14.88,0:00:16.29,Dirok,,0,0,0,,Mezopotamyayê hukim kirin.
Dialogue: 0,0:00:16.32,0:00:18.13,Dirok,,0,0,0,,Lîsteya Padîşahên\NSumerî wan wiha
Dialogue: 0,0:00:18.16,0:00:19.81,Dirok,,0,0,0,,vedibêje: Ew bi\Nxwe padîşahên
Dialogue: 0,0:00:19.84,0:00:20.82,Dirok,,0,0,0,,xwe bûn.
Dialogue: 0,0:00:20.85,0:00:21.89,Dirok,,0,0,0,,Bîst û yek
Dialogue: 0,0:00:21.92,0:00:24.33,Dirok,,0,0,0,,padîşah, meclîsa eşîran\Nû xweseriya herêmî.
Dialogue: 0,0:00:24.36,0:00:26.29,Dirok,,0,0,0,,Ev rêzik piştî\Nbi hezaran salan
Dialogue: 0,0:00:26.32,0:00:28.10,DirokVurgu,,0,0,0,,di civaka Kurdan\Nde dom kir.
Dialogue: 0,0:00:28.13,0:00:30.25,Dirok,,0,0,0,,Navê Gutiumê qet\Nwinda nebû. Di
Dialogue: 0,0:00:30.28,0:00:32.01,Dirok,,0,0,0,,qeydên Asûrî de Kurtî, li
Dialogue: 0,0:00:32.04,0:00:33.65,Dirok,,0,0,0,,cem Ksenofon Kardûx, di
Dialogue: 0,0:00:33.68,0:00:36.04,Dirok,,0,0,0,,serdema Romayê\Nde Korduene û îro
Dialogue: 0,0:00:36.08,0:00:36.77,DirokVurgu,,0,0,0,,Kurd.
Dialogue: 0,0:00:36.80,0:00:38.17,Dirok,,0,0,0,,Li gorî lêkolînerên
Dialogue: 0,0:00:38.20,0:00:39.13,Dirok,,0,0,0,,wek Arşak
Dialogue: 0,0:00:39.16,0:00:41.30,Dirok,,0,0,0,,Safrastian, Godfrey\NDriver, Ephraim Speiser
Dialogue: 0,0:00:41.33,0:00:43.21,Dirok,,0,0,0,,û Mehrdad Izady,\NGutî bav û
Dialogue: 0,0:00:43.24,0:00:44.57,DirokVurgu,,0,0,0,,kalên Kurdan in.
Dialogue: 0,0:00:44.60,0:00:46.21,Dirok,,0,0,0,,Hurrî, Mîtannî, Lullubî,
Dialogue: 0,0:00:46.24,0:00:48.01,Dirok,,0,0,0,,Kassît, Med û
Dialogue: 0,0:00:48.04,0:00:49.45,Dirok,,0,0,0,,Korduene: hemû kokên
Dialogue: 0,0:00:49.48,0:00:51.13,Dirok,,0,0,0,,çar hezar salî yên
Dialogue: 0,0:00:51.16,0:00:52.45,DirokVurgu,,0,0,0,,gelê Kurd in.
Dialogue: 0,0:00:52.48,0:00:54.00,Dirok,,0,0,0,,Li kanala Dîrokê\Nabone bibin
Dialogue: 0,0:00:54.03,0:00:55.80,Dirok,,0,0,0,,û dûmahiya çîrokê\Nji dest nedin.
