<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="120"/>
<pen id="2" b="1" fc="#FFD23A" fo="254" bc="#140804" bo="190" et="4" ec="#000000" fs="4" sz="125"/>
<wp id="1" ap="7" ah="50" av="80"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="400" d="1650" wp="1" ws="1"><s p="1">Dört bin iki yüz yıl önce,</s></p>
<p t="2080" d="1890" wp="1" ws="1"><s p="1">Zagros dağlarından
inen bir halk</s></p>
<p t="4000" d="1610" wp="1" ws="1"><s p="1">dünyanın ilk
imparatorluğunu</s></p>
<p t="5640" d="609" wp="1" ws="1"><s p="1">yıktı.</s></p>
<p t="6280" d="2170" wp="1" ws="1"><s p="1">Sümerler onlara
korkuyla Dağların</s></p>
<p t="8480" d="1290" wp="1" ws="1"><s p="2">Ejderhası dedi.</s></p>
<p t="9800" d="1530" wp="1" ws="1"><s p="1">Bunlar Gutilerdi.</s></p>
<p t="11360" d="1250" wp="1" ws="1"><s p="1">Akad İmparatorluğunu diz</s></p>
<p t="12640" d="2210" wp="1" ws="1"><s p="1">çöktürdüler ve
Mezopotamyaya tam</s></p>
<p t="14880" d="1409" wp="1" ws="1"><s p="1">yüz yıl hükmettiler.</s></p>
<p t="16320" d="1809" wp="1" ws="1"><s p="1">Sümer Kral Listesi
onları şöyle</s></p>
<p t="18160" d="1649" wp="1" ws="1"><s p="1">anlatır: Kendi
kendilerinin</s></p>
<p t="19840" d="982" wp="1" ws="1"><s p="1">kralıydılar.</s></p>
<p t="20852" d="1036" wp="1" ws="1"><s p="1">Yirmi bir kral,</s></p>
<p t="21919" d="2410" wp="1" ws="1"><s p="1">aşiret meclisi ve
yerel özerklik.</s></p>
<p t="24360" d="1929" wp="1" ws="1"><s p="2">Bu düzen binlerce
yıl sonra Kürt</s></p>
<p t="26320" d="1782" wp="1" ws="1"><s p="1">toplumunda yaşamaya
devam etti.</s></p>
<p t="28133" d="2116" wp="1" ws="1"><s p="1">Gutium adı ise
hiç kaybolmadı.</s></p>
<p t="30279" d="1730" wp="1" ws="1"><s p="1">Asur kayıtlarında Kurti,</s></p>
<p t="32040" d="1609" wp="1" ws="1"><s p="1">Ksenofonda Kardukh,</s></p>
<p t="33680" d="2359" wp="1" ws="1"><s p="1">Roma döneminde
Korduene ve bugün</s></p>
<p t="36080" d="689" wp="1" ws="1"><s p="2">Kürt.</s></p>
<p t="36800" d="1369" wp="1" ws="1"><s p="1">Arşak Safrastian,</s></p>
<p t="38199" d="929" wp="1" ws="1"><s p="1">Godfrey Driver,</s></p>
<p t="39160" d="2143" wp="1" ws="1"><s p="1">Ephraim Speiser
ve Mehrdad İzady</s></p>
<p t="41333" d="1877" wp="1" ws="1"><s p="1">gibi araştırmacılara
göre Gutiler,</s></p>
<p t="43240" d="1329" wp="1" ws="1"><s p="2">Kürtlerin atalarıdır.</s></p>
<p t="44600" d="1609" wp="1" ws="1"><s p="1">Hurriler, Mitanniler,</s></p>
<p t="46240" d="1769" wp="1" ws="1"><s p="1">Lullubiler, Kassitler,</s></p>
<p t="48040" d="1409" wp="1" ws="1"><s p="1">Medler ve Korduene:</s></p>
<p t="49480" d="1649" wp="1" ws="1"><s p="2">hepsi Kürt
halkının dört bin</s></p>
<p t="51160" d="1289" wp="1" ws="1"><s p="1">yıllık kökleridir.</s></p>
<p t="52480" d="1517" wp="1" ws="1"><s p="1">Dîrok kanalına abone ol,</s></p>
<p t="54027" d="1773" wp="1" ws="1"><s p="1">hikayenin
devamını kaçırma.</s></p>
</body>
</timedtext>
