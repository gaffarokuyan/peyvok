<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="120"/>
<pen id="2" b="1" fc="#FFD23A" fo="254" bc="#140804" bo="190" et="4" ec="#000000" fs="4" sz="125"/>
<wp id="1" ap="7" ah="50" av="80"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="400" d="1650" wp="1" ws="1"><s p="1">Çar hezar û du sed</s></p>
<p t="2080" d="1890" wp="1" ws="1"><s p="1">sal berê, gelek
ku ji çiyayên</s></p>
<p t="4000" d="1610" wp="1" ws="1"><s p="1">Zagrosê dadiket yekem
împaratoriya cîhanê</s></p>
<p t="5640" d="609" wp="1" ws="1"><s p="1">hilweşand.</s></p>
<p t="6280" d="2170" wp="1" ws="1"><s p="2">Sumeriyan bi tirs
navê Ejdehayê Çiyayan</s></p>
<p t="8480" d="1290" wp="1" ws="1"><s p="1">li wan kir.</s></p>
<p t="9800" d="1530" wp="1" ws="1"><s p="1">Ev Gutî bûn.</s></p>
<p t="11360" d="1250" wp="1" ws="1"><s p="1">Wan Împaratoriya Akadê çok</s></p>
<p t="12640" d="2210" wp="1" ws="1"><s p="1">da û sed salên tam li</s></p>
<p t="14880" d="1409" wp="1" ws="1"><s p="1">Mezopotamyayê hukim kirin.</s></p>
<p t="16320" d="1809" wp="1" ws="1"><s p="1">Lîsteya Padîşahên
Sumerî wan wiha</s></p>
<p t="18160" d="1649" wp="1" ws="1"><s p="1">vedibêje: Ew bi
xwe padîşahên</s></p>
<p t="19840" d="982" wp="1" ws="1"><s p="1">xwe bûn.</s></p>
<p t="20852" d="1036" wp="1" ws="1"><s p="1">Bîst û yek</s></p>
<p t="21919" d="2410" wp="1" ws="1"><s p="1">padîşah, meclîsa eşîran
û xweseriya herêmî.</s></p>
<p t="24360" d="1929" wp="1" ws="1"><s p="1">Ev rêzik piştî
bi hezaran salan</s></p>
<p t="26320" d="1782" wp="1" ws="1"><s p="2">di civaka Kurdan
de dom kir.</s></p>
<p t="28133" d="2116" wp="1" ws="1"><s p="1">Navê Gutiumê qet
winda nebû. Di</s></p>
<p t="30279" d="1730" wp="1" ws="1"><s p="1">qeydên Asûrî de Kurtî, li</s></p>
<p t="32040" d="1609" wp="1" ws="1"><s p="1">cem Ksenofon Kardûx, di</s></p>
<p t="33680" d="2359" wp="1" ws="1"><s p="1">serdema Romayê
de Korduene û îro</s></p>
<p t="36080" d="689" wp="1" ws="1"><s p="2">Kurd.</s></p>
<p t="36800" d="1369" wp="1" ws="1"><s p="1">Li gorî lêkolînerên</s></p>
<p t="38199" d="929" wp="1" ws="1"><s p="1">wek Arşak</s></p>
<p t="39160" d="2143" wp="1" ws="1"><s p="1">Safrastian, Godfrey
Driver, Ephraim Speiser</s></p>
<p t="41333" d="1877" wp="1" ws="1"><s p="1">û Mehrdad Izady,
Gutî bav û</s></p>
<p t="43240" d="1329" wp="1" ws="1"><s p="2">kalên Kurdan in.</s></p>
<p t="44600" d="1609" wp="1" ws="1"><s p="1">Hurrî, Mîtannî, Lullubî,</s></p>
<p t="46240" d="1769" wp="1" ws="1"><s p="1">Kassît, Med û</s></p>
<p t="48040" d="1409" wp="1" ws="1"><s p="1">Korduene: hemû kokên</s></p>
<p t="49480" d="1649" wp="1" ws="1"><s p="1">çar hezar salî yên</s></p>
<p t="51160" d="1289" wp="1" ws="1"><s p="2">gelê Kurd in.</s></p>
<p t="52480" d="1517" wp="1" ws="1"><s p="1">Li kanala Dîrokê
abone bibin</s></p>
<p t="54027" d="1773" wp="1" ws="1"><s p="1">û dûmahiya çîrokê
ji dest nedin.</s></p>
</body>
</timedtext>
