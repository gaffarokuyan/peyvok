<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="110"/>
<pen id="2" b="1" i="1" fc="#FFD65A" fo="254" bc="#140804" bo="190" et="4" ec="#000000" fs="4" sz="115"/>
<wp id="1" ap="7" ah="50" av="92"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="1140" d="3919" wp="1" ws="1"><s p="1">Dört bin iki yüz yıl önce
Mezopotamya'nın doğusundan bir halk tarih</s></p>
<p t="5100" d="1180" wp="1" ws="1"><s p="1">sahnesine çıktı:</s></p>
<p t="6480" d="939" wp="1" ws="1"><s p="1">Gutiler.</s></p>
<p t="7460" d="4240" wp="1" ws="1"><s p="1">Dünyanın ilk imparatorluğu Akad'ı
diz çöktürdüler ve medeniyetin beşiği</s></p>
<p t="11740" d="2620" wp="1" ws="1"><s p="1">Mezopotamya'ya tam bir asır hükmettiler.</s></p>
<p t="14440" d="2880" wp="1" ws="1"><s p="1">Sümer yazıcıları onlara
korkuyla bir ad verdi:</s></p>
<p t="17420" d="1559" wp="1" ws="1"><s p="1">Dağların Ejderhası.</s></p>
<p t="19080" d="1760" wp="1" ws="1"><s p="1">Peki kimdi bu Gutiler?</s></p>
<p t="20880" d="3960" wp="1" ws="1"><s p="1">Mezopotamya'yı nasıl yönettiler
ve neden pek çok tarihçi onları</s></p>
<p t="24880" d="2620" wp="1" ws="1"><s p="1">Kürtlerin en eski
ataları arasında sayıyor?</s></p>
<p t="27540" d="1540" wp="1" ws="1"><s p="1">Dîrok’a hoş geldiniz.</s></p>
<p t="41200" d="3720" wp="1" ws="1"><s p="1">Dicle ile Fırat arasındaki topraklar,
insanlık tarihinin en büyük</s></p>
<p t="44960" d="1579" wp="1" ws="1"><s p="1">icatlarına sahne oldu.</s></p>
<p t="46580" d="4239" wp="1" ws="1"><s p="1">İlk şehirler, yazı, tekerlek ve
yazılı kanunlar burada doğdu.</s></p>
<p t="50860" d="4759" wp="1" ws="1"><s p="1">Uruk, Ur, Lagaş ve Nippur gibi Sümer
şehirleri dünyanın ilk medeniyet</s></p>
<p t="55660" d="1059" wp="1" ws="1"><s p="1">merkezleriydi.</s></p>
<p t="56800" d="4219" wp="1" ws="1"><s p="1">Milattan önce yirmi üçüncü yüzyılda
Akadlı Sargon bu şehirleri tek tek</s></p>
<p t="61060" d="3519" wp="1" ws="1"><s p="1">fethetti ve tarihin bilinen
ilk imparatorluğunu kurdu.</s></p>
<p t="64620" d="3999" wp="1" ws="1"><s p="1">Akad İmparatorluğu Basra Körfezi'nden
Akdeniz'e kadar uzanıyordu.</s></p>
<p t="68660" d="4000" wp="1" ws="1"><s p="1">Sargon'un torunu Naram-Sin ise
kendine dünyanın dört bucağının kralı</s></p>
<p t="72700" d="1000" wp="1" ws="1"><s p="1">diyordu.</s></p>
<p t="73980" d="3819" wp="1" ws="1"><s p="1">Ama bu büyük imparatorluğun
sonu doğudan gelecekti.</s></p>
<p t="83220" d="4339" wp="1" ws="1"><s p="1">Mezopotamya kaynakları, Dicle Nehri'nin
doğusunda Küçük Zap ile Diyala</s></p>
<p t="87600" d="2419" wp="1" ws="1"><s p="1">nehirleri arasındaki ülkeye Gutium der.</s></p>
<p t="90060" d="4040" wp="1" ws="1"><s p="1">Burası Gutilerin yurduydu ve
Mezopotamya ovasına inen yollar onların</s></p>
<p t="94140" d="1019" wp="1" ws="1"><s p="1">kontrolündeydi.</s></p>
<p t="95200" d="4159" wp="1" ws="1"><s p="1">Naram-Sin'in oğlu Şar-kali-şarri
döneminde Akad ile Gutiler arasındaki</s></p>
<p t="99400" d="1260" wp="1" ws="1"><s p="1">mücadele kızıştı.</s></p>
<p t="100700" d="3479" wp="1" ws="1"><s p="1">Akad tabletlerinde yıllar o yıl
yaşanan önemli olaylara göre</s></p>
<p t="104220" d="999" wp="1" ws="1"><s p="1">adlandırılırdı.</s></p>
<p t="105260" d="2400" wp="1" ws="1"><s p="1">Bu yıl adlarından birinde şu kayıt geçer:</s></p>
<p t="107700" d="3899" wp="1" ws="1"><s p="2">"Şar-kali-şarri’nin Gutium
Kralı Şarlag’ı esir aldığı yıl."</s></p>
<p t="111740" d="2339" wp="1" ws="1"><s p="1">Ama Akad'ın zaferleri kalıcı olmadı.</s></p>
<p t="114120" d="4040" wp="1" ws="1"><s p="1">İmparatorluk isyanlarla, taht
kavgalarıyla ve büyük bir kuraklık</s></p>
<p t="118200" d="1299" wp="1" ws="1"><s p="1">dönemiyle sarsıldı.</s></p>
<p t="119540" d="4219" wp="1" ws="1"><s p="1">Şar-kali-şarri’nin ölümünden sonra
Akad öyle bir kaosa sürüklendi ki</s></p>
<p t="123800" d="3299" wp="1" ws="1"><s p="1">Sümer Kral Listesi bu dönemi
alaycı bir soruyla anlatır.</s></p>
<p t="127140" d="2199" wp="1" ws="1"><s p="2">"Kim kraldı, kim kral değildi?"</s></p>
<p t="129380" d="4080" wp="1" ws="1"><s p="2">"Agade'nin Laneti" adlı ünlü Sümer
metni Akad'ın çöküşünü tanrıların</s></p>
<p t="133500" d="4440" wp="1" ws="1"><s p="1">gazabına bağlar ve bu gazabı uygulamak
için gönderilen halk da bellidir.</s></p>
<p t="137980" d="680" wp="1" ws="1"><s p="1">Gutiler.</s></p>
<p t="138700" d="3400" wp="1" ws="1"><s p="1">Metin onları kontrol edilemeyen
bir halk olarak tarif eder.</s></p>
<p t="142140" d="4520" wp="1" ws="1"><s p="1">Milattan önce yaklaşık 2150
yılında Akad İmparatorluğu çöktü ve</s></p>
<p t="146700" d="3419" wp="1" ws="1"><s p="1">Mezopotamya'nın taht şehirleri
Gutilerin eline geçti.</s></p>
<p t="155540" d="2900" wp="1" ws="1"><s p="1">Sümer Kral Listesi'nde
apaçık bir kayıt vardır.</s></p>
<p t="158480" d="2320" wp="1" ws="1"><s p="2">"Krallık Gutium ordusuna geçti."</s></p>
<p t="161300" d="3340" wp="1" ws="1"><s p="1">Liste, Gutilerin ilk dönemini
ilginç bir cümleyle anlatır.</s></p>
<p t="164680" d="3300" wp="1" ws="1"><s p="2">"Gutium ordusunda başta
bilinen bir kral yoktu,</s></p>
<p t="168020" d="1840" wp="1" ws="1"><s p="1">kendi kendilerinin kralıydılar."</s></p>
<p t="170080" d="4180" wp="1" ws="1"><s p="1">Pek çok araştırmacı bu cümleyi
Gutilerin tek bir mutlak hükümdar yerine</s></p>
<p t="174300" d="3800" wp="1" ws="1"><s p="1">ortak bir meclisle ya da aşiret
liderleriyle yönetildiğinin işareti</s></p>
<p t="178140" d="1000" wp="1" ws="1"><s p="1">olarak yorumlar.</s></p>
<p t="179180" d="4320" wp="1" ws="1"><s p="1">Listeye göre yirmi bir Guti kralı
yaklaşık yüz yıl boyunca hüküm sürdü.</s></p>
<p t="183540" d="2939" wp="1" ws="1"><s p="1">Krallarının çoğu yalnızca
birkaç yıl tahtta kaldı.</s></p>
<p t="186520" d="2520" wp="1" ws="1"><s p="1">Bu da liderliğin babadan
oğula geçmediğini,</s></p>
<p t="189080" d="2780" wp="1" ws="1"><s p="1">aşiretler arasında el
değiştirdiğini düşündürür.</s></p>
<p t="192040" d="3680" wp="1" ws="1"><s p="1">Gutiler, Sümer şehirlerini yerel
valiler aracılığıyla yönetti.</s></p>
<p t="195760" d="4540" wp="1" ws="1"><s p="1">Umma şehrinin valisi Lugal-Annatum,
kendi yazıtını "Gutium Kralı Sium</s></p>
<p t="200340" d="1879" wp="1" ws="1"><s p="1">zamanında" diye tarihlendirir.</s></p>
<p t="202260" d="4140" wp="1" ws="1"><s p="1">Yani şehirler kendi yönetimlerini
korudu ama Guti kralının egemenliğini</s></p>
<p t="206440" d="539" wp="1" ws="1"><s p="1">tanıdı.</s></p>
<p t="207020" d="3460" wp="1" ws="1"><s p="1">Gutiler, Akad'ın yönetim dilini
ve geleneklerini de devraldı.</s></p>
<p t="210520" d="4520" wp="1" ws="1"><s p="1">Kral La’erabum’a ait bir topuz
başlığında Akadca olarak "Gutium'un güçlü</s></p>
<p t="215080" d="1140" wp="1" ws="1"><s p="1">kralı" yazar.</s></p>
<p t="216260" d="3080" wp="1" ws="1"><s p="1">Bu kralların en dikkat
çekicisi Erridupizir'dir.</s></p>
<p t="219380" d="4019" wp="1" ws="1"><s p="1">Mezopotamya'nın en kutsal şehri
Nippur'daki yazıtlarında kendisini şöyle</s></p>
<p t="223440" d="660" wp="1" ws="1"><s p="1">tanıtır:</s></p>
<p t="224140" d="3220" wp="1" ws="1"><s p="2">"Gutium'un kralı, dünyanın
dört bucağının kralı."</s></p>
<p t="227400" d="3619" wp="1" ws="1"><s p="1">Bu, Akad imparatorlarının
kullandığı unvanın ta kendisidir.</s></p>
<p t="231060" d="3600" wp="1" ws="1"><s p="1">Yazıtları, isyan eden bölgelere
karşı düzenlediği seferleri ve</s></p>
<p t="234700" d="3740" wp="1" ws="1"><s p="1">ganimetleri Tanrı Enlil'in
tapınağına nasıl adadığını anlatır.</s></p>
<p t="238500" d="3280" wp="1" ws="1"><s p="1">Guti döneminde Sümer şehirleri
de parlak bir dönem yaşadı.</s></p>
<p t="241820" d="4379" wp="1" ws="1"><s p="1">Lagaş, Prens Gudea yönetiminde
tapınaklar inşa etti ve sanatta altın</s></p>
<p t="246240" d="880" wp="1" ws="1"><s p="1">çağını yaşadı.</s></p>
<p t="247160" d="3299" wp="1" ws="1"><s p="1">Yani Gutiler yağmalayıp geri
çekilen akıncılar değildi.</s></p>
<p t="250500" d="3680" wp="1" ws="1"><s p="1">Mezopotamya'nın imparatorluk
mirasını devralan hükümdarlardı.</s></p>
<p t="254220" d="4400" wp="1" ws="1"><s p="1">Meclisle seçilen liderler, aşiret
konfederasyonu ve yerel özerklik...</s></p>
<p t="258820" d="4099" wp="1" ws="1"><s p="1">Bu tablo binlerce yıl sonra Kürt
toplumsal yapısında karşımıza çıkacak</s></p>
<p t="262960" d="1839" wp="1" ws="1"><s p="1">olan tablonun ta kendisidir.</s></p>
<p t="270220" d="2879" wp="1" ws="1"><s p="1">Yaklaşık yüz yıl sonra
Uruk Kralı Utu-hengal,</s></p>
<p t="273140" d="2499" wp="1" ws="1"><s p="1">Gutilere karşı büyük bir isyan başlattı.</s></p>
<p t="275680" d="2379" wp="1" ws="1"><s p="1">Zafer yazıtında Gutilerden şöyle bahseder:</s></p>
<p t="278100" d="3379" wp="1" ws="1"><s p="2">"Gutium, dağların zehirli dişli yılanı,</s></p>
<p t="281520" d="1639" wp="1" ws="1"><s p="1">dağların ejderhası."</s></p>
<p t="283380" d="2980" wp="1" ws="1"><s p="1">O sırada tahtta son Guti
kralı Tirigan vardı.</s></p>
<p t="286400" d="4060" wp="1" ws="1"><s p="1">Sümer Kral Listesi'ne göre Tirigan
yalnızca kırk gün hüküm sürebildi.</s></p>
<p t="290580" d="2279" wp="1" ws="1"><s p="1">Utu-hengal ordusuyla kuzeye yürüdü.</s></p>
<p t="292900" d="3279" wp="1" ws="1"><s p="1">Tirigan'ın gönderdiği iki
komutanı yendi ve esir aldı.</s></p>
<p t="296220" d="4119" wp="1" ws="1"><s p="1">Savaşın sonunda Tirigan ordusunu
bırakıp Dubrum adlı bir şehre kaçtı.</s></p>
<p t="300380" d="3840" wp="1" ws="1"><s p="1">Ancak Dubrum halkı onu yakaladı
ve Utu-hengal’e teslim etti.</s></p>
<p t="304280" d="4659" wp="1" ws="1"><s p="1">Kısa süre sonra Ur şehrinde Ur-Nammu
yeni bir hanedan kurdu ama mücadele</s></p>
<p t="308980" d="620" wp="1" ws="1"><s p="1">bitmedi.</s></p>
<p t="309640" d="3939" wp="1" ws="1"><s p="1">Bazı geç dönem Sümer metinlerine
göre Ur-Nammu bile Gutilere karşı</s></p>
<p t="313620" d="2199" wp="1" ws="1"><s p="1">yapılan bir savaşta hayatını kaybetti.</s></p>
<p t="315860" d="3579" wp="1" ws="1"><s p="1">Gutilerin Mezopotamya'daki
siyasi hakimiyeti sona ermişti.</s></p>
<p t="319480" d="1560" wp="1" ws="1"><s p="1">Ama Gutiler yok olmadı.</s></p>
<p t="326460" d="4119" wp="1" ws="1"><s p="1">Sonraki bin beş yüz yıl boyunca
Gutium adı Mezopotamya kaynaklarından</s></p>
<p t="330620" d="1120" wp="1" ws="1"><s p="1">hiç eksik olmadı.</s></p>
<p t="331780" d="3698" wp="1" ws="1"><s p="1">Babil Kralı Hammurabi, Gutium
ordusuna karşı kazandığı zaferleri</s></p>
<p t="335519" d="761" wp="1" ws="1"><s p="1">kaydetti.</s></p>
<p t="336320" d="3139" wp="1" ws="1"><s p="1">Asur kralları Qutu ülkesine
seferler düzenledi.</s></p>
<p t="339500" d="4479" wp="1" ws="1"><s p="1">Milattan önce 539'da Pers Kralı
Büyük Kiros Babil'i aldığında,</s></p>
<p t="344020" d="3739" wp="1" ws="1"><s p="1">Kiros Silindiri'nde egemenliği altına
aldığı ülkeler arasında Gutium'u</s></p>
<p t="347800" d="680" wp="1" ws="1"><s p="1">da saydı.</s></p>
<p t="348520" d="3679" wp="1" ws="1"><s p="1">Babil'e ilk giren komutan
ise Gutium valisi Ugbaru’ydu.</s></p>
<p t="352240" d="4000" wp="1" ws="1"><s p="1">Yani Gutium adı bin yedi yüz yıl
boyunca Mezopotamya'nın doğusundaki</s></p>
<p t="356280" d="1860" wp="1" ws="1"><s p="1">halkı tanımlamaya devam etti.</s></p>
<p t="363560" d="3179" wp="1" ws="1"><s p="1">Gutiler bu topraklarda yaşayan
tek kadim halk değildi.</s></p>
<p t="366780" d="4480" wp="1" ws="1"><s p="1">Lullubiler, Hurriler, Kassitler ve
Medler de Mezopotamya'nın kuzeyinde</s></p>
<p t="371300" d="1199" wp="1" ws="1"><s p="1">ve doğusunda yaşadı.</s></p>
<p t="372540" d="3999" wp="1" ws="1"><s p="1">Pek çok tarihçiye göre bu halklar
Gutilerle birlikte Kürtleri oluşturan</s></p>
<p t="376580" d="959" wp="1" ws="1"><s p="1">katmanlardır.</s></p>
<p t="377580" d="3759" wp="1" ws="1"><s p="1">Bu bağı en güçlü şekilde dile
getirenlerin başında yabancı tarihçiler</s></p>
<p t="381380" d="500" wp="1" ws="1"><s p="1">gelir.</s></p>
<p t="381920" d="3139" wp="1" ws="1"><s p="1">İngiltere'de çalışan
Şarkiyatçı Arşak Safrastian,</s></p>
<p t="385100" d="4839" wp="1" ws="1"><s p="1">1948'de yayımlanan kitabında Gutileri
doğrudan Kürtlerin ataları olarak</s></p>
<p t="389980" d="3819" wp="1" ws="1"><s p="1">görür ve Guti adı ile Kürt
adının kökü arasında bağ kurar.</s></p>
<p t="393840" d="2439" wp="1" ws="1"><s p="1">İsim zinciri gerçekten dikkat çekicidir.</s></p>
<p t="396320" d="4240" wp="1" ws="1"><s p="1">Asur kayıtlarında bu bölgenin halkları
için Qurti ve Kurti gibi adlar</s></p>
<p t="400600" d="539" wp="1" ws="1"><s p="1">geçer.</s></p>
<p t="401180" d="3819" wp="1" ws="1"><s p="1">Yunan komutan Ksenofon, Dicle
Nehri'nin kuzeyinde yaşayan savaşçı</s></p>
<p t="405040" d="1439" wp="1" ws="1"><s p="1">Kardukhlardan bahseder.</s></p>
<p t="406520" d="3320" wp="1" ws="1"><s p="1">Roma döneminde aynı bölge
Korduene adıyla anılır.</s></p>
<p t="410420" d="1839" wp="1" ws="1"><s p="1">Oxford Üniversitesi'nden G.R.</s></p>
<p t="412300" d="3740" wp="1" ws="1"><s p="1">Driver, Kürt adının bu kadim
isimlerle ilişkisini inceledi.</s></p>
<p t="416120" d="4199" wp="1" ws="1"><s p="1">Vladimir Minorsky, Medlerin Kürtlerin
oluşumundaki rolünü vurguladı.</s></p>
<p t="420420" d="4219" wp="1" ws="1"><s p="1">Ephraim Speiser, Gutileri Mezopotamya'nın
doğusunun yerli halkı olarak</s></p>
<p t="424680" d="839" wp="1" ws="1"><s p="1">tanımladı.</s></p>
<p t="425560" d="3979" wp="1" ws="1"><s p="1">Mehrdad İzady ise Gutilerin ve
diğer kadim halkların Kürt halkının</s></p>
<p t="429580" d="1720" wp="1" ws="1"><s p="1">temelini oluşturduğunu savunur.</s></p>
<p t="431340" d="3379" wp="1" ws="1"><s p="1">Kürt tarihçi Muhammed Emin
Zeki Beg de aynı görüştedir.</s></p>
<p t="435120" d="2019" wp="1" ws="1"><s p="1">Elbette karşıt görüşler de vardır.</s></p>
<p t="437180" d="4199" wp="1" ws="1"><s p="1">Bunun temel nedeni Gutilerin dilinden
günümüze çok az belge kalmasıdır.</s></p>
<p t="441420" d="2560" wp="1" ws="1"><s p="1">Elimizde yalnızca birkaç kral adı vardır.</s></p>
<p t="444120" d="4699" wp="1" ws="1"><s p="1">Ancak coğrafya, toplumsal yapı ve
isimlerin binlerce yıllık sürekliliği</s></p>
<p t="448860" d="1439" wp="1" ws="1"><s p="1">bu tezi güçlü kılıyor.</s></p>
<p t="451520" d="3439" wp="1" ws="1"><s p="1">Mezopotamya'nın ovaları
zengindi ama savunmasızdı.</s></p>
<p t="455000" d="2800" wp="1" ws="1"><s p="1">İmparatorluklar geldi, şehirler yakıldı.</s></p>
<p t="457859" d="4139" wp="1" ws="1"><s p="1">On üçüncü yüzyılda Moğollar Bağdat'ı
ve bütün Mezopotamya'yı yerle bir</s></p>
<p t="462039" d="500" wp="1" ws="1"><s p="1">etti.</s></p>
<p t="462580" d="4139" wp="1" ws="1"><s p="1">Ama dağların sağladığı stratejik
avantaj sayesinde Kürtler bu yıkımdan</s></p>
<p t="466760" d="2060" wp="1" ws="1"><s p="1">ovadaki halklar kadar etkilenmedi.</s></p>
<p t="468900" d="1960" wp="1" ws="1"><s p="1">Kürtlerin kadim bir sözü vardır:</s></p>
<p t="471159" d="3644" wp="1" ws="1"><s p="2">Ji çiyan pê ve, hevalên me tune.</s></p>
<p t="475003" d="1960" wp="1" ws="1"><s p="1">Dağlardan başka dostumuz yok.</s></p>
<p t="477203" d="4200" wp="1" ws="1"><s p="1">Gutiler, Mezopotamya'nın ilk
imparatorluğunu yıkan ve onun mirasını</s></p>
<p t="481443" d="1079" wp="1" ws="1"><s p="1">devralan halktı.</s></p>
<p t="482563" d="4120" wp="1" ws="1"><s p="1">Kürt tarihinin ilk sayfalarından
biri işte bu topraklarda yazıldı.</s></p>
<p t="486984" d="3779" wp="1" ws="1"><s p="1">Bu videoyu beğendiyseniz abone
olmayı ve görüşlerinizi yorumlarda</s></p>
<p t="490804" d="1379" wp="1" ws="1"><s p="1">paylaşmayı unutmayın.</s></p>
</body>
</timedtext>
