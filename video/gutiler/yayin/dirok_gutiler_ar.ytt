<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="110"/>
<pen id="2" b="1" i="1" fc="#FFD65A" fo="254" bc="#140804" bo="190" et="4" ec="#000000" fs="4" sz="115"/>
<wp id="1" ap="7" ah="50" av="92"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="1140" d="3919" wp="1" ws="1"><s p="1">قبل أربعة آلاف ومئتي عام،
ظهر على مسرح التاريخ شعبٌ من</s></p>
<p t="5100" d="1180" wp="1" ws="1"><s p="1">شرق بلاد الرافدين:</s></p>
<p t="6480" d="939" wp="1" ws="1"><s p="1">الغوتيون.</s></p>
<p t="7460" d="4240" wp="1" ws="1"><s p="1">أخضعوا أكد، أول إمبراطورية
في العالم، وحكموا بلاد</s></p>
<p t="11740" d="2620" wp="1" ws="1"><s p="1">الرافدين، مهد الحضارة، قرنًا كاملًا.</s></p>
<p t="14440" d="2880" wp="1" ws="1"><s p="1">وأطلق عليهم الكتبة السومريون اسمًا يملؤه</s></p>
<p t="17420" d="1559" wp="1" ws="1"><s p="1">الخوف: تنين الجبال.</s></p>
<p t="19080" d="1760" wp="1" ws="1"><s p="1">فمن هم هؤلاء الغوتيون؟</s></p>
<p t="20880" d="3960" wp="1" ws="1"><s p="1">كيف حكموا بلاد الرافدين،
ولماذا يعدّهم كثير من</s></p>
<p t="24880" d="2620" wp="1" ws="1"><s p="1">المؤرخين من أقدم أجداد الكرد؟</s></p>
<p t="27540" d="1540" wp="1" ws="1"><s p="1">أهلًا بكم في ديروك.</s></p>
<p t="41200" d="3720" wp="1" ws="1"><s p="1">شهدت الأرض الواقعة بين دجلة والفرات أعظم</s></p>
<p t="44960" d="1579" wp="1" ws="1"><s p="1">اختراعات التاريخ البشري.</s></p>
<p t="46580" d="4239" wp="1" ws="1"><s p="1">هنا وُلدت أولى المدن والكتابة
والعجلة والقوانين المكتوبة.</s></p>
<p t="50860" d="4759" wp="1" ws="1"><s p="1">كانت المدن السومرية مثل أوروك وأور
ولكش ونيبور أولى مراكز الحضارة</s></p>
<p t="55660" d="1059" wp="1" ws="1"><s p="1">في العالم.</s></p>
<p t="56800" d="4219" wp="1" ws="1"><s p="1">وفي القرن الثالث والعشرين قبل
الميلاد فتح سرجون الأكدي هذه المدن</s></p>
<p t="61060" d="3519" wp="1" ws="1"><s p="1">واحدةً تلو الأخرى، وأسس أول
إمبراطورية معروفة في التاريخ.</s></p>
<p t="64620" d="3999" wp="1" ws="1"><s p="1">امتدت الإمبراطورية الأكدية
من الخليج إلى البحر المتوسط.</s></p>
<p t="68660" d="4000" wp="1" ws="1"><s p="1">أما حفيد سرجون، نارام سين،
فقد لقّب نفسه بملك جهات العالم</s></p>
<p t="72700" d="1000" wp="1" ws="1"><s p="1">الأربع.</s></p>
<p t="73980" d="3819" wp="1" ws="1"><s p="1">لكن نهاية هذه الإمبراطورية
العظيمة كانت ستأتي من الشرق.</s></p>
<p t="83220" d="4339" wp="1" ws="1"><s p="1">تسمّي مصادر بلاد الرافدين البلادَ
الواقعة شرق دجلة، بين نهري</s></p>
<p t="87600" d="2419" wp="1" ws="1"><s p="1">الزاب الصغير وديالى، باسم غوتيوم.</s></p>
<p t="90060" d="4040" wp="1" ws="1"><s p="1">كانت هذه موطن الغوتيين، وكانت
الطرق النازلة إلى سهل الرافدين</s></p>
<p t="94140" d="1019" wp="1" ws="1"><s p="1">تحت سيطرتهم.</s></p>
<p t="95200" d="4159" wp="1" ws="1"><s p="1">وفي عهد شار كالي شاري، ابن
نارام سين، احتدم الصراع</s></p>
<p t="99400" d="1260" wp="1" ws="1"><s p="1">بين أكد والغوتيين.</s></p>
<p t="100700" d="3479" wp="1" ws="1"><s p="1">في الألواح الأكدية كانت السنوات
تُسمّى بأهم الأحداث التي</s></p>
<p t="104220" d="999" wp="1" ws="1"><s p="1">وقعت فيها.</s></p>
<p t="105260" d="2400" wp="1" ws="1"><s p="1">وفي أحد أسماء هذه السنوات نقرأ: "السنة</s></p>
<p t="107700" d="3899" wp="1" ws="1"><s p="2">التي أسر فيها شار كالي
شاري شارلاك، ملك غوتيوم."</s></p>
<p t="111740" d="2339" wp="1" ws="1"><s p="1">لكن انتصارات أكد لم تدم.</s></p>
<p t="114120" d="4040" wp="1" ws="1"><s p="1">فقد هزّت الإمبراطوريةَ الثوراتُ
والصراعات على العرش وموجةُ</s></p>
<p t="118200" d="1299" wp="1" ws="1"><s p="1">جفاف كبيرة.</s></p>
<p t="119540" d="4219" wp="1" ws="1"><s p="1">وبعد موت شار كالي شاري
غرقت أكد في فوضى جعلت</s></p>
<p t="123800" d="3299" wp="1" ws="1"><s p="1">قائمة الملوك السومرية تصف
تلك الفترة بسؤال ساخر.</s></p>
<p t="127140" d="2199" wp="1" ws="1"><s p="2">"من كان الملك، ومن لم يكن الملك؟"</s></p>
<p t="129380" d="4080" wp="1" ws="1"><s p="2">ويربط النص السومري الشهير
"لعنة أكد" سقوطَ أكد</s></p>
<p t="133500" d="4440" wp="1" ws="1"><s p="1">بغضب الآلهة، والشعب الذي
أُرسل لتنفيذ هذا الغضب معروف.</s></p>
<p t="137980" d="680" wp="1" ws="1"><s p="1">الغوتيون.</s></p>
<p t="138700" d="3400" wp="1" ws="1"><s p="1">يصفهم النص بأنهم شعب لا يمكن السيطرة عليه.</s></p>
<p t="142140" d="4520" wp="1" ws="1"><s p="1">وفي نحو عام 2150 قبل الميلاد
انهارت الإمبراطورية الأكدية،</s></p>
<p t="146700" d="3419" wp="1" ws="1"><s p="1">وانتقلت عواصم بلاد
الرافدين إلى أيدي الغوتيين.</s></p>
<p t="155540" d="2900" wp="1" ws="1"><s p="1">وفي قائمة الملوك السومرية سجلٌّ صريح.</s></p>
<p t="158480" d="2320" wp="1" ws="1"><s p="2">"انتقلت الملكية إلى جيش غوتيوم."</s></p>
<p t="161300" d="3340" wp="1" ws="1"><s p="1">وتصف القائمة المرحلة الأولى
من حكم الغوتيين بعبارة لافتة.</s></p>
<p t="164680" d="3300" wp="1" ws="1"><s p="2">"في جيش غوتيوم لم يكن في البداية</s></p>
<p t="168020" d="1840" wp="1" ws="1"><s p="1">ملكٌ معروف، كانوا ملوكَ أنفسهم."</s></p>
<p t="170080" d="4180" wp="1" ws="1"><s p="1">ويفسّر كثير من الباحثين هذه
العبارة دليلًا على أن الغوتيين</s></p>
<p t="174300" d="3800" wp="1" ws="1"><s p="1">لم يحكمهم حاكم مطلق
واحد، بل مجلسٌ مشترك أو</s></p>
<p t="178140" d="1000" wp="1" ws="1"><s p="1">زعماء عشائر.</s></p>
<p t="179180" d="4320" wp="1" ws="1"><s p="1">وبحسب القائمة حكم واحد وعشرون
ملكًا غوتيًا نحو مئة عام.</s></p>
<p t="183540" d="2939" wp="1" ws="1"><s p="1">ولم يبقَ معظم ملوكهم
على العرش سوى بضع سنوات.</s></p>
<p t="186520" d="2520" wp="1" ws="1"><s p="1">وهذا يوحي بأن الزعامة لم تكن تنتقل</s></p>
<p t="189080" d="2780" wp="1" ws="1"><s p="1">من الأب إلى الابن، بل
كانت تتداولها العشائر.</s></p>
<p t="192040" d="3680" wp="1" ws="1"><s p="1">حكم الغوتيون المدن
السومرية عبر ولاة محليين.</s></p>
<p t="195760" d="4540" wp="1" ws="1"><s p="1">فوالي مدينة أوما، لوكال
أناتوم، أرّخ نقشه بعبارة "في</s></p>
<p t="200340" d="1879" wp="1" ws="1"><s p="1">زمن سيئوم ملك غوتيوم".</s></p>
<p t="202260" d="4140" wp="1" ws="1"><s p="1">أي أن المدن حافظت على إداراتها
الخاصة لكنها اعترفت بسيادة الملك</s></p>
<p t="206440" d="539" wp="1" ws="1"><s p="1">الغوتي.</s></p>
<p t="207020" d="3460" wp="1" ws="1"><s p="1">كما ورث الغوتيون لغة
الحكم الأكدية وتقاليدها.</s></p>
<p t="210520" d="4520" wp="1" ws="1"><s p="1">وعلى رأس صولجان يعود إلى الملك
لاعرابوم نقرأ بالأكدية: "ملك</s></p>
<p t="215080" d="1140" wp="1" ws="1"><s p="1">غوتيوم القوي".</s></p>
<p t="216260" d="3080" wp="1" ws="1"><s p="1">وأبرز هؤلاء الملوك هو إريدوبيزير.</s></p>
<p t="219380" d="4019" wp="1" ws="1"><s p="1">ففي نقوشه في نيبور، أقدس
مدن بلاد الرافدين، يقدّم</s></p>
<p t="223440" d="660" wp="1" ws="1"><s p="1">نفسه هكذا:</s></p>
<p t="224140" d="3220" wp="1" ws="1"><s p="2">"ملك غوتيوم، ملك جهات العالم الأربع."</s></p>
<p t="227400" d="3619" wp="1" ws="1"><s p="1">وهذا هو اللقب نفسه الذي
استخدمه الأباطرة الأكديون.</s></p>
<p t="231060" d="3600" wp="1" ws="1"><s p="1">وتروي نقوشه حملاته على المناطق المتمردة،</s></p>
<p t="234700" d="3740" wp="1" ws="1"><s p="1">وكيف أهدى الغنائم إلى معبد الإله إنليل.</s></p>
<p t="238500" d="3280" wp="1" ws="1"><s p="1">وفي العهد الغوتي عاشت المدن
السومرية أيضًا عصرًا مزدهرًا.</s></p>
<p t="241820" d="4379" wp="1" ws="1"><s p="1">فقد بنت لكش المعابد في عهد
الأمير كوديا، وعاشت عصرها الذهبي</s></p>
<p t="246240" d="880" wp="1" ws="1"><s p="1">في الفن.</s></p>
<p t="247160" d="3299" wp="1" ws="1"><s p="1">إذن لم يكن الغوتيون
غزاةً ينهبون ثم ينسحبون.</s></p>
<p t="250500" d="3680" wp="1" ws="1"><s p="1">بل كانوا حكامًا ورثوا التراث
الإمبراطوري لبلاد الرافدين.</s></p>
<p t="254220" d="4400" wp="1" ws="1"><s p="1">زعماء يختارهم مجلس، واتحاد
عشائري، واستقلال محلي...</s></p>
<p t="258820" d="4099" wp="1" ws="1"><s p="1">هذه هي الصورة نفسها التي
سنراها بعد آلاف السنين</s></p>
<p t="262960" d="1839" wp="1" ws="1"><s p="1">في البنية الاجتماعية للكرد.</s></p>
<p t="270220" d="2879" wp="1" ws="1"><s p="1">وبعد نحو مئة عام أطلق أوتو حيكال،</s></p>
<p t="273140" d="2499" wp="1" ws="1"><s p="1">ملك أوروك، ثورة كبرى على الغوتيين.</s></p>
<p t="275680" d="2379" wp="1" ws="1"><s p="1">ويذكر الغوتيين في نقش انتصاره</s></p>
<p t="278100" d="3379" wp="1" ws="1"><s p="2">هكذا: "غوتيوم، أفعى الجبال ذات</s></p>
<p t="281520" d="1639" wp="1" ws="1"><s p="1">الأنياب، تنين الجبال."</s></p>
<p t="283380" d="2980" wp="1" ws="1"><s p="1">وكان على العرش آنذاك آخر
ملوك الغوتيين، تيريغان.</s></p>
<p t="286400" d="4060" wp="1" ws="1"><s p="1">وبحسب قائمة الملوك السومرية لم
يحكم تيريغان سوى أربعين يومًا.</s></p>
<p t="290580" d="2279" wp="1" ws="1"><s p="1">زحف أوتو حيكال بجيشه شمالًا.</s></p>
<p t="292900" d="3279" wp="1" ws="1"><s p="1">وهزم القائدين اللذين
أرسلهما تيريغان وأسرهما.</s></p>
<p t="296220" d="4119" wp="1" ws="1"><s p="1">وفي نهاية الحرب ترك تيريغان جيشه
وفرّ إلى مدينة تُدعى دوبروم.</s></p>
<p t="300380" d="3840" wp="1" ws="1"><s p="1">لكن أهل دوبروم قبضوا عليه
وسلّموه إلى أوتو حيكال.</s></p>
<p t="304280" d="4659" wp="1" ws="1"><s p="1">وبعد وقت قصير أسس أور نمو سلالة
جديدة في مدينة أور، لكن الصراع لم</s></p>
<p t="308980" d="620" wp="1" ws="1"><s p="1">ينتهِ.</s></p>
<p t="309640" d="3939" wp="1" ws="1"><s p="1">فبحسب بعض النصوص السومرية
المتأخرة، لقي أور نمو نفسه</s></p>
<p t="313620" d="2199" wp="1" ws="1"><s p="1">حتفه في معركة ضد الغوتيين.</s></p>
<p t="315860" d="3579" wp="1" ws="1"><s p="1">لقد انتهت السيطرة السياسية
للغوتيين على بلاد الرافدين.</s></p>
<p t="319480" d="1560" wp="1" ws="1"><s p="1">لكن الغوتيين لم يختفوا.</s></p>
<p t="326460" d="4119" wp="1" ws="1"><s p="1">فطوال ألف وخمسمئة عام
تالية لم يغب اسم غوتيوم عن</s></p>
<p t="330620" d="1120" wp="1" ws="1"><s p="1">مصادر بلاد الرافدين.</s></p>
<p t="331780" d="3698" wp="1" ws="1"><s p="1">سجّل حمورابي، ملك بابل، انتصاراته على جيش</s></p>
<p t="335519" d="761" wp="1" ws="1"><s p="1">غوتيوم.</s></p>
<p t="336320" d="3139" wp="1" ws="1"><s p="1">وشنّ ملوك آشور حملات على بلاد قوتو.</s></p>
<p t="339500" d="4479" wp="1" ws="1"><s p="1">وعندما استولى الملك الفارسي
كورش الكبير على بابل عام</s></p>
<p t="344020" d="3739" wp="1" ws="1"><s p="1">539 قبل الميلاد، عدّ غوتيوم في
أسطوانة كورش بين البلاد الخاضعة</s></p>
<p t="347800" d="680" wp="1" ws="1"><s p="1">لحكمه.</s></p>
<p t="348520" d="3679" wp="1" ws="1"><s p="1">وكان أول قائد دخل بابل
هو أوغبارو، والي غوتيوم.</s></p>
<p t="352240" d="4000" wp="1" ws="1"><s p="1">أي أن اسم غوتيوم ظل طوال
ألف وسبعمئة عام يدلّ على</s></p>
<p t="356280" d="1860" wp="1" ws="1"><s p="1">الشعب الساكن شرق بلاد الرافدين.</s></p>
<p t="363560" d="3179" wp="1" ws="1"><s p="1">لم يكن الغوتيون الشعب
القديم الوحيد في هذه الأرض.</s></p>
<p t="366780" d="4480" wp="1" ws="1"><s p="1">فقد عاش اللولوبيون والحوريون
والكاشيون والميديون أيضًا في شمال</s></p>
<p t="371300" d="1199" wp="1" ws="1"><s p="1">بلاد الرافدين وشرقها.</s></p>
<p t="372540" d="3999" wp="1" ws="1"><s p="1">وبحسب كثير من المؤرخين فإن هذه الشعوب،
مع الغوتيين، هي الطبقات التي تكوّن</s></p>
<p t="376580" d="959" wp="1" ws="1"><s p="1">منها الكرد.</s></p>
<p t="377580" d="3759" wp="1" ws="1"><s p="1">وفي مقدمة من عبّروا عن هذه
الصلة بأقوى صورة يأتي المؤرخون</s></p>
<p t="381380" d="500" wp="1" ws="1"><s p="1">الأجانب.</s></p>
<p t="381920" d="3139" wp="1" ws="1"><s p="1">فالمستشرق أرشاك سافراستيان،
الذي عمل في إنكلترا،</s></p>
<p t="385100" d="4839" wp="1" ws="1"><s p="1">يرى في كتابه الصادر عام 1948
أن الغوتيين هم أجداد الكرد</s></p>
<p t="389980" d="3819" wp="1" ws="1"><s p="1">مباشرة، ويربط بين اسم غوتي وجذر اسم الكرد.</s></p>
<p t="393840" d="2439" wp="1" ws="1"><s p="1">وسلسلة الأسماء لافتة حقًا.</s></p>
<p t="396320" d="4240" wp="1" ws="1"><s p="1">ففي السجلات الآشورية ترد أسماء
مثل قورتي وكورتي لشعوب هذه</s></p>
<p t="400600" d="539" wp="1" ws="1"><s p="1">المنطقة.</s></p>
<p t="401180" d="3819" wp="1" ws="1"><s p="1">ويتحدث القائد اليوناني زينوفون
عن الكاردوخيين المحاربين الذين</s></p>
<p t="405040" d="1439" wp="1" ws="1"><s p="1">عاشوا شمال دجلة.</s></p>
<p t="406520" d="3320" wp="1" ws="1"><s p="1">وفي العهد الروماني عُرفت
المنطقة نفسها باسم كوردوين.</s></p>
<p t="410420" d="1839" wp="1" ws="1"><s p="1">ودرس ج. ر. درايفر</s></p>
<p t="412300" d="3740" wp="1" ws="1"><s p="1">من جامعة أكسفورد صلة اسم
الكرد بهذه الأسماء القديمة.</s></p>
<p t="416120" d="4199" wp="1" ws="1"><s p="1">وأكّد فلاديمير مينورسكي دور
الميديين في تكوّن الكرد.</s></p>
<p t="420420" d="4219" wp="1" ws="1"><s p="1">ووصف إفرايم سبايزر الغوتيين
بأنهم السكان الأصليون لشرق بلاد</s></p>
<p t="424680" d="839" wp="1" ws="1"><s p="1">الرافدين.</s></p>
<p t="425560" d="3979" wp="1" ws="1"><s p="1">أما مهرداد إزادي فيرى أن
الغوتيين والشعوب القديمة الأخرى</s></p>
<p t="429580" d="1720" wp="1" ws="1"><s p="1">يشكّلون أساس الشعب الكردي.</s></p>
<p t="431340" d="3379" wp="1" ws="1"><s p="1">ويتبنى المؤرخ الكردي محمد
أمين زكي بك الرأي نفسه.</s></p>
<p t="435120" d="2019" wp="1" ws="1"><s p="1">وبالطبع هناك آراء معارضة أيضًا.</s></p>
<p t="437180" d="4199" wp="1" ws="1"><s p="1">والسبب الرئيسي أن ما بقي من
وثائق بلغة الغوتيين قليل جدًا.</s></p>
<p t="441420" d="2560" wp="1" ws="1"><s p="1">فكل ما بين أيدينا بضعة أسماء ملوك.</s></p>
<p t="444120" d="4699" wp="1" ws="1"><s p="1">لكن الجغرافيا والبنية الاجتماعية
واستمرار الأسماء آلاف السنين تجعل</s></p>
<p t="448860" d="1439" wp="1" ws="1"><s p="1">هذه الأطروحة قوية.</s></p>
<p t="451520" d="3439" wp="1" ws="1"><s p="1">كانت سهول بلاد الرافدين
غنية لكنها بلا حماية.</s></p>
<p t="455000" d="2800" wp="1" ws="1"><s p="1">جاءت الإمبراطوريات وأُحرقت المدن.</s></p>
<p t="457859" d="4139" wp="1" ws="1"><s p="1">وفي القرن الثالث عشر دمّر
المغول بغداد وبلاد الرافدين</s></p>
<p t="462039" d="500" wp="1" ws="1"><s p="1">كلها.</s></p>
<p t="462580" d="4139" wp="1" ws="1"><s p="1">لكن بفضل الميزة الاستراتيجية التي
وفّرتها الجبال، لم يتأثر الكرد</s></p>
<p t="466760" d="2060" wp="1" ws="1"><s p="1">بهذا الدمار بقدر شعوب السهول.</s></p>
<p t="468900" d="1960" wp="1" ws="1"><s p="1">للكرد قولٌ قديم: Ji çiyan</s></p>
<p t="471159" d="3644" wp="1" ws="1"><s p="2">pê ve, hevalên me tune.</s></p>
<p t="475003" d="1960" wp="1" ws="1"><s p="1">لا أصدقاء لنا سوى الجبال.</s></p>
<p t="477203" d="4200" wp="1" ws="1"><s p="1">كان الغوتيون الشعب الذي أسقط
أول إمبراطورية في بلاد الرافدين</s></p>
<p t="481443" d="1079" wp="1" ws="1"><s p="1">وورث تراثها.</s></p>
<p t="482563" d="4120" wp="1" ws="1"><s p="1">وهنا، في هذه الأرض، كُتبت واحدة
من أولى صفحات التاريخ الكردي.</s></p>
<p t="486984" d="3779" wp="1" ws="1"><s p="1">إن أعجبكم هذا الفيديو فلا
تنسوا الاشتراك ومشاركة</s></p>
<p t="490804" d="1379" wp="1" ws="1"><s p="1">آرائكم في التعليقات.</s></p>
</body>
</timedtext>
