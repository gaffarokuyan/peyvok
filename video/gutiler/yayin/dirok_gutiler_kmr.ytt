<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="110"/>
<pen id="2" b="1" i="1" fc="#FFD65A" fo="254" bc="#140804" bo="190" et="4" ec="#000000" fs="4" sz="115"/>
<wp id="1" ap="7" ah="50" av="92"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="1140" d="3919" wp="1" ws="1"><s p="1">Çar hezar û du sed sal berê, gelek
ji rojhilatê Mezopotamyayê derket</s></p>
<p t="5100" d="1180" wp="1" ws="1"><s p="1">ser sehneya dîrokê:</s></p>
<p t="6480" d="939" wp="1" ws="1"><s p="1">Gutî.</s></p>
<p t="7460" d="4240" wp="1" ws="1"><s p="1">Wan Akad, yekem împaratoriya
cîhanê, çok da û sedsalek tam</s></p>
<p t="11740" d="2620" wp="1" ws="1"><s p="1">li Mezopotamyayê, landika
şaristaniyê, hukim kirin.</s></p>
<p t="14440" d="2880" wp="1" ws="1"><s p="1">Nivîskarên Sumerî bi tirs navek li wan</s></p>
<p t="17420" d="1559" wp="1" ws="1"><s p="1">kirin: Ejdehayê Çiyayan.</s></p>
<p t="19080" d="1760" wp="1" ws="1"><s p="1">Gelo ev Gutî kî bûn?</s></p>
<p t="20880" d="3960" wp="1" ws="1"><s p="1">Wan çawa Mezopotamya bi rê ve
bir û çima gelek dîroknas wan</s></p>
<p t="24880" d="2620" wp="1" ws="1"><s p="1">di nav kevintirîn bav û
kalên Kurdan de dihesibînin?</s></p>
<p t="27540" d="1540" wp="1" ws="1"><s p="1">Hûn bi xêr hatin Dîrokê.</s></p>
<p t="41200" d="3720" wp="1" ws="1"><s p="1">Axa di navbera Dicle û Firatê
de bû sehneya mezintirîn</s></p>
<p t="44960" d="1579" wp="1" ws="1"><s p="1">dahênanên dîroka mirovahiyê.</s></p>
<p t="46580" d="4239" wp="1" ws="1"><s p="1">Yekem bajar, nivîs, teker û
qanûnên nivîskî li vir çêbûn.</s></p>
<p t="50860" d="4759" wp="1" ws="1"><s p="1">Bajarên Sumerî yên wek Uruk, Ur, Lagaş
û Nippur yekem navendên şaristaniyê</s></p>
<p t="55660" d="1059" wp="1" ws="1"><s p="1">yên cîhanê bûn.</s></p>
<p t="56800" d="4219" wp="1" ws="1"><s p="1">Di sedsala bîst û sêyemîn a berî zayînê
de, Sargonê Akadî ev bajar yek bi</s></p>
<p t="61060" d="3519" wp="1" ws="1"><s p="1">yek zeft kirin û yekem împaratoriya
naskirî ya dîrokê ava kir.</s></p>
<p t="64620" d="3999" wp="1" ws="1"><s p="1">Împaratoriya Akadê ji Kendava
Besrayê heta Deryaya Spî dirêj dibû.</s></p>
<p t="68660" d="4000" wp="1" ws="1"><s p="1">Neviyê Sargon, Naram-Sin, xwe wek
padîşahê çar aliyên cîhanê bi nav</s></p>
<p t="72700" d="1000" wp="1" ws="1"><s p="1">dikir.</s></p>
<p t="73980" d="3819" wp="1" ws="1"><s p="1">Lê dawiya vê împaratoriya
mezin dê ji rojhilatê bihata.</s></p>
<p t="83220" d="4339" wp="1" ws="1"><s p="1">Çavkaniyên Mezopotamyayê ji welatê li
rojhilatê Dicleyê, di navbera çemên Zaba Biçûk</s></p>
<p t="87600" d="2419" wp="1" ws="1"><s p="1">û Diyalayê de, re dibêjin Gutium.</s></p>
<p t="90060" d="4040" wp="1" ws="1"><s p="1">Ev der welatê Gutiyan bû û rêyên ku ber
bi deşta Mezopotamyayê ve diçûn di bin</s></p>
<p t="94140" d="1019" wp="1" ws="1"><s p="1">kontrola wan de bûn.</s></p>
<p t="95200" d="4159" wp="1" ws="1"><s p="1">Di serdema Şar-kali-şarrî, kurê
Naram-Sin de, şerê navbera Akad û</s></p>
<p t="99400" d="1260" wp="1" ws="1"><s p="1">Gutiyan germ bû.</s></p>
<p t="100700" d="3479" wp="1" ws="1"><s p="1">Li ser lewheyên Akadî, sal
li gorî bûyerên girîng ên wê</s></p>
<p t="104220" d="999" wp="1" ws="1"><s p="1">salê dihatin binavkirin.</s></p>
<p t="105260" d="2400" wp="1" ws="1"><s p="1">Di yek ji van navên salan de</s></p>
<p t="107700" d="3899" wp="1" ws="1"><s p="2">ev qeyd heye: "Sala ku Şar-kali-şarrî
Şarlag, padîşahê Gutiumê, dîl girt."</s></p>
<p t="111740" d="2339" wp="1" ws="1"><s p="1">Lê serkeftinên Akadê mayînde nebûn.</s></p>
<p t="114120" d="4040" wp="1" ws="1"><s p="1">Împaratorî bi serhildan,
şerê text û demeke dirêj</s></p>
<p t="118200" d="1299" wp="1" ws="1"><s p="1">a hişkesaliyê hejiya.</s></p>
<p t="119540" d="4219" wp="1" ws="1"><s p="1">Piştî mirina Şar-kali-şarrî, Akad
ket nav kaoseke wisa ku Lîsteya</s></p>
<p t="123800" d="3299" wp="1" ws="1"><s p="1">Padîşahên Sumerî vê demê
bi pirseke tinazî vedibêje.</s></p>
<p t="127140" d="2199" wp="1" ws="1"><s p="2">"Kî padîşah bû, kî ne padîşah bû?"</s></p>
<p t="129380" d="4080" wp="1" ws="1"><s p="2">Nivîsa Sumerî ya navdar "Nifira Agadeyê"
hilweşîna Akadê bi xezeba xwedayan ve girê</s></p>
<p t="133500" d="4440" wp="1" ws="1"><s p="1">dide û gelê ku ji bo pêkanîna vê
xezebê hatibû şandin jî diyar e.</s></p>
<p t="137980" d="680" wp="1" ws="1"><s p="1">Gutî.</s></p>
<p t="138700" d="3400" wp="1" ws="1"><s p="1">Nivîs wan wek gelekî ku nayê
kontrolkirin dide nasîn.</s></p>
<p t="142140" d="4520" wp="1" ws="1"><s p="1">Nêzî sala 2150 berî zayînê
Împaratoriya Akadê hilweşiya û</s></p>
<p t="146700" d="3419" wp="1" ws="1"><s p="1">bajarên text ên Mezopotamyayê
ketin destê Gutiyan.</s></p>
<p t="155540" d="2900" wp="1" ws="1"><s p="1">Di Lîsteya Padîşahên Sumerî
de qeydeke eşkere heye.</s></p>
<p t="158480" d="2320" wp="1" ws="1"><s p="2">"Padîşahî derbasî artêşa Gutiumê bû."</s></p>
<p t="161300" d="3340" wp="1" ws="1"><s p="1">Lîste serdema yekem a Gutiyan
bi hevokeke balkêş vedibêje.</s></p>
<p t="164680" d="3300" wp="1" ws="1"><s p="2">"Di artêşa Gutiumê de di destpêkê
de padîşahekî naskirî tune</s></p>
<p t="168020" d="1840" wp="1" ws="1"><s p="1">bû, ew bi xwe padîşahên xwe bûn."</s></p>
<p t="170080" d="4180" wp="1" ws="1"><s p="1">Gelek lêkolîner vê hevokê wek nîşana
wê yekê şîrove dikin ku Gutî ne</s></p>
<p t="174300" d="3800" wp="1" ws="1"><s p="1">ji aliyê serdestekî mutleq ve, lê ji
aliyê meclîseke hevpar an serokên eşîran</s></p>
<p t="178140" d="1000" wp="1" ws="1"><s p="1">ve dihatin birêvebirin.</s></p>
<p t="179180" d="4320" wp="1" ws="1"><s p="1">Li gorî lîsteyê, bîst û yek padîşahên
Gutî nêzî sed salan hukim kirin.</s></p>
<p t="183540" d="2939" wp="1" ws="1"><s p="1">Piraniya padîşahên wan tenê
çend salan li ser text man.</s></p>
<p t="186520" d="2520" wp="1" ws="1"><s p="1">Ev jî nîşan dide ku serokatî ji bav</s></p>
<p t="189080" d="2780" wp="1" ws="1"><s p="1">derbasî kur nedibû, di navbera
eşîran de dest diguherand.</s></p>
<p t="192040" d="3680" wp="1" ws="1"><s p="1">Gutiyan bajarên Sumerî bi rêya
waliyên herêmî bi rê ve birin.</s></p>
<p t="195760" d="4540" wp="1" ws="1"><s p="1">Waliyê bajarê Ummayê, Lugal-annatum,
nivîsa xwe wiha dîrok kiriye: "Di</s></p>
<p t="200340" d="1879" wp="1" ws="1"><s p="1">dema Si'um, padîşahê Gutiumê de."</s></p>
<p t="202260" d="4140" wp="1" ws="1"><s p="1">Ango bajaran rêveberiya xwe parastin,
lê serweriya padîşahê Gutî nas</s></p>
<p t="206440" d="539" wp="1" ws="1"><s p="1">kirin.</s></p>
<p t="207020" d="3460" wp="1" ws="1"><s p="1">Gutiyan zimanê rêveberiyê û
kevneşopiyên Akadê jî wergirtin.</s></p>
<p t="210520" d="4520" wp="1" ws="1"><s p="1">Li ser serê gurzekî ku aîdî Padîşah La'erabum
e, bi Akadî hatiye nivîsandin: "Padîşahê</s></p>
<p t="215080" d="1140" wp="1" ws="1"><s p="1">bihêz ê Gutiumê."</s></p>
<p t="216260" d="3080" wp="1" ws="1"><s p="1">Balkêştirîn padîşahê wan Erridupizir e.</s></p>
<p t="219380" d="4019" wp="1" ws="1"><s p="1">Di nivîsên xwe yên li Nippurê,
bajarê herî pîroz ê Mezopotamyayê de,</s></p>
<p t="223440" d="660" wp="1" ws="1"><s p="1">xwe wiha</s></p>
<p t="224140" d="3220" wp="1" ws="1"><s p="2">dide nasîn: "Padîşahê Gutiumê,
padîşahê çar aliyên cîhanê."</s></p>
<p t="227400" d="3619" wp="1" ws="1"><s p="1">Ev tam ew sernav e ku
împaratorên Akadê bi kar dianîn.</s></p>
<p t="231060" d="3600" wp="1" ws="1"><s p="1">Nivîsên wî behsa seferên wî
yên li dijî herêmên serhildêr</s></p>
<p t="234700" d="3740" wp="1" ws="1"><s p="1">dikin û çawa wî xenîmet diyarî
perestgeha Xweda Enlil kirine.</s></p>
<p t="238500" d="3280" wp="1" ws="1"><s p="1">Di serdema Gutiyan de bajarên
Sumerî jî demeke geş jiyan.</s></p>
<p t="241820" d="4379" wp="1" ws="1"><s p="1">Lagaşê di bin rêveberiya Mîr Gudea de
perestgeh ava kirin û di hunerê de serdema xwe</s></p>
<p t="246240" d="880" wp="1" ws="1"><s p="1">ya zêrîn jiya.</s></p>
<p t="247160" d="3299" wp="1" ws="1"><s p="1">Ango Gutî ne talankerên ku
talan dikirin û vedikişiyan bûn.</s></p>
<p t="250500" d="3680" wp="1" ws="1"><s p="1">Ew serdestên ku mîrateya împaratoriyê
ya Mezopotamyayê wergirtibûn bûn.</s></p>
<p t="254220" d="4400" wp="1" ws="1"><s p="1">Serokên ku ji aliyê meclîsê ve
dihatin hilbijartin, konfederasyona
eşîran û xweseriya herêmî...</s></p>
<p t="258820" d="4099" wp="1" ws="1"><s p="1">Ev tablo tam ew tablo ye ku
piştî bi hezaran salan em ê di</s></p>
<p t="262960" d="1839" wp="1" ws="1"><s p="1">avahiya civakî ya Kurdan de bibînin.</s></p>
<p t="270220" d="2879" wp="1" ws="1"><s p="1">Nêzî sed sal şûnde,
Utu-hengal, padîşahê Urukê,</s></p>
<p t="273140" d="2499" wp="1" ws="1"><s p="1">li dijî Gutiyan serhildaneke
mezin da destpêkirin.</s></p>
<p t="275680" d="2379" wp="1" ws="1"><s p="1">Di nivîsa xwe ya serkeftinê de wiha</s></p>
<p t="278100" d="3379" wp="1" ws="1"><s p="2">behsa Gutiyan dike:
"Gutium, marê diran jehrî</s></p>
<p t="281520" d="1639" wp="1" ws="1"><s p="1">yê çiyayan, ejdehayê çiyayan."</s></p>
<p t="283380" d="2980" wp="1" ws="1"><s p="1">Wê demê padîşahê dawî yê
Gutiyan, Tirigan, li ser text bû.</s></p>
<p t="286400" d="4060" wp="1" ws="1"><s p="1">Li gorî Lîsteya Padîşahên Sumerî,
Tirigan tenê çil rojan hukim kir.</s></p>
<p t="290580" d="2279" wp="1" ws="1"><s p="1">Utu-hengal bi artêşa xwe
ber bi bakur ve meşiya.</s></p>
<p t="292900" d="3279" wp="1" ws="1"><s p="1">Wî her du fermandarên ku Tirigan
şandibûn têk birin û dîl girtin.</s></p>
<p t="296220" d="4119" wp="1" ws="1"><s p="1">Di dawiya şer de Tirigan artêşa xwe
hişt û reviya bajarekî bi navê Dubrum.</s></p>
<p t="300380" d="3840" wp="1" ws="1"><s p="1">Lê xelkê Dubrumê ew girt
û radestî Utu-hengal kir.</s></p>
<p t="304280" d="4659" wp="1" ws="1"><s p="1">Piştî demeke kurt, Ur-Nammu li bajarê
Urê xanedaneke nû ava kir, lê têkoşîn</s></p>
<p t="308980" d="620" wp="1" ws="1"><s p="1">neqediya.</s></p>
<p t="309640" d="3939" wp="1" ws="1"><s p="1">Li gorî hin nivîsên Sumerî yên
dereng, heta Ur-Nammu jî di şerekî li</s></p>
<p t="313620" d="2199" wp="1" ws="1"><s p="1">dijî Gutiyan de jiyana xwe ji dest da.</s></p>
<p t="315860" d="3579" wp="1" ws="1"><s p="1">Desthilatdariya siyasî ya Gutiyan
li Mezopotamyayê bi dawî bûbû.</s></p>
<p t="319480" d="1560" wp="1" ws="1"><s p="1">Lê Gutî winda nebûn.</s></p>
<p t="326460" d="4119" wp="1" ws="1"><s p="1">Di hezar û pênc sed salên piştre
de navê Gutiumê qet ji çavkaniyên</s></p>
<p t="330620" d="1120" wp="1" ws="1"><s p="1">Mezopotamyayê kêm nebû.</s></p>
<p t="331780" d="3698" wp="1" ws="1"><s p="1">Padîşahê Babîlê, Hammurabî, serkeftinên
xwe yên li dijî artêşa Gutiumê qeyd</s></p>
<p t="335519" d="761" wp="1" ws="1"><s p="1">kirin.</s></p>
<p t="336320" d="3139" wp="1" ws="1"><s p="1">Padîşahên Asûrî seferên li
ser welatê Qutu li dar xistin.</s></p>
<p t="339500" d="4479" wp="1" ws="1"><s p="1">Dema ku padîşahê Farisan Kûroşê Mezin
di sala 539 berî zayînê de Babîl</s></p>
<p t="344020" d="3739" wp="1" ws="1"><s p="1">girt, di Silindira Kûroş de Gutium jî
di nav welatên di bin serweriya xwe de</s></p>
<p t="347800" d="680" wp="1" ws="1"><s p="1">hejmar kir.</s></p>
<p t="348520" d="3679" wp="1" ws="1"><s p="1">Fermandarê yekem ê ku ket Babîlê
jî Ugbaru, waliyê Gutiumê bû.</s></p>
<p t="352240" d="4000" wp="1" ws="1"><s p="1">Ango navê Gutiumê hezar û heft
sed salan berdewam kir ku gelê</s></p>
<p t="356280" d="1860" wp="1" ws="1"><s p="1">rojhilatê Mezopotamyayê bi nav bike.</s></p>
<p t="363560" d="3179" wp="1" ws="1"><s p="1">Gutî ne tenê gelê kevnar bûn
ku li ser van axan dijiyan.</s></p>
<p t="366780" d="4480" wp="1" ws="1"><s p="1">Lullubî, Hurrî, Kassît û Med jî li bakur û</s></p>
<p t="371300" d="1199" wp="1" ws="1"><s p="1">rojhilatê Mezopotamyayê jiyan.</s></p>
<p t="372540" d="3999" wp="1" ws="1"><s p="1">Li gorî gelek dîroknasan, ev gel
bi Gutiyan re qatên ku Kurd pêk</s></p>
<p t="376580" d="959" wp="1" ws="1"><s p="1">anîne ne.</s></p>
<p t="377580" d="3759" wp="1" ws="1"><s p="1">Di serê kesên ku ev girêdan herî bi
hêz anîne ziman de dîroknasên biyanî</s></p>
<p t="381380" d="500" wp="1" ws="1"><s p="1">tên.</s></p>
<p t="381920" d="3139" wp="1" ws="1"><s p="1">Rojhilatnas Arşak Safrastian ê ku
li Îngilîstanê dixebitî, di pirtûka</s></p>
<p t="385100" d="4839" wp="1" ws="1"><s p="1">xwe ya sala 1948an de Gutiyan rasterast
wek bav û kalên Kurdan dibîne û</s></p>
<p t="389980" d="3819" wp="1" ws="1"><s p="1">di navbera navê Gutî û koka
navê Kurd de girêdan datîne.</s></p>
<p t="393840" d="2439" wp="1" ws="1"><s p="1">Zincîra navan bi rastî balkêş e.</s></p>
<p t="396320" d="4240" wp="1" ws="1"><s p="1">Di qeydên Asûrî de ji bo gelên vê
herêmê navên wek Qurtî û Kurtî derbas</s></p>
<p t="400600" d="539" wp="1" ws="1"><s p="1">dibin.</s></p>
<p t="401180" d="3819" wp="1" ws="1"><s p="1">Fermandarê Yewnanî Ksenofon
behsa Kardûxên şervan dike ku li</s></p>
<p t="405040" d="1439" wp="1" ws="1"><s p="1">bakurê Dicleyê dijiyan.</s></p>
<p t="406520" d="3320" wp="1" ws="1"><s p="1">Di serdema Romayê de heman herêm
bi navê Korduene dihat naskirin.</s></p>
<p t="410420" d="1839" wp="1" ws="1"><s p="1">G. R. Driver ji Zanîngeha</s></p>
<p t="412300" d="3740" wp="1" ws="1"><s p="1">Oxfordê têkiliya navê Kurd bi
van navên kevnar re lêkolîn kir.</s></p>
<p t="416120" d="4199" wp="1" ws="1"><s p="1">Vladimir Minorsky rola Medan di
avabûna Kurdan de da ber çavan.</s></p>
<p t="420420" d="4219" wp="1" ws="1"><s p="1">Ephraim Speiser Gutî wek gelê xwecihî
yê rojhilatê Mezopotamyayê pênase</s></p>
<p t="424680" d="839" wp="1" ws="1"><s p="1">kirin.</s></p>
<p t="425560" d="3979" wp="1" ws="1"><s p="1">Mehrdad Izady jî dibêje ku
Gutî û gelên din ên kevnar</s></p>
<p t="429580" d="1720" wp="1" ws="1"><s p="1">bingeha gelê Kurd pêk tînin.</s></p>
<p t="431340" d="3379" wp="1" ws="1"><s p="1">Dîroknasê Kurd Mihemed Emîn Zekî
Beg jî heman nêrînê diparêze.</s></p>
<p t="435120" d="2019" wp="1" ws="1"><s p="1">Bê guman nêrînên dijber jî hene.</s></p>
<p t="437180" d="4199" wp="1" ws="1"><s p="1">Sedema sereke ew e ku ji zimanê Gutiyan
pir hindik belge gihîştine roja me.</s></p>
<p t="441420" d="2560" wp="1" ws="1"><s p="1">Di destê me de tenê çend
navên padîşahan hene.</s></p>
<p t="444120" d="4699" wp="1" ws="1"><s p="1">Lê erdnîgarî, avahiya civakî û
berdewamiya navan a bi hezaran salan vê</s></p>
<p t="448860" d="1439" wp="1" ws="1"><s p="1">tezê bi hêz dike.</s></p>
<p t="451520" d="3439" wp="1" ws="1"><s p="1">Deştên Mezopotamyayê dewlemend
bûn, lê bêparastin bûn.</s></p>
<p t="455000" d="2800" wp="1" ws="1"><s p="1">Împaratorî hatin, bajar hatin şewitandin.</s></p>
<p t="457859" d="4139" wp="1" ws="1"><s p="1">Di sedsala sêzdehan de Mongolan
Bexda û tevahiya Mezopotamyayê wêran</s></p>
<p t="462039" d="500" wp="1" ws="1"><s p="1">kirin.</s></p>
<p t="462580" d="4139" wp="1" ws="1"><s p="1">Lê bi saya avantaja stratejîk
a çiyayan, Kurd ji vê wêranbûnê</s></p>
<p t="466760" d="2060" wp="1" ws="1"><s p="1">bi qasî gelên deştê bandor nebûn.</s></p>
<p t="468900" d="1960" wp="1" ws="1"><s p="1">Gotineke kevnar a Kurdan heye:</s></p>
<p t="471159" d="3644" wp="1" ws="1"><s p="2">Ji çiyan pê ve, hevalên me tune.</s></p>
<p t="475003" d="1960" wp="1" ws="1"><s p="1">Ji çiyayan pê ve dostên me tune ne.</s></p>
<p t="477203" d="4200" wp="1" ws="1"><s p="1">Gutî ew gel bûn ku yekem împaratoriya
Mezopotamyayê hilweşandin û</s></p>
<p t="481443" d="1079" wp="1" ws="1"><s p="1">mîrateya wê wergirtin.</s></p>
<p t="482563" d="4120" wp="1" ws="1"><s p="1">Yek ji rûpelên pêşîn ên dîroka Kurdan
li ser van axan hat nivîsandin.</s></p>
<p t="486984" d="3779" wp="1" ws="1"><s p="1">Heke we ev vîdyo eciband, ji bîr
nekin ku abone bibin û ramanên xwe</s></p>
<p t="490804" d="1379" wp="1" ws="1"><s p="1">di şîroveyan de parve bikin.</s></p>
</body>
</timedtext>
