<?xml version="1.0" encoding="utf-8"?>
<timedtext format="3">
<head>
<pen id="1" b="1" fc="#FFFFFF" fo="254" bc="#140804" bo="170" et="4" ec="#000000" fs="4" sz="110"/>
<pen id="2" b="1" i="1" fc="#FFD65A" fo="254" bc="#140804" bo="190" et="4" ec="#000000" fs="4" sz="115"/>
<wp id="1" ap="7" ah="50" av="92"/>
<ws id="1" ju="2"/>
</head>
<body>
<p t="1140" d="3919" wp="1" ws="1"><s p="1">چوار هەزار و دوو سەد ساڵ لەمەوبەر،
گەلێک لە ڕۆژهەڵاتی میزۆپۆتامیاوە هاتە</s></p>
<p t="5100" d="1180" wp="1" ws="1"><s p="1">سەر شانۆی مێژوو:</s></p>
<p t="6480" d="939" wp="1" ws="1"><s p="1">گوتییەکان.</s></p>
<p t="7460" d="4240" wp="1" ws="1"><s p="1">ئەوان ئەکەد، یەکەم ئیمپراتۆریەتی
جیهان، چۆک پێ دادا و سەدەیەکی تەواو</s></p>
<p t="11740" d="2620" wp="1" ws="1"><s p="1">فەرمانڕەوایی میزۆپۆتامیایان
کرد، کە لانکەی شارستانییە.</s></p>
<p t="14440" d="2880" wp="1" ws="1"><s p="1">نووسەرە سۆمەرییەکان بە ترسەوە ناوێکیان لێ</s></p>
<p t="17420" d="1559" wp="1" ws="1"><s p="1">نان: ئەژدیهای چیاکان.</s></p>
<p t="19080" d="1760" wp="1" ws="1"><s p="1">کەواتە ئەم گوتییانە کێ بوون؟</s></p>
<p t="20880" d="3960" wp="1" ws="1"><s p="1">چۆن میزۆپۆتامیایان بەڕێوە برد
و بۆچی زۆرێک لە مێژوونووسان بە</s></p>
<p t="24880" d="2620" wp="1" ws="1"><s p="1">یەکێک لە کۆنترین
باوباپیرانی کوردیان دادەنێن؟</s></p>
<p t="27540" d="1540" wp="1" ws="1"><s p="1">بەخێربێن بۆ دیرۆک.</s></p>
<p t="41200" d="3720" wp="1" ws="1"><s p="1">خاکی نێوان دیجلە و فورات
شانۆی گەورەترین داهێنانەکانی</s></p>
<p t="44960" d="1579" wp="1" ws="1"><s p="1">مێژووی مرۆڤایەتی بوو.</s></p>
<p t="46580" d="4239" wp="1" ws="1"><s p="1">یەکەم شارەکان، نووسین، تایە و
یاسا نووسراوەکان لێرە لەدایک بوون.</s></p>
<p t="50860" d="4759" wp="1" ws="1"><s p="1">شارە سۆمەرییەکانی وەک ئوروک، ئور، لاگاش
و نیپور یەکەم ناوەندەکانی شارستانیی</s></p>
<p t="55660" d="1059" wp="1" ws="1"><s p="1">جیهان بوون.</s></p>
<p t="56800" d="4219" wp="1" ws="1"><s p="1">لە سەدەی بیست و سێیەمی پێش زایین،
سارگۆنی ئەکەدی ئەم شارانەی یەک لە</s></p>
<p t="61060" d="3519" wp="1" ws="1"><s p="1">دوای یەک داگیر کرد و یەکەم
ئیمپراتۆریەتی ناسراوی مێژووی دامەزراند.</s></p>
<p t="64620" d="3999" wp="1" ws="1"><s p="1">ئیمپراتۆریەتی ئەکەد لە کەنداوی بەسرەوە
تا دەریای ناوەڕاست درێژ دەبووەوە.</s></p>
<p t="68660" d="4000" wp="1" ws="1"><s p="1">نەوەی سارگۆن، نارام سین، خۆی
بە پاشای چوار گۆشەی جیهان ناو</s></p>
<p t="72700" d="1000" wp="1" ws="1"><s p="1">دەبرد.</s></p>
<p t="73980" d="3819" wp="1" ws="1"><s p="1">بەڵام کۆتایی ئەم ئیمپراتۆریەتە
گەورەیە لە ڕۆژهەڵاتەوە دەهات.</s></p>
<p t="83220" d="4339" wp="1" ws="1"><s p="1">سەرچاوەکانی میزۆپۆتامیا بەو وڵاتەی
ڕۆژهەڵاتی دیجلە، لە نێوان ڕووباری زێی</s></p>
<p t="87600" d="2419" wp="1" ws="1"><s p="1">بچووک و دیالە، دەڵێن گوتیوم.</s></p>
<p t="90060" d="4040" wp="1" ws="1"><s p="1">ئێرە نیشتمانی گوتییەکان بوو و ئەو ڕێگایانەی
بەرەو دەشتی میزۆپۆتامیا دەچوون لە ژێر</s></p>
<p t="94140" d="1019" wp="1" ws="1"><s p="1">دەستی ئەواندا بوون.</s></p>
<p t="95200" d="4159" wp="1" ws="1"><s p="1">لە سەردەمی شار کالی شاری، کوڕی
نارام سین، ململانێی نێوان ئەکەد و</s></p>
<p t="99400" d="1260" wp="1" ws="1"><s p="1">گوتییەکان گەرم بوو.</s></p>
<p t="100700" d="3479" wp="1" ws="1"><s p="1">لەسەر تەختە ئەکەدییەکان، ساڵەکان بە
پێی گرنگترین ڕووداوەکانی ئەو ساڵە</s></p>
<p t="104220" d="999" wp="1" ws="1"><s p="1">ناو دەنران.</s></p>
<p t="105260" d="2400" wp="1" ws="1"><s p="1">لە یەکێک لەم ناوانەی
ساڵدا ئەم تۆمارە هەیە:</s></p>
<p t="107700" d="3899" wp="1" ws="1"><s p="2">"ئەو ساڵەی شار کالی شاری، شارلاگی
پاشای گوتیومی بە دیل گرت."</s></p>
<p t="111740" d="2339" wp="1" ws="1"><s p="1">بەڵام سەرکەوتنەکانی ئەکەد بەردەوام نەبوون.</s></p>
<p t="114120" d="4040" wp="1" ws="1"><s p="1">ئیمپراتۆریەت بە ڕاپەڕین،
شەڕی سەر تەخت و وشکەساڵییەکی</s></p>
<p t="118200" d="1299" wp="1" ws="1"><s p="1">گەورە هەژا.</s></p>
<p t="119540" d="4219" wp="1" ws="1"><s p="1">دوای مردنی شار کالی شاری، ئەکەد
کەوتە ناو ئاژاوەیەکی وا کە لیستی</s></p>
<p t="123800" d="3299" wp="1" ws="1"><s p="1">پاشا سۆمەرییەکان ئەو سەردەمە بە
پرسیارێکی گاڵتەئامێز باس دەکات.</s></p>
<p t="127140" d="2199" wp="1" ws="1"><s p="2">"کێ پاشا بوو، کێ پاشا نەبوو؟"</s></p>
<p t="129380" d="4080" wp="1" ws="1"><s p="2">دەقە سۆمەرییە بەناوبانگەکەی "نەفرەتی
ئەگادە" ڕووخانی ئەکەد دەبەستێتەوە بە تووڕەیی</s></p>
<p t="133500" d="4440" wp="1" ws="1"><s p="1">خوداکان، و ئەو گەلەش کە بۆ
جێبەجێکردنی ئەو تووڕەییە نێردرا ڕوونە.</s></p>
<p t="137980" d="680" wp="1" ws="1"><s p="1">گوتییەکان.</s></p>
<p t="138700" d="3400" wp="1" ws="1"><s p="1">دەقەکە وەک گەلێکی
کۆنتڕۆڵنەکراو وەسفیان دەکات.</s></p>
<p t="142140" d="4520" wp="1" ws="1"><s p="1">نزیکەی ساڵی 2150ی پێش زایین
ئیمپراتۆریەتی ئەکەد ڕووخا</s></p>
<p t="146700" d="3419" wp="1" ws="1"><s p="1">و شارە پایتەختەکانی میزۆپۆتامیا
کەوتنە دەستی گوتییەکان.</s></p>
<p t="155540" d="2900" wp="1" ws="1"><s p="1">لە لیستی پاشا سۆمەرییەکاندا
تۆمارێکی ڕوون هەیە.</s></p>
<p t="158480" d="2320" wp="1" ws="1"><s p="2">"پاشایەتی گوازرایەوە بۆ سوپای گوتیوم."</s></p>
<p t="161300" d="3340" wp="1" ws="1"><s p="1">لیستەکە یەکەم قۆناغی گوتییەکان
بە ڕستەیەکی سەرنجڕاکێش باس دەکات.</s></p>
<p t="164680" d="3300" wp="1" ws="1"><s p="2">"لە سوپای گوتیومدا لە
سەرەتادا پاشایەکی ناسراو</s></p>
<p t="168020" d="1840" wp="1" ws="1"><s p="1">نەبوو، خۆیان پاشای خۆیان بوون."</s></p>
<p t="170080" d="4180" wp="1" ws="1"><s p="1">زۆرێک لە توێژەران ئەم ڕستەیە وەک
نیشانەی ئەوە لێک دەدەنەوە کە گوتییەکان</s></p>
<p t="174300" d="3800" wp="1" ws="1"><s p="1">نەک لەلایەن فەرمانڕەوایەکی ڕەهاوە، بەڵکو
لەلایەن ئەنجومەنێکی هاوبەش یان سەرۆک</s></p>
<p t="178140" d="1000" wp="1" ws="1"><s p="1">هۆزەکانەوە بەڕێوە دەبران.</s></p>
<p t="179180" d="4320" wp="1" ws="1"><s p="1">بە پێی لیستەکە، بیست و یەک پاشای گوتی
نزیکەی سەد ساڵ فەرمانڕەوایییان کرد.</s></p>
<p t="183540" d="2939" wp="1" ws="1"><s p="1">زۆربەی پاشاکانیان تەنها چەند
ساڵێک لەسەر تەخت مانەوە.</s></p>
<p t="186520" d="2520" wp="1" ws="1"><s p="1">ئەمەش ئەوە دەردەخات کە
سەرۆکایەتی لە باوکەوە بۆ</s></p>
<p t="189080" d="2780" wp="1" ws="1"><s p="1">کوڕ نەدەگوازرایەوە، بەڵکو لە
نێوان هۆزەکاندا دەستاودەستی دەکرد.</s></p>
<p t="192040" d="3680" wp="1" ws="1"><s p="1">گوتییەکان شارە سۆمەرییەکانیان لە ڕێگەی
والییە ناوچەییەکانەوە بەڕێوە برد.</s></p>
<p t="195760" d="4540" wp="1" ws="1"><s p="1">والیی شاری ئوما، لوگال ئاناتوم،
نووسراوەکەی خۆی بەم شێوەیە مێژوو کردووە:</s></p>
<p t="200340" d="1879" wp="1" ws="1"><s p="1">"لە سەردەمی سیئوم، پاشای گوتیوم."</s></p>
<p t="202260" d="4140" wp="1" ws="1"><s p="1">واتە شارەکان بەڕێوەبەرایەتیی خۆیان
پاراست، بەڵام دەسەڵاتی پاشای گوتییان</s></p>
<p t="206440" d="539" wp="1" ws="1"><s p="1">ناسی.</s></p>
<p t="207020" d="3460" wp="1" ws="1"><s p="1">گوتییەکان زمانی بەڕێوەبردن و
نەریتەکانی ئەکەدیشیان وەرگرت.</s></p>
<p t="210520" d="4520" wp="1" ws="1"><s p="1">لەسەر سەری گورزێک کە هی پاشا
لاعیرابومە، بە ئەکەدی نووسراوە: "پاشای</s></p>
<p t="215080" d="1140" wp="1" ws="1"><s p="1">بەهێزی گوتیوم."</s></p>
<p t="216260" d="3080" wp="1" ws="1"><s p="1">سەرنجڕاکێشترینی ئەم پاشایانە ئێریدوپیزیرە.</s></p>
<p t="219380" d="4019" wp="1" ws="1"><s p="1">لە نووسراوەکانیدا لە نیپور،
پیرۆزترین شاری میزۆپۆتامیا، خۆی بەم</s></p>
<p t="223440" d="660" wp="1" ws="1"><s p="1">شێوەیە دەناسێنێت:</s></p>
<p t="224140" d="3220" wp="1" ws="1"><s p="2">"پاشای گوتیوم، پاشای چوار گۆشەی جیهان."</s></p>
<p t="227400" d="3619" wp="1" ws="1"><s p="1">ئەمە هەمان ئەو نازناوەیە کە ئیمپراتۆرە
ئەکەدییەکان بەکاریان دەهێنا.</s></p>
<p t="231060" d="3600" wp="1" ws="1"><s p="1">نووسراوەکانی باسی هەڵمەتەکانی
دژی ناوچە یاخیبووەکان دەکەن و</s></p>
<p t="234700" d="3740" wp="1" ws="1"><s p="1">چۆن دەستکەوتەکانی پێشکەشی
پەرستگای خوداوەند ئێنلیل کردووە.</s></p>
<p t="238500" d="3280" wp="1" ws="1"><s p="1">لە سەردەمی گوتییەکاندا شارە
سۆمەرییەکانیش سەردەمێکی گەشیان بەسەر برد.</s></p>
<p t="241820" d="4379" wp="1" ws="1"><s p="1">لاگاش لە ژێر دەسەڵاتی میر گودێیادا
پەرستگای دروست کرد و لە هونەردا سەردەمی</s></p>
<p t="246240" d="880" wp="1" ws="1"><s p="1">زێڕینی خۆی ژیا.</s></p>
<p t="247160" d="3299" wp="1" ws="1"><s p="1">کەواتە گوتییەکان تاڵانکەرێک
نەبوون کە تاڵان بکەن و بکشێنەوە.</s></p>
<p t="250500" d="3680" wp="1" ws="1"><s p="1">ئەوان فەرمانڕەوایانێک بوون کە میراتی
ئیمپراتۆریی میزۆپۆتامیایان وەرگرت.</s></p>
<p t="254220" d="4400" wp="1" ws="1"><s p="1">سەرۆکانێک کە ئەنجومەن هەڵیان دەبژاردن،
کۆنفیدراسیۆنی هۆزەکان و خۆبەڕێوەبەریی ناوچەیی...</s></p>
<p t="258820" d="4099" wp="1" ws="1"><s p="1">ئەمە ڕێک ئەو وێنەیەیە
کە هەزاران ساڵ دواتر لە</s></p>
<p t="262960" d="1839" wp="1" ws="1"><s p="1">پێکهاتەی کۆمەڵایەتیی کورددا دەیبینینەوە.</s></p>
<p t="270220" d="2879" wp="1" ws="1"><s p="1">نزیکەی سەد ساڵ دواتر،
ئوتو هێنگاڵ، پاشای ئوروک،</s></p>
<p t="273140" d="2499" wp="1" ws="1"><s p="1">ڕاپەڕینێکی گەورەی دژی
گوتییەکان دەست پێ کرد.</s></p>
<p t="275680" d="2379" wp="1" ws="1"><s p="1">لە نووسراوەی سەرکەوتنەکەیدا
بەم شێوەیە باسی</s></p>
<p t="278100" d="3379" wp="1" ws="1"><s p="2">گوتییەکان دەکات: "گوتیوم،
ماری ددان ژەهراویی</s></p>
<p t="281520" d="1639" wp="1" ws="1"><s p="1">چیاکان، ئەژدیهای چیاکان."</s></p>
<p t="283380" d="2980" wp="1" ws="1"><s p="1">ئەو کاتە دوایین پاشای گوتی،
تیریگان، لەسەر تەخت بوو.</s></p>
<p t="286400" d="4060" wp="1" ws="1"><s p="1">بە پێی لیستی پاشا سۆمەرییەکان،
تیریگان تەنها چل ڕۆژ فەرمانڕەوایی کرد.</s></p>
<p t="290580" d="2279" wp="1" ws="1"><s p="1">ئوتو هێنگاڵ لەگەڵ سوپاکەیدا
بەرەو باکوور ڕۆیشت.</s></p>
<p t="292900" d="3279" wp="1" ws="1"><s p="1">ئەو دوو فەرماندەیەی تیریگان
ناردبوونی شکاند و بە دیلی گرتن.</s></p>
<p t="296220" d="4119" wp="1" ws="1"><s p="1">لە کۆتایی شەڕەکەدا تیریگان سوپاکەی بەجێ
هێشت و هەڵات بۆ شارێک بە ناوی دوبروم.</s></p>
<p t="300380" d="3840" wp="1" ws="1"><s p="1">بەڵام خەڵکی دوبروم گرتیان و
ڕادەستی ئوتو هێنگاڵیان کرد.</s></p>
<p t="304280" d="4659" wp="1" ws="1"><s p="1">ماوەیەکی کورت دواتر، ئور نەممو
لە شاری ئور بنەماڵەیەکی نوێی
دامەزراند، بەڵام ململانێ کۆتایی</s></p>
<p t="308980" d="620" wp="1" ws="1"><s p="1">نەهات.</s></p>
<p t="309640" d="3939" wp="1" ws="1"><s p="1">بە پێی هەندێک دەقی سۆمەریی
دواتر، تەنانەت ئور نەممووش لە</s></p>
<p t="313620" d="2199" wp="1" ws="1"><s p="1">شەڕێکدا دژی گوتییەکان گیانی لەدەست دا.</s></p>
<p t="315860" d="3579" wp="1" ws="1"><s p="1">دەسەڵاتی سیاسیی گوتییەکان لە
میزۆپۆتامیا کۆتایی هاتبوو.</s></p>
<p t="319480" d="1560" wp="1" ws="1"><s p="1">بەڵام گوتییەکان لەناو نەچوون.</s></p>
<p t="326460" d="4119" wp="1" ws="1"><s p="1">لە هەزار و پێنج سەد ساڵی دواتردا،
ناوی گوتیوم هەرگیز لە سەرچاوەکانی</s></p>
<p t="330620" d="1120" wp="1" ws="1"><s p="1">میزۆپۆتامیا ون نەبوو.</s></p>
<p t="331780" d="3698" wp="1" ws="1"><s p="1">پاشای بابل، حەمورابی، سەرکەوتنەکانی
دژی سوپای گوتیومی تۆمار</s></p>
<p t="335519" d="761" wp="1" ws="1"><s p="1">کرد.</s></p>
<p t="336320" d="3139" wp="1" ws="1"><s p="1">پاشاکانی ئاشوور هەڵمەتیان
بۆ سەر وڵاتی قوتو ئەنجام دا.</s></p>
<p t="339500" d="4479" wp="1" ws="1"><s p="1">کاتێک پاشای فارس، کورشی گەورە،
لە ساڵی 539ی پێش زایین بابلی</s></p>
<p t="344020" d="3739" wp="1" ws="1"><s p="1">گرت، لە سیلیندەری کورشدا گوتیومیشی لە
ڕیزی ئەو وڵاتانەدا ژمارد کە کەوتبوونە</s></p>
<p t="347800" d="680" wp="1" ws="1"><s p="1">ژێر دەسەڵاتییەوە.</s></p>
<p t="348520" d="3679" wp="1" ws="1"><s p="1">یەکەم فەرماندەش کە چووە ناو
بابلەوە، ئوگبارو، والیی گوتیوم بوو.</s></p>
<p t="352240" d="4000" wp="1" ws="1"><s p="1">واتە ناوی گوتیوم هەزار و
حەوت سەد ساڵ بەردەوام بوو لە</s></p>
<p t="356280" d="1860" wp="1" ws="1"><s p="1">ناساندنی گەلی ڕۆژهەڵاتی میزۆپۆتامیا.</s></p>
<p t="363560" d="3179" wp="1" ws="1"><s p="1">گوتییەکان تاکە گەلی کۆن
نەبوون کە لەم خاکەدا دەژیان.</s></p>
<p t="366780" d="4480" wp="1" ws="1"><s p="1">لولۆبییەکان، هۆرییەکان، کاسییەکان
و مادەکانیش لە باکوور و ڕۆژهەڵاتی</s></p>
<p t="371300" d="1199" wp="1" ws="1"><s p="1">میزۆپۆتامیا ژیان.</s></p>
<p t="372540" d="3999" wp="1" ws="1"><s p="1">بە بۆچوونی زۆرێک لە مێژوونووسان، ئەم
گەلانە لەگەڵ گوتییەکاندا ئەو چینانەن کە</s></p>
<p t="376580" d="959" wp="1" ws="1"><s p="1">کوردیان پێکهێناوە.</s></p>
<p t="377580" d="3759" wp="1" ws="1"><s p="1">لە پێشەوەی ئەوانەی ئەم پەیوەندییەیان بە
بەهێزترین شێوە دەربڕیوە، مێژوونووسانی</s></p>
<p t="381380" d="500" wp="1" ws="1"><s p="1">بیانین.</s></p>
<p t="381920" d="3139" wp="1" ws="1"><s p="1">ڕۆژهەڵاتناس ئەرشاک سافراستیان،
کە لە ئینگلتەرا کاری دەکرد، لە</s></p>
<p t="385100" d="4839" wp="1" ws="1"><s p="1">کتێبەکەیدا کە ساڵی 1948 بڵاو کرایەوە، گوتییەکان
ڕاستەوخۆ بە باوباپیرانی کورد دادەنێت و</s></p>
<p t="389980" d="3819" wp="1" ws="1"><s p="1">پەیوەندی لە نێوان ناوی گوتی
و ڕەگی ناوی کورددا دادەنێت.</s></p>
<p t="393840" d="2439" wp="1" ws="1"><s p="1">زنجیرەی ناوەکان بەڕاستی سەرنجڕاکێشە.</s></p>
<p t="396320" d="4240" wp="1" ws="1"><s p="1">لە تۆمارە ئاشوورییەکاندا بۆ گەلانی
ئەم ناوچەیە ناوی وەک قورتی و کورتی</s></p>
<p t="400600" d="539" wp="1" ws="1"><s p="1">هاتووە.</s></p>
<p t="401180" d="3819" wp="1" ws="1"><s p="1">فەرماندەی یۆنانی گزێنەفۆن باسی
کاردۆخە جەنگاوەرەکان دەکات کە لە</s></p>
<p t="405040" d="1439" wp="1" ws="1"><s p="1">باکووری دیجلە دەژیان.</s></p>
<p t="406520" d="3320" wp="1" ws="1"><s p="1">لە سەردەمی ڕۆمادا هەمان ناوچە
بە ناوی کۆردوێنێ دەناسرا.</s></p>
<p t="410420" d="1839" wp="1" ws="1"><s p="1">جی. ئاڕ. درایڤەر لە</s></p>
<p t="412300" d="3740" wp="1" ws="1"><s p="1">زانکۆی ئۆکسفۆرد پەیوەندیی ناوی
کوردی بەم ناوە کۆنانەوە لێکۆڵییەوە.</s></p>
<p t="416120" d="4199" wp="1" ws="1"><s p="1">ڤلادیمیر مینۆرسکی ڕۆڵی مادەکانی
لە پێکهاتنی کورددا جەخت کردەوە.</s></p>
<p t="420420" d="4219" wp="1" ws="1"><s p="1">ئێفرایم سپایزەر گوتییەکانی وەک
گەلی ڕەسەنی ڕۆژهەڵاتی میزۆپۆتامیا</s></p>
<p t="424680" d="839" wp="1" ws="1"><s p="1">ناساند.</s></p>
<p t="425560" d="3979" wp="1" ws="1"><s p="1">مێهرداد ئیزەدیش پێی وایە گوتییەکان
و گەلە کۆنەکانی تر بناغەی</s></p>
<p t="429580" d="1720" wp="1" ws="1"><s p="1">گەلی کورد پێک دەهێنن.</s></p>
<p t="431340" d="3379" wp="1" ws="1"><s p="1">مێژوونووسی کورد محەمەد ئەمین
زەکی بەگیش هەمان بۆچوونی هەیە.</s></p>
<p t="435120" d="2019" wp="1" ws="1"><s p="1">بێگومان بۆچوونی پێچەوانەش هەن.</s></p>
<p t="437180" d="4199" wp="1" ws="1"><s p="1">هۆکاری سەرەکی ئەوەیە کە بەڵگەیەکی
زۆر کەم بە زمانی گوتییەکان ماوەتەوە.</s></p>
<p t="441420" d="2560" wp="1" ws="1"><s p="1">ئەوەی لەبەردەستماندایە
تەنها چەند ناوێکی پاشایە.</s></p>
<p t="444120" d="4699" wp="1" ws="1"><s p="1">بەڵام جوگرافیا، پێکهاتەی کۆمەڵایەتی و
بەردەوامیی ناوەکان بە درێژایی هەزاران ساڵ</s></p>
<p t="448860" d="1439" wp="1" ws="1"><s p="1">ئەم تێزە بەهێز دەکەن.</s></p>
<p t="451520" d="3439" wp="1" ws="1"><s p="1">دەشتەکانی میزۆپۆتامیا دەوڵەمەند
بوون، بەڵام بێ بەرگری بوون.</s></p>
<p t="455000" d="2800" wp="1" ws="1"><s p="1">ئیمپراتۆریەتەکان هاتن، شارەکان سووتێنران.</s></p>
<p t="457859" d="4139" wp="1" ws="1"><s p="1">لە سەدەی سیانزەهەمدا مەغۆلەکان
بەغدا و هەموو میزۆپۆتامیایان وێران</s></p>
<p t="462039" d="500" wp="1" ws="1"><s p="1">کرد.</s></p>
<p t="462580" d="4139" wp="1" ws="1"><s p="1">بەڵام بەهۆی ئەو سوودە ستراتیژییەی چیاکان
پێیان دەبەخشی، کورد بە ئەندازەی گەلانی</s></p>
<p t="466760" d="2060" wp="1" ws="1"><s p="1">دەشت بەم وێرانکارییە زیانی پێ نەگەیشت.</s></p>
<p t="468900" d="1960" wp="1" ws="1"><s p="1">کورد پەندێکی کۆنی هەیە: Ji çiyan</s></p>
<p t="471159" d="3644" wp="1" ws="1"><s p="2">pê ve, hevalên me tune.</s></p>
<p t="475003" d="1960" wp="1" ws="1"><s p="1">جگە لە چیاکان هیچ دۆستێکمان نییە.</s></p>
<p t="477203" d="4200" wp="1" ws="1"><s p="1">گوتییەکان ئەو گەلە بوون کە یەکەم
ئیمپراتۆریەتی میزۆپۆتامیایان ڕووخاند و</s></p>
<p t="481443" d="1079" wp="1" ws="1"><s p="1">میراتەکەیان وەرگرت.</s></p>
<p t="482563" d="4120" wp="1" ws="1"><s p="1">یەکێک لە یەکەم لاپەڕەکانی مێژووی
کورد لێرە، لەم خاکەدا نووسرا.</s></p>
<p t="486984" d="3779" wp="1" ws="1"><s p="1">ئەگەر ئەم ڤیدیۆیەتان بەدڵ بوو، لەبیرتان
نەچێت سەبسکرایب بکەن و بۆچوونەکانتان</s></p>
<p t="490804" d="1379" wp="1" ws="1"><s p="1">لە کۆمێنتەکاندا بنووسن.</s></p>
</body>
</timedtext>
